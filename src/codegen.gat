// ============================================================================
// src/codegen.gat - Machine Codegen (x86-64 Fastcall)
// ============================================================================

// 8. Machine Codegen (x86-64 Windows Fastcall)
// ----------------------------------------------------------------------------

class CodeGen {
    code: ByteBuffer;
    relocs_head: Reloc;
    relocs_tail: Reloc;
    syms_head: SymOffset;
    syms_tail: SymOffset;
}

fn cg_new() -> CodeGen {
    return new CodeGen {
        code: bb_new(4096),
        relocs_head: nil,
        relocs_tail: nil,
        syms_head: nil,
        syms_tail: nil
    };
}

fn cg_define_sym(cg: CodeGen, name: string) {
    let s = new SymOffset {
        name: name,
        offset: cg.code.size,
        next: nil
    };
    if cg.syms_head == nil {
        cg.syms_head = s;
        cg.syms_tail = s;
    } else {
        cg.syms_tail.next = s;
        cg.syms_tail = s;
    }
}

fn cg_reloc(cg: CodeGen, sym: string, kind: i64) {
    let r = new Reloc {
        offset: cg.code.size,
        sym: sym,
        kind: kind,
        next: nil
    };
    if cg.relocs_head == nil {
        cg.relocs_head = r;
        cg.relocs_tail = r;
    } else {
        cg.relocs_tail.next = r;
        cg.relocs_tail = r;
    }
    bb_write_u32(cg.code, 0);
}

fn cg_call_sym(cg: CodeGen, sym: string) {
    bb_write_u8(cg.code, 0xE8); // call rel32
    cg_reloc(cg, sym, 1);
}

fn cg_call_iat(cg: CodeGen, sym: string) {
    bb_write_u8(cg.code, 0xFF); // call qword ptr [rip + __iat_sym]
    bb_write_u8(cg.code, 0x15);
    cg_reloc(cg, str_concat("__iat_", sym), 2);
}

fn cg_mov_reg_local(cg: CodeGen, reg_idx: i64, val_id: i64) {
    if val_id == 0 {
        if reg_idx == 0 { // RAX
            bb_write_u8(cg.code, 0x31); bb_write_u8(cg.code, 0xC0);
        } else if reg_idx == 1 { // RCX
            bb_write_u8(cg.code, 0x31); bb_write_u8(cg.code, 0xC9);
        } else if reg_idx == 2 { // RDX
            bb_write_u8(cg.code, 0x31); bb_write_u8(cg.code, 0xD2);
        } else if reg_idx == 3 { // R10
            bb_write_u8(cg.code, 0x45); bb_write_u8(cg.code, 0x31); bb_write_u8(cg.code, 0xD2);
        } else if reg_idx == 4 { // R8
            bb_write_u8(cg.code, 0x45); bb_write_u8(cg.code, 0x31); bb_write_u8(cg.code, 0xC0);
        } else if reg_idx == 5 { // R9
            bb_write_u8(cg.code, 0x45); bb_write_u8(cg.code, 0x31); bb_write_u8(cg.code, 0xC9);
        }
        return;
    }
    let disp = val_id * 8;
    // mov reg, [rbp - disp]
    if reg_idx == 0 { // RAX
        bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x85);
        bb_write_u32(cg.code, (0 - disp));
    } else if reg_idx == 1 { // RCX
        bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x8D);
        bb_write_u32(cg.code, (0 - disp));
    } else if reg_idx == 2 { // RDX
        bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x95);
        bb_write_u32(cg.code, (0 - disp));
    } else if reg_idx == 3 { // R10
        bb_write_u8(cg.code, 0x4C); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x95);
        bb_write_u32(cg.code, (0 - disp));
    } else if reg_idx == 4 { // R8
        bb_write_u8(cg.code, 0x4C); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x85);
        bb_write_u32(cg.code, (0 - disp));
    } else if reg_idx == 5 { // R9
        bb_write_u8(cg.code, 0x4C); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x8D);
        bb_write_u32(cg.code, (0 - disp));
    }
}

fn cg_mov_local_reg(cg: CodeGen, val_id: i64, reg_idx: i64) {
    let disp = val_id * 8;
    // mov [rbp - disp], reg
    if reg_idx == 0 { // RAX
        bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0x85);
        bb_write_u32(cg.code, (0 - disp));
    }
}

// Emit runtime helpers into code stream
fn cg_emit_runtime(cg: CodeGen) {
    // 0. Entrypoint Trampoline
    cg_define_sym(cg, "__gat_entry");
    // sub rsp, 40 -> 48 83 EC 28
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x83); bb_write_u8(cg.code, 0xEC); bb_write_u8(cg.code, 0x28);
    // call main -> E8 disp32
    bb_write_u8(cg.code, 0xE8);
    cg_reloc(cg, "main", 1);
    // mov rcx, rax -> 48 89 C1
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0xC1);
    // call [rip + __iat_ExitProcess] -> FF 15 disp32
    bb_write_u8(cg.code, 0xFF); bb_write_u8(cg.code, 0x15);
    cg_reloc(cg, "__iat_ExitProcess", 2);

    // 1. __gat_print_str(rcx: str)
    cg_define_sym(cg, "__gat_print_str");
    bb_write_u8(cg.code, 0x55);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0xE5);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x83); bb_write_u8(cg.code, 0xEC); bb_write_u8(cg.code, 0x40);
    // test rcx, rcx; jz null (+70)
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x85); bb_write_u8(cg.code, 0xC9);
    bb_write_u8(cg.code, 0x74); bb_write_u8(cg.code, 0x46);
    // save rcx at [rbp-8]
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0x4D); bb_write_u8(cg.code, 0xF8);
    // strlen
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x31); bb_write_u8(cg.code, 0xC0); // xor rax, rax
    bb_write_u8(cg.code, 0x4C); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x55); bb_write_u8(cg.code, 0xF8); // mov r10, [rbp-8]
    let str_loop = cg.code.size;
    bb_write_u8(cg.code, 0x41); bb_write_u8(cg.code, 0x80); bb_write_u8(cg.code, 0x3C); bb_write_u8(cg.code, 0x02); bb_write_u8(cg.code, 0x00); // cmp byte ptr [r10+rax], 0
    bb_write_u8(cg.code, 0x74); bb_write_u8(cg.code, 0x05); // jz +5
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xFF); bb_write_u8(cg.code, 0xC0); // inc rax
    bb_write_u8(cg.code, 0xEB); bb_write_u8(cg.code, 0xF4); // jmp str_loop (-12)
    // len in rax, save at [rbp-16]
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0x45); bb_write_u8(cg.code, 0xF0);
    // GetStdHandle(-11)
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xC7); bb_write_u8(cg.code, 0xC1); bb_write_u32(cg.code, (0 - 11));
    cg_call_iat(cg, "GetStdHandle");
    // WriteFile(hStdOut: rcx, buf: rdx, len: r8, &written: r9, lpOverlapped: [rsp+0x20]=0)
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0xC1); // rcx = rax
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x55); bb_write_u8(cg.code, 0xF8); // rdx = [rbp-8]
    bb_write_u8(cg.code, 0x4C); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x45); bb_write_u8(cg.code, 0xF0); // r8 = [rbp-16]
    bb_write_u8(cg.code, 0x4C); bb_write_u8(cg.code, 0x8D); bb_write_u8(cg.code, 0x4D); bb_write_u8(cg.code, 0xE8); // r9 = lea [rbp-24]
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xC7); bb_write_u8(cg.code, 0x44); bb_write_u8(cg.code, 0x24); bb_write_u8(cg.code, 0x20); bb_write_u32(cg.code, 0);
    cg_call_iat(cg, "WriteFile");
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0xEC); bb_write_u8(cg.code, 0x5D); bb_write_u8(cg.code, 0xC3);

    // 2. __gat_print_bool(rcx: bool)
    cg_define_sym(cg, "__gat_print_bool");
    bb_write_u8(cg.code, 0x55);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0xE5);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x83); bb_write_u8(cg.code, 0xEC); bb_write_u8(cg.code, 0x40);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x85); bb_write_u8(cg.code, 0xC9); // test rcx, rcx
    bb_write_u8(cg.code, 0x75); bb_write_u8(cg.code, 0x11); // jnz +17 (skip false branch)
    // false branch
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x8D); bb_write_u8(cg.code, 0x0D); cg_reloc(cg, "str_false_const", 1);
    cg_call_sym(cg, "__gat_print_str");
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0xEC); bb_write_u8(cg.code, 0x5D); bb_write_u8(cg.code, 0xC3);
    // true branch
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x8D); bb_write_u8(cg.code, 0x0D); cg_reloc(cg, "str_true_const", 1);
    cg_call_sym(cg, "__gat_print_str");
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0xEC); bb_write_u8(cg.code, 0x5D); bb_write_u8(cg.code, 0xC3);

    // 3. __gat_print_i64(rcx: i64)
    cg_define_sym(cg, "__gat_print_i64");
    bb_write_u8(cg.code, 0x55);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0xE5);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x83); bb_write_u8(cg.code, 0xEC); bb_write_u8(cg.code, 0x40);
    cg_call_sym(cg, "__gat_str_from_int");
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0xC1); // rcx = rax
    cg_call_sym(cg, "__gat_print_str");
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0xEC); bb_write_u8(cg.code, 0x5D); bb_write_u8(cg.code, 0xC3);

    // 4. __gat_alloc_mem(rcx: size) -> rax
    cg_define_sym(cg, "__gat_alloc_mem");
    bb_write_u8(cg.code, 0x55);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0xE5);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x83); bb_write_u8(cg.code, 0xEC); bb_write_u8(cg.code, 0x40);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0x4D); bb_write_u8(cg.code, 0xF8); // [rbp-8] = size
    cg_call_iat(cg, "GetProcessHeap");
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0xC1); // rcx = hHeap
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xC7); bb_write_u8(cg.code, 0xC2); bb_write_u32(cg.code, 8); // rdx = HEAP_ZERO_MEMORY (8)
    bb_write_u8(cg.code, 0x4C); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x45); bb_write_u8(cg.code, 0xF8); // r8 = size
    cg_call_iat(cg, "HeapAlloc");
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0xEC); bb_write_u8(cg.code, 0x5D); bb_write_u8(cg.code, 0xC3);

    // 5. __gat_free_mem(rcx: ptr)
    cg_define_sym(cg, "__gat_free_mem");
    bb_write_u8(cg.code, 0x55);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0xE5);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x83); bb_write_u8(cg.code, 0xEC); bb_write_u8(cg.code, 0x40);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x85); bb_write_u8(cg.code, 0xC9); // test rcx, rcx
    bb_write_u8(cg.code, 0x74); bb_write_u8(cg.code, 0x1A); // jz +26
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0x4D); bb_write_u8(cg.code, 0xF8); // [rbp-8] = ptr
    cg_call_iat(cg, "GetProcessHeap");
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0xC1); // rcx = hHeap
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x31); bb_write_u8(cg.code, 0xD2); // rdx = 0
    bb_write_u8(cg.code, 0x4C); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x45); bb_write_u8(cg.code, 0xF8); // r8 = ptr
    cg_call_iat(cg, "HeapFree");
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0xEC); bb_write_u8(cg.code, 0x5D); bb_write_u8(cg.code, 0xC3);

    // 6. __gat_str_len(rcx: str) -> rax
    cg_define_sym(cg, "__gat_str_len");
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x85); bb_write_u8(cg.code, 0xC9); // test rcx, rcx
    bb_write_u8(cg.code, 0x75); bb_write_u8(cg.code, 0x04); // jnz +4 (skip xor rax,rax; ret)
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x31); bb_write_u8(cg.code, 0xC0); bb_write_u8(cg.code, 0xC3); // ret 0
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x31); bb_write_u8(cg.code, 0xC0); // xor rax, rax
    let sl_loop = cg.code.size;
    bb_write_u8(cg.code, 0x80); bb_write_u8(cg.code, 0x3C); bb_write_u8(cg.code, 0x01); bb_write_u8(cg.code, 0x00); // cmp [rcx+rax], 0
    bb_write_u8(cg.code, 0x74); bb_write_u8(cg.code, 0x05);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xFF); bb_write_u8(cg.code, 0xC0);
    bb_write_u8(cg.code, 0xEB); bb_write_u8(cg.code, 0xF5); // jmp -11
    bb_write_u8(cg.code, 0xC3);

    // 7. __gat_str_char(rcx: str, rdx: idx) -> rax
    cg_define_sym(cg, "__gat_str_char");
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x0F); bb_write_u8(cg.code, 0xB6); bb_write_u8(cg.code, 0x04); bb_write_u8(cg.code, 0x11); // movzx rax, byte ptr [rcx+rdx]
    bb_write_u8(cg.code, 0xC3);

    // 8. __gat_str_eq(rcx: s1, rdx: s2) -> rax
    cg_define_sym(cg, "__gat_str_eq");
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x39); bb_write_u8(cg.code, 0xD1); // cmp rcx, rdx
    bb_write_u8(cg.code, 0x74); bb_write_u8(cg.code, 0x1F); // je eqLbl (+31)
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x85); bb_write_u8(cg.code, 0xC9); // test rcx, rcx
    bb_write_u8(cg.code, 0x74); bb_write_u8(cg.code, 0x17); // jz diffLbl (+23)
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x85); bb_write_u8(cg.code, 0xD2); // test rdx, rdx
    bb_write_u8(cg.code, 0x74); bb_write_u8(cg.code, 0x12); // jz diffLbl (+18)
    // loop
    bb_write_u8(cg.code, 0x8A); bb_write_u8(cg.code, 0x01); // mov al, [rcx]
    bb_write_u8(cg.code, 0x3A); bb_write_u8(cg.code, 0x02); // cmp al, [rdx]
    bb_write_u8(cg.code, 0x75); bb_write_u8(cg.code, 0x0C); // jne diffLbl (+12)
    bb_write_u8(cg.code, 0x84); bb_write_u8(cg.code, 0xC0); // test al, al
    bb_write_u8(cg.code, 0x74); bb_write_u8(cg.code, 0x0B); // jz eqLbl (+11)
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xFF); bb_write_u8(cg.code, 0xC1); // inc rcx
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xFF); bb_write_u8(cg.code, 0xC2); // inc rdx
    bb_write_u8(cg.code, 0xEB); bb_write_u8(cg.code, 0xEE); // jmp loop (-18)
    // diffLbl
    bb_write_u8(cg.code, 0x31); bb_write_u8(cg.code, 0xC0); bb_write_u8(cg.code, 0xC3); // xor eax, eax; ret
    // eqLbl
    bb_write_u8(cg.code, 0xB8); bb_write_u32(cg.code, 1); bb_write_u8(cg.code, 0xC3); // mov eax, 1; ret

    // 9. __gat_str_sub(rcx: s, rdx: start, r8: len) -> rax
    cg_define_sym(cg, "__gat_str_sub");
    bb_write_u8(cg.code, 0x55);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0xE5);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x83); bb_write_u8(cg.code, 0xEC); bb_write_u8(cg.code, 0x40);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0x4D); bb_write_u8(cg.code, 0xF8); // s
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0x55); bb_write_u8(cg.code, 0xF0); // start
    bb_write_u8(cg.code, 0x4C); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0x45); bb_write_u8(cg.code, 0xE8); // len
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x4D); bb_write_u8(cg.code, 0xE8); // rcx = len
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xFF); bb_write_u8(cg.code, 0xC1); // rcx = len + 1
    cg_call_sym(cg, "__gat_alloc_mem");
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0x45); bb_write_u8(cg.code, 0xE0); // dest
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x31); bb_write_u8(cg.code, 0xC9); // i = 0
    let sub_loop = cg.code.size;
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x3B); bb_write_u8(cg.code, 0x4D); bb_write_u8(cg.code, 0xE8); // cmp rcx, [rbp-24]
    bb_write_u8(cg.code, 0x7D); bb_write_u8(cg.code, 0x18); // jge done (+24)
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x55); bb_write_u8(cg.code, 0xF8); // src = [rbp-8]
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x03); bb_write_u8(cg.code, 0x55); bb_write_u8(cg.code, 0xF0); // + start
    bb_write_u8(cg.code, 0x8A); bb_write_u8(cg.code, 0x04); bb_write_u8(cg.code, 0x0A); // al = [rdx+rcx]
    bb_write_u8(cg.code, 0x4C); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x55); bb_write_u8(cg.code, 0xE0); // r10 = dst [rbp-32]
    bb_write_u8(cg.code, 0x41); bb_write_u8(cg.code, 0x88); bb_write_u8(cg.code, 0x04); bb_write_u8(cg.code, 0x0A); // [r10+rcx] = al
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xFF); bb_write_u8(cg.code, 0xC1); // inc rcx
    bb_write_u8(cg.code, 0xEB); bb_write_u8(cg.code, 0xE2); // jmp -30
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x45); bb_write_u8(cg.code, 0xE0); // rax = dest
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0xEC); bb_write_u8(cg.code, 0x5D); bb_write_u8(cg.code, 0xC3);

    // 10. __gat_str_concat(rcx: s1, rdx: s2) -> rax
    cg_define_sym(cg, "__gat_str_concat");
    bb_write_u8(cg.code, 0x55);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0xE5);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x83); bb_write_u8(cg.code, 0xEC); bb_write_u8(cg.code, 0x40);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0x4D); bb_write_u8(cg.code, 0xF8); // s1
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0x55); bb_write_u8(cg.code, 0xF0); // s2
    cg_call_sym(cg, "__gat_str_len");
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0x45); bb_write_u8(cg.code, 0xE8); // len1
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x4D); bb_write_u8(cg.code, 0xF0); // rcx = s2
    cg_call_sym(cg, "__gat_str_len");
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0x45); bb_write_u8(cg.code, 0xE0); // len2
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x4D); bb_write_u8(cg.code, 0xE8);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x03); bb_write_u8(cg.code, 0x4D); bb_write_u8(cg.code, 0xE0); // len1 + len2
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xFF); bb_write_u8(cg.code, 0xC1); // + 1
    cg_call_sym(cg, "__gat_alloc_mem");
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0x45); bb_write_u8(cg.code, 0xD8); // new_buf
    // copy s1
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x31); bb_write_u8(cg.code, 0xC9);
    let c1_loop = cg.code.size;
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x3B); bb_write_u8(cg.code, 0x4D); bb_write_u8(cg.code, 0xE8);
    bb_write_u8(cg.code, 0x7D); bb_write_u8(cg.code, 0x14); // jge +20
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x55); bb_write_u8(cg.code, 0xF8);
    bb_write_u8(cg.code, 0x8A); bb_write_u8(cg.code, 0x04); bb_write_u8(cg.code, 0x0A);
    bb_write_u8(cg.code, 0x4C); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x55); bb_write_u8(cg.code, 0xD8); // r10 = dst
    bb_write_u8(cg.code, 0x41); bb_write_u8(cg.code, 0x88); bb_write_u8(cg.code, 0x04); bb_write_u8(cg.code, 0x0A);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xFF); bb_write_u8(cg.code, 0xC1);
    bb_write_u8(cg.code, 0xEB); bb_write_u8(cg.code, 0xE6); // jmp -26
    // copy s2
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x31); bb_write_u8(cg.code, 0xC9);
    let c2_loop = cg.code.size;
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x3B); bb_write_u8(cg.code, 0x4D); bb_write_u8(cg.code, 0xE0);
    bb_write_u8(cg.code, 0x7D); bb_write_u8(cg.code, 0x18); // jge +24
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x55); bb_write_u8(cg.code, 0xF0);
    bb_write_u8(cg.code, 0x8A); bb_write_u8(cg.code, 0x04); bb_write_u8(cg.code, 0x0A);
    bb_write_u8(cg.code, 0x4C); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x55); bb_write_u8(cg.code, 0xD8); // r10 = dst
    bb_write_u8(cg.code, 0x4C); bb_write_u8(cg.code, 0x03); bb_write_u8(cg.code, 0x55); bb_write_u8(cg.code, 0xE8); // r10 += len1
    bb_write_u8(cg.code, 0x41); bb_write_u8(cg.code, 0x88); bb_write_u8(cg.code, 0x04); bb_write_u8(cg.code, 0x0A);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xFF); bb_write_u8(cg.code, 0xC1);
    bb_write_u8(cg.code, 0xEB); bb_write_u8(cg.code, 0xE2); // jmp -30
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x45); bb_write_u8(cg.code, 0xD8);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0xEC); bb_write_u8(cg.code, 0x5D); bb_write_u8(cg.code, 0xC3);

    // 11. __gat_str_from_int(rcx: n) -> rax
    cg_define_sym(cg, "__gat_str_from_int");
    bb_write_u8(cg.code, 0x55);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0xE5);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x83); bb_write_u8(cg.code, 0xEC); bb_write_u8(cg.code, 0x40);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0x4D); bb_write_u8(cg.code, 0xF8); // [rbp-8] = n
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xC7); bb_write_u8(cg.code, 0xC1); bb_write_u32(cg.code, 32);
    cg_call_sym(cg, "__gat_alloc_mem");
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0x45); bb_write_u8(cg.code, 0xF0); // [rbp-16] = buf
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x45); bb_write_u8(cg.code, 0xF8); // rax = n
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x85); bb_write_u8(cg.code, 0xC0);
    bb_write_u8(cg.code, 0x75); bb_write_u8(cg.code, 0x10); // jnz +16 (skip n == 0 branch)
    // n == 0
    bb_write_u8(cg.code, 0x4C); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x55); bb_write_u8(cg.code, 0xF0); // r10 = buf
    bb_write_u8(cg.code, 0x41); bb_write_u8(cg.code, 0xC6); bb_write_u8(cg.code, 0x02); bb_write_u8(cg.code, 0x30); // [r10] = '0'
    bb_write_u8(cg.code, 0x4C); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0xD0); // rax = r10
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0xEC); bb_write_u8(cg.code, 0x5D); bb_write_u8(cg.code, 0xC3);
    // n != 0
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xC7); bb_write_u8(cg.code, 0x45); bb_write_u8(cg.code, 0xE8); bb_write_u32(cg.code, 0); // is_neg = 0
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x85); bb_write_u8(cg.code, 0xC0);
    bb_write_u8(cg.code, 0x79); bb_write_u8(cg.code, 0x0F); // jge
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xC7); bb_write_u8(cg.code, 0x45); bb_write_u8(cg.code, 0xE8); bb_write_u32(cg.code, 1); // is_neg = 1
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xF7); bb_write_u8(cg.code, 0xD8); // neg rax
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0x45); bb_write_u8(cg.code, 0xF8); // save n
    // format digits backwards
    bb_write_u8(cg.code, 0x4C); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x55); bb_write_u8(cg.code, 0xF0); // r10 = buf
    bb_write_u8(cg.code, 0x49); bb_write_u8(cg.code, 0x83); bb_write_u8(cg.code, 0xC2); bb_write_u8(cg.code, 0x1E); // r10 = buf + 30
    bb_write_u8(cg.code, 0x41); bb_write_u8(cg.code, 0xC6); bb_write_u8(cg.code, 0x02); bb_write_u8(cg.code, 0x00); // [r10] = 0
    bb_write_u8(cg.code, 0x49); bb_write_u8(cg.code, 0xFF); bb_write_u8(cg.code, 0xCA); // dec r10
    let sfi_loop = cg.code.size;
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x31); bb_write_u8(cg.code, 0xD2);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xB9); bb_write_u64(cg.code, 10);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xF7); bb_write_u8(cg.code, 0xF1); // div rcx -> rem in rdx, quot in rax
    bb_write_u8(cg.code, 0x80); bb_write_u8(cg.code, 0xC2); bb_write_u8(cg.code, 0x30); // dl += '0'
    bb_write_u8(cg.code, 0x41); bb_write_u8(cg.code, 0x88); bb_write_u8(cg.code, 0x12); // [r10] = dl
    bb_write_u8(cg.code, 0x49); bb_write_u8(cg.code, 0xFF); bb_write_u8(cg.code, 0xCA); // dec r10
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x85); bb_write_u8(cg.code, 0xC0);
    bb_write_u8(cg.code, 0x75); bb_write_u8(cg.code, 0xE2); // jnz -30
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x83); bb_write_u8(cg.code, 0x7D); bb_write_u8(cg.code, 0xE8); bb_write_u8(cg.code, 0x00);
    bb_write_u8(cg.code, 0x74); bb_write_u8(cg.code, 0x07);
    bb_write_u8(cg.code, 0x41); bb_write_u8(cg.code, 0xC6); bb_write_u8(cg.code, 0x02); bb_write_u8(cg.code, 0x2D); // [r10] = '-'
    bb_write_u8(cg.code, 0x49); bb_write_u8(cg.code, 0xFF); bb_write_u8(cg.code, 0xCA);
    bb_write_u8(cg.code, 0x49); bb_write_u8(cg.code, 0x8D); bb_write_u8(cg.code, 0x42); bb_write_u8(cg.code, 0x01); // rax = r10 + 1
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0xEC); bb_write_u8(cg.code, 0x5D); bb_write_u8(cg.code, 0xC3);

    // 12. __gat_get_cmd_arg(rcx: idx) -> rax
    cg_define_sym(cg, "__gat_get_cmd_arg");
    bb_write_u8(cg.code, 0x55);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0xE5);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x83); bb_write_u8(cg.code, 0xEC); bb_write_u8(cg.code, 0x40);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0x4D); bb_write_u8(cg.code, 0xF8); // [rbp-8] = target_idx
    cg_call_iat(cg, "GetCommandLineA");
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0x45); bb_write_u8(cg.code, 0xF0); // [rbp-16] = cmdline
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0xC1); // rcx = cmdline
    cg_call_sym(cg, "__gat_str_len");
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0x45); bb_write_u8(cg.code, 0xE8); // [rbp-24] = cmd_len

    // [rbp-32] = i (0), [rbp-40] = cur_arg (0)
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xC7); bb_write_u8(cg.code, 0x45); bb_write_u8(cg.code, 0xE0); bb_write_u32(cg.code, 0);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xC7); bb_write_u8(cg.code, 0x45); bb_write_u8(cg.code, 0xD8); bb_write_u32(cg.code, 0);

    let arg_loop = cg.code.size;
    // skip whitespace
    let ws_loop = cg.code.size;
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x4D); bb_write_u8(cg.code, 0xE0); // rcx = i
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x3B); bb_write_u8(cg.code, 0x4D); bb_write_u8(cg.code, 0xE8); // cmp i, cmd_len
    let jge_not_found_pos = cg.code.size;
    bb_write_u8(cg.code, 0x0F); bb_write_u8(cg.code, 0x8D); // jge disp32
    bb_write_u32(cg.code, 0); // placeholder
    bb_write_u8(cg.code, 0x4C); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x55); bb_write_u8(cg.code, 0xF0); // r10 = cmdline
    bb_write_u8(cg.code, 0x41); bb_write_u8(cg.code, 0x8A); bb_write_u8(cg.code, 0x04); bb_write_u8(cg.code, 0x0A); // al = cmdline[i]
    bb_write_u8(cg.code, 0x3C); bb_write_u8(cg.code, 0x20); // ' '
    bb_write_u8(cg.code, 0x74); bb_write_u8(cg.code, 0x04);
    bb_write_u8(cg.code, 0x3C); bb_write_u8(cg.code, 0x09); // '\t'
    bb_write_u8(cg.code, 0x75); bb_write_u8(cg.code, 0x07); // not ws -> break
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xFF); bb_write_u8(cg.code, 0x45); bb_write_u8(cg.code, 0xE0); // inc i
    let back_ws = cg.code.size + 2 - ws_loop;
    let b_ws = 256 - back_ws;
    bb_write_u8(cg.code, 0xEB); bb_write_u8(cg.code, b_ws);

    // [rbp-48] = start_idx = i
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x45); bb_write_u8(cg.code, 0xE0);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0x45); bb_write_u8(cg.code, 0xD0);

    // check if quoted: cmdline[i] == '"'
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x4D); bb_write_u8(cg.code, 0xE0);
    bb_write_u8(cg.code, 0x4C); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x55); bb_write_u8(cg.code, 0xF0);
    bb_write_u8(cg.code, 0x41); bb_write_u8(cg.code, 0x8A); bb_write_u8(cg.code, 0x04); bb_write_u8(cg.code, 0x0A);
    bb_write_u8(cg.code, 0x3C); bb_write_u8(cg.code, 0x22); // '"'
    let jne_uq_pos = cg.code.size;
    bb_write_u8(cg.code, 0x75); bb_write_u8(cg.code, 0x00); // placeholder to uq_loop

    // quoted: start_idx = i + 1, inc i
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xFF); bb_write_u8(cg.code, 0x45); bb_write_u8(cg.code, 0xE0); // inc i
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x45); bb_write_u8(cg.code, 0xE0);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0x45); bb_write_u8(cg.code, 0xD0); // start_idx = i
    let q_loop = cg.code.size;
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x4D); bb_write_u8(cg.code, 0xE0);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x3B); bb_write_u8(cg.code, 0x4D); bb_write_u8(cg.code, 0xE8);
    let jge_q_pos = cg.code.size;
    bb_write_u8(cg.code, 0x7D); bb_write_u8(cg.code, 0x00); // placeholder to tok_end
    bb_write_u8(cg.code, 0x4C); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x55); bb_write_u8(cg.code, 0xF0);
    bb_write_u8(cg.code, 0x41); bb_write_u8(cg.code, 0x8A); bb_write_u8(cg.code, 0x04); bb_write_u8(cg.code, 0x0A);
    bb_write_u8(cg.code, 0x3C); bb_write_u8(cg.code, 0x22); // '"'
    let jz_q_pos = cg.code.size;
    bb_write_u8(cg.code, 0x74); bb_write_u8(cg.code, 0x00); // placeholder to tok_end
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xFF); bb_write_u8(cg.code, 0x45); bb_write_u8(cg.code, 0xE0); // inc i
    let back_q = cg.code.size + 2 - q_loop;
    let b_q = 256 - back_q;
    bb_write_u8(cg.code, 0xEB); bb_write_u8(cg.code, b_q);
    let jmp_tok_end_q_pos = cg.code.size;
    bb_write_u8(cg.code, 0xEB); bb_write_u8(cg.code, 0x00); // placeholder to tok_end

    // Patch jne_uq
    cg.code.data[jne_uq_pos + 1] = cg.code.size - (jne_uq_pos + 2);

    // unquoted loop:
    let uq_loop = cg.code.size;
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x4D); bb_write_u8(cg.code, 0xE0);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x3B); bb_write_u8(cg.code, 0x4D); bb_write_u8(cg.code, 0xE8);
    let jge_uq_pos = cg.code.size;
    bb_write_u8(cg.code, 0x7D); bb_write_u8(cg.code, 0x00); // placeholder
    bb_write_u8(cg.code, 0x4C); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x55); bb_write_u8(cg.code, 0xF0);
    bb_write_u8(cg.code, 0x41); bb_write_u8(cg.code, 0x8A); bb_write_u8(cg.code, 0x04); bb_write_u8(cg.code, 0x0A);
    bb_write_u8(cg.code, 0x3C); bb_write_u8(cg.code, 0x20); // ' '
    let jz_sp_pos = cg.code.size;
    bb_write_u8(cg.code, 0x74); bb_write_u8(cg.code, 0x00);
    bb_write_u8(cg.code, 0x3C); bb_write_u8(cg.code, 0x09); // '\t'
    let jz_tb_pos = cg.code.size;
    bb_write_u8(cg.code, 0x74); bb_write_u8(cg.code, 0x00);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xFF); bb_write_u8(cg.code, 0x45); bb_write_u8(cg.code, 0xE0); // inc i
    let back_uq = cg.code.size + 2 - uq_loop;
    let b_uq = 256 - back_uq;
    bb_write_u8(cg.code, 0xEB); bb_write_u8(cg.code, b_uq);

    // tok_end
    let tok_end_pos = cg.code.size;
    cg.code.data[jge_q_pos + 1] = tok_end_pos - (jge_q_pos + 2);
    cg.code.data[jz_q_pos + 1] = tok_end_pos - (jz_q_pos + 2);
    cg.code.data[jmp_tok_end_q_pos + 1] = tok_end_pos - (jmp_tok_end_q_pos + 2);
    cg.code.data[jge_uq_pos + 1] = tok_end_pos - (jge_uq_pos + 2);
    cg.code.data[jz_sp_pos + 1] = tok_end_pos - (jz_sp_pos + 2);
    cg.code.data[jz_tb_pos + 1] = tok_end_pos - (jz_tb_pos + 2);

    // check if cur_arg == target_idx
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x45); bb_write_u8(cg.code, 0xD8); // cur_arg
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x3B); bb_write_u8(cg.code, 0x45); bb_write_u8(cg.code, 0xF8); // target_idx
    let jne_next_pos = cg.code.size;
    bb_write_u8(cg.code, 0x75); bb_write_u8(cg.code, 0x00);

    // matched: call str_sub(cmdline: rcx, start_idx: rdx, len: r8)
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x4D); bb_write_u8(cg.code, 0xF0); // rcx = cmdline
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x55); bb_write_u8(cg.code, 0xD0); // rdx = start_idx
    bb_write_u8(cg.code, 0x4C); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x45); bb_write_u8(cg.code, 0xE0); // r8 = i
    bb_write_u8(cg.code, 0x4C); bb_write_u8(cg.code, 0x2B); bb_write_u8(cg.code, 0x45); bb_write_u8(cg.code, 0xD0); // r8 = i - start_idx
    cg_call_sym(cg, "__gat_str_sub");
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0xEC); bb_write_u8(cg.code, 0x5D); bb_write_u8(cg.code, 0xC3);

    // next_arg
    let next_arg_pos = cg.code.size;
    cg.code.data[jne_next_pos + 1] = next_arg_pos - (jne_next_pos + 2);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x4D); bb_write_u8(cg.code, 0xE0);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x3B); bb_write_u8(cg.code, 0x4D); bb_write_u8(cg.code, 0xE8);
    let jge_skip_q = cg.code.size;
    bb_write_u8(cg.code, 0x7D); bb_write_u8(cg.code, 0x0F);
    bb_write_u8(cg.code, 0x4C); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x55); bb_write_u8(cg.code, 0xF0);
    bb_write_u8(cg.code, 0x41); bb_write_u8(cg.code, 0x8A); bb_write_u8(cg.code, 0x04); bb_write_u8(cg.code, 0x0A);
    bb_write_u8(cg.code, 0x3C); bb_write_u8(cg.code, 0x22); // '"'
    bb_write_u8(cg.code, 0x75); bb_write_u8(cg.code, 0x04);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xFF); bb_write_u8(cg.code, 0x45); bb_write_u8(cg.code, 0xE0); // inc i
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xFF); bb_write_u8(cg.code, 0x45); bb_write_u8(cg.code, 0xD8); // inc cur_arg
    bb_write_u8(cg.code, 0xE9);
    let back_main = cg.code.size + 4 - arg_loop;
    let diff_m = 0 - back_main;
    bb_write_u32(cg.code, diff_m);

    // not_found
    let not_found_pos = cg.code.size;
    let diff_nf = not_found_pos - (jge_not_found_pos + 6);
    cg.code.data[jge_not_found_pos + 2] = diff_nf;
    cg.code.data[jge_not_found_pos + 3] = diff_nf / 256;
    cg.code.data[jge_not_found_pos + 4] = diff_nf / 65536;
    cg.code.data[jge_not_found_pos + 5] = (diff_nf / 65536) / 256;
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x8D); bb_write_u8(cg.code, 0x05); cg_reloc(cg, "str_empty_const", 1);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0xEC); bb_write_u8(cg.code, 0x5D); bb_write_u8(cg.code, 0xC3);

    // 13. __gat_read_file(rcx: path) -> rax
    cg_define_sym(cg, "__gat_read_file");
    bb_write_u8(cg.code, 0x55);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0xE5);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x83); bb_write_u8(cg.code, 0xEC); bb_write_u8(cg.code, 0x60);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0x4D); bb_write_u8(cg.code, 0xF8); // [rbp-8] = path
    // CreateFileA(path: rcx, GENERIC_READ: rdx, FILE_SHARE_READ: r8, NULL: r9, OPEN_EXISTING: [rsp+0x20]=3, NORMAL: [rsp+0x28]=0x80, NULL: [rsp+0x30]=0)
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xC7); bb_write_u8(cg.code, 0xC2); bb_write_u32(cg.code, 0x80000000);
    bb_write_u8(cg.code, 0x49); bb_write_u8(cg.code, 0xC7); bb_write_u8(cg.code, 0xC0); bb_write_u32(cg.code, 1);
    bb_write_u8(cg.code, 0x4D); bb_write_u8(cg.code, 0x31); bb_write_u8(cg.code, 0xC9);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xC7); bb_write_u8(cg.code, 0x44); bb_write_u8(cg.code, 0x24); bb_write_u8(cg.code, 0x20); bb_write_u32(cg.code, 3);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xC7); bb_write_u8(cg.code, 0x44); bb_write_u8(cg.code, 0x24); bb_write_u8(cg.code, 0x28); bb_write_u32(cg.code, 0x80);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xC7); bb_write_u8(cg.code, 0x44); bb_write_u8(cg.code, 0x24); bb_write_u8(cg.code, 0x30); bb_write_u32(cg.code, 0);
    cg_call_iat(cg, "CreateFileA");
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x83); bb_write_u8(cg.code, 0xF8); bb_write_u8(cg.code, 0xFF); // cmp rax, -1
    bb_write_u8(cg.code, 0x75); bb_write_u8(cg.code, 0x0C); // jne success (+12)
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x8D); bb_write_u8(cg.code, 0x05); cg_reloc(cg, "str_empty_const", 1);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0xEC); bb_write_u8(cg.code, 0x5D); bb_write_u8(cg.code, 0xC3);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0x45); bb_write_u8(cg.code, 0xF0); // [rbp-16] = hFile
    // GetFileSizeEx
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x4D); bb_write_u8(cg.code, 0xF0); // rcx = [rbp-16] (hFile)
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x8D); bb_write_u8(cg.code, 0x55); bb_write_u8(cg.code, 0xE8); // rdx = lea [rbp-24]
    cg_call_iat(cg, "GetFileSizeEx");
    // Alloc size + 1
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x4D); bb_write_u8(cg.code, 0xE8);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xFF); bb_write_u8(cg.code, 0xC1);
    cg_call_sym(cg, "__gat_alloc_mem");
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0x45); bb_write_u8(cg.code, 0xE0); // [rbp-32] = buf
    // ReadFile
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x4D); bb_write_u8(cg.code, 0xF0); // hFile
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x55); bb_write_u8(cg.code, 0xE0); // buf
    bb_write_u8(cg.code, 0x4C); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x45); bb_write_u8(cg.code, 0xE8); // size
    bb_write_u8(cg.code, 0x4C); bb_write_u8(cg.code, 0x8D); bb_write_u8(cg.code, 0x4D); bb_write_u8(cg.code, 0xD8); // r9 = lea [rbp-40]
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xC7); bb_write_u8(cg.code, 0x44); bb_write_u8(cg.code, 0x24); bb_write_u8(cg.code, 0x20); bb_write_u32(cg.code, 0);
    cg_call_iat(cg, "ReadFile");
    // Null-terminate buf[size] = 0
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x45); bb_write_u8(cg.code, 0xE0); // rax = buf
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x55); bb_write_u8(cg.code, 0xE8); // rdx = size
    bb_write_u8(cg.code, 0xC6); bb_write_u8(cg.code, 0x04); bb_write_u8(cg.code, 0x10); bb_write_u8(cg.code, 0x00); // mov byte ptr [rax+rdx], 0
    // CloseHandle
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x4D); bb_write_u8(cg.code, 0xF0);
    cg_call_iat(cg, "CloseHandle");
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x45); bb_write_u8(cg.code, 0xE0); // rax = buf
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0xEC); bb_write_u8(cg.code, 0x5D); bb_write_u8(cg.code, 0xC3);

    // 14. __gat_write_file(rcx: path, rdx: data, r8: len) -> rax
    cg_define_sym(cg, "__gat_write_file");
    bb_write_u8(cg.code, 0x55);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0xE5);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x83); bb_write_u8(cg.code, 0xEC); bb_write_u8(cg.code, 0x60);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0x4D); bb_write_u8(cg.code, 0xF8); // path
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0x55); bb_write_u8(cg.code, 0xF0); // data
    bb_write_u8(cg.code, 0x4C); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0x45); bb_write_u8(cg.code, 0xE8); // len
    // CreateFileA(CREATE_ALWAYS = 2)
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xC7); bb_write_u8(cg.code, 0xC2); bb_write_u32(cg.code, 0x40000000); // GENERIC_WRITE
    bb_write_u8(cg.code, 0x49); bb_write_u8(cg.code, 0xC7); bb_write_u8(cg.code, 0xC0); bb_write_u32(cg.code, 0);
    bb_write_u8(cg.code, 0x4D); bb_write_u8(cg.code, 0x31); bb_write_u8(cg.code, 0xC9);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xC7); bb_write_u8(cg.code, 0x44); bb_write_u8(cg.code, 0x24); bb_write_u8(cg.code, 0x20); bb_write_u32(cg.code, 2);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xC7); bb_write_u8(cg.code, 0x44); bb_write_u8(cg.code, 0x24); bb_write_u8(cg.code, 0x28); bb_write_u32(cg.code, 0x80);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xC7); bb_write_u8(cg.code, 0x44); bb_write_u8(cg.code, 0x24); bb_write_u8(cg.code, 0x30); bb_write_u32(cg.code, 0);
    cg_call_iat(cg, "CreateFileA");
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x83); bb_write_u8(cg.code, 0xF8); bb_write_u8(cg.code, 0xFF);
    bb_write_u8(cg.code, 0x75); bb_write_u8(cg.code, 0x07); // jne success (+7)
    bb_write_u8(cg.code, 0x31); bb_write_u8(cg.code, 0xC0); bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0xEC); bb_write_u8(cg.code, 0x5D); bb_write_u8(cg.code, 0xC3);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0x45); bb_write_u8(cg.code, 0xD0); // [rbp-48] = hFile
    // WriteFile
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x4D); bb_write_u8(cg.code, 0xD0);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x55); bb_write_u8(cg.code, 0xF0);
    bb_write_u8(cg.code, 0x4C); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x45); bb_write_u8(cg.code, 0xE8);
    bb_write_u8(cg.code, 0x4C); bb_write_u8(cg.code, 0x8D); bb_write_u8(cg.code, 0x4D); bb_write_u8(cg.code, 0xD8);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xC7); bb_write_u8(cg.code, 0x44); bb_write_u8(cg.code, 0x24); bb_write_u8(cg.code, 0x20); bb_write_u32(cg.code, 0);
    cg_call_iat(cg, "WriteFile");
    // CloseHandle
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x4D); bb_write_u8(cg.code, 0xD0);
    cg_call_iat(cg, "CloseHandle");
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x45); bb_write_u8(cg.code, 0xD8); // written
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0xEC); bb_write_u8(cg.code, 0x5D); bb_write_u8(cg.code, 0xC3);

    // 15. __gat_retain(rcx: ptr)
    cg_define_sym(cg, "__gat_retain");
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x85); bb_write_u8(cg.code, 0xC9);
    bb_write_u8(cg.code, 0x74); bb_write_u8(cg.code, 0x04);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xFF); bb_write_u8(cg.code, 0x41); bb_write_u8(cg.code, 0xF0); // inc qword ptr [rcx-16]
    bb_write_u8(cg.code, 0xC3);

    // 16. __gat_release(rcx: ptr)
    cg_define_sym(cg, "__gat_release");
    bb_write_u8(cg.code, 0x55);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0xE5);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x83); bb_write_u8(cg.code, 0xEC); bb_write_u8(cg.code, 0x40);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x85); bb_write_u8(cg.code, 0xC9);
    bb_write_u8(cg.code, 0x74); bb_write_u8(cg.code, 0x17); // jz +23
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0x4D); bb_write_u8(cg.code, 0xF8); // ptr
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xFF); bb_write_u8(cg.code, 0x49); bb_write_u8(cg.code, 0xF0); // dec [rcx-16]
    bb_write_u8(cg.code, 0x75); bb_write_u8(cg.code, 0x0D); // jnz +13
    // free memory
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x4D); bb_write_u8(cg.code, 0xF8);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x83); bb_write_u8(cg.code, 0xE9); bb_write_u8(cg.code, 0x10); // rcx = ptr - 16
    cg_call_sym(cg, "__gat_free_mem");
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0xEC); bb_write_u8(cg.code, 0x5D); bb_write_u8(cg.code, 0xC3);
}

// Emit function machine instructions
fn cg_emit_function(cg: CodeGen, fn_obj: IRFunc) {
    cg_define_sym(cg, fn_obj.name);

    // Prologue: push rbp; mov rbp, rsp; sub rsp, frameSize
    let frame_size = align_val((fn_obj.max_local + 4) * 8 + 32, 16);
    bb_write_u8(cg.code, 0x55);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0xE5);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x81); bb_write_u8(cg.code, 0xEC);
    bb_write_u32(cg.code, frame_size);

    // Save incoming fastcall parameters to their stack slots
    if fn_obj.param_count > 0 { // RCX -> param 1
        bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0x8D);
        bb_write_u32(cg.code, (0 - 8));
    }
    if fn_obj.param_count > 1 { // RDX -> param 2
        bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0x95);
        bb_write_u32(cg.code, (0 - 16));
    }
    if fn_obj.param_count > 2 { // R8 -> param 3
        bb_write_u8(cg.code, 0x4C); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0x85);
        bb_write_u32(cg.code, (0 - 24));
    }
    if fn_obj.param_count > 3 { // R9 -> param 4
        bb_write_u8(cg.code, 0x4C); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0x8D);
        bb_write_u32(cg.code, (0 - 32));
    }
    if fn_obj.param_count > 4 { // [rbp + 48] -> param 5
        bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x45); bb_write_u8(cg.code, 0x30); // mov rax, [rbp+0x30]
        bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0x85);
        bb_write_u32(cg.code, (0 - 40)); // mov [rbp-40], rax
    }

    // Zero-initialize remaining local variable slots
    let loc_idx = fn_obj.param_count + 1;
    while loc_idx <= fn_obj.max_local {
        let disp = loc_idx * 8;
        bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xC7); bb_write_u8(cg.code, 0x85);
        bb_write_u32(cg.code, (0 - disp));
        bb_write_u32(cg.code, 0);
        loc_idx = loc_idx + 1;
    }

    let inst = fn_obj.inst_head;
    while inst != nil {
        if inst.op == IR_OP_CONST_INT {
            let disp = inst.dest * 8;
            if inst.int_val >= (0 - 2147483648) && inst.int_val <= 2147483647 {
                bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xC7); bb_write_u8(cg.code, 0x85);
                bb_write_u32(cg.code, (0 - disp));
                bb_write_u32(cg.code, inst.int_val);
            } else {
                bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xB8);
                bb_write_u64(cg.code, inst.int_val);
                cg_mov_local_reg(cg, inst.dest, 0);
            }
        } else if inst.op == IR_OP_CONST_BOOL {
            let disp = inst.dest * 8;
            bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xC7); bb_write_u8(cg.code, 0x85);
            bb_write_u32(cg.code, (0 - disp));
            bb_write_u32(cg.code, inst.int_val);
        } else if inst.op == IR_OP_CONST_STR {
            bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x8D); bb_write_u8(cg.code, 0x05);
            cg_reloc(cg, inst.str_val, 1);
            cg_mov_local_reg(cg, inst.dest, 0);
        } else if inst.op == IR_OP_COPY {
            cg_mov_reg_local(cg, 0, inst.src1);
            cg_mov_local_reg(cg, inst.dest, 0);
        } else if inst.op == IR_OP_BIN_OP {
            cg_mov_reg_local(cg, 0, inst.src1); // RAX
            cg_mov_reg_local(cg, 2, inst.src2); // RDX
            if str_eq(inst.str_val, "+") {
                bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x01); bb_write_u8(cg.code, 0xD0);
            } else if str_eq(inst.str_val, "-") {
                bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x29); bb_write_u8(cg.code, 0xD0);
            } else if str_eq(inst.str_val, "*") {
                bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x0F); bb_write_u8(cg.code, 0xAF); bb_write_u8(cg.code, 0xC2);
            } else if str_eq(inst.str_val, "/") {
                cg_mov_reg_local(cg, 3, inst.src2); // R10 = src2
                bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x99); // cqo
                bb_write_u8(cg.code, 0x49); bb_write_u8(cg.code, 0xF7); bb_write_u8(cg.code, 0xFA); // idiv r10
            } else if str_eq(inst.str_val, "%") {
                cg_mov_reg_local(cg, 3, inst.src2); // R10 = src2
                bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x99); // cqo
                bb_write_u8(cg.code, 0x49); bb_write_u8(cg.code, 0xF7); bb_write_u8(cg.code, 0xFA); // idiv r10
                bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0xD0); // mov rax, rdx
            } else if str_eq(inst.str_val, "&&") {
                bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x21); bb_write_u8(cg.code, 0xD0); // and rax, rdx
            } else if str_eq(inst.str_val, "||") {
                bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x09); bb_write_u8(cg.code, 0xD0); // or rax, rdx
            } else if str_eq(inst.str_val, "==") {
                bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x39); bb_write_u8(cg.code, 0xD0);
                bb_write_u8(cg.code, 0x0F); bb_write_u8(cg.code, 0x94); bb_write_u8(cg.code, 0xC0);
                bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x0F); bb_write_u8(cg.code, 0xB6); bb_write_u8(cg.code, 0xC0);
            } else if str_eq(inst.str_val, "!=") {
                bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x39); bb_write_u8(cg.code, 0xD0);
                bb_write_u8(cg.code, 0x0F); bb_write_u8(cg.code, 0x95); bb_write_u8(cg.code, 0xC0);
                bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x0F); bb_write_u8(cg.code, 0xB6); bb_write_u8(cg.code, 0xC0);
            } else if str_eq(inst.str_val, "<") {
                bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x39); bb_write_u8(cg.code, 0xD0);
                bb_write_u8(cg.code, 0x0F); bb_write_u8(cg.code, 0x9C); bb_write_u8(cg.code, 0xC0);
                bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x0F); bb_write_u8(cg.code, 0xB6); bb_write_u8(cg.code, 0xC0);
            } else if str_eq(inst.str_val, "<=") {
                bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x39); bb_write_u8(cg.code, 0xD0);
                bb_write_u8(cg.code, 0x0F); bb_write_u8(cg.code, 0x9E); bb_write_u8(cg.code, 0xC0);
                bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x0F); bb_write_u8(cg.code, 0xB6); bb_write_u8(cg.code, 0xC0);
            } else if str_eq(inst.str_val, ">") {
                bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x39); bb_write_u8(cg.code, 0xD0);
                bb_write_u8(cg.code, 0x0F); bb_write_u8(cg.code, 0x9F); bb_write_u8(cg.code, 0xC0);
                bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x0F); bb_write_u8(cg.code, 0xB6); bb_write_u8(cg.code, 0xC0);
            } else if str_eq(inst.str_val, ">=") {
                bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x39); bb_write_u8(cg.code, 0xD0);
                bb_write_u8(cg.code, 0x0F); bb_write_u8(cg.code, 0x9D); bb_write_u8(cg.code, 0xC0);
                bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x0F); bb_write_u8(cg.code, 0xB6); bb_write_u8(cg.code, 0xC0);
            }
            cg_mov_local_reg(cg, inst.dest, 0);
        } else if inst.op == IR_OP_UN_OP {
            cg_mov_reg_local(cg, 0, inst.src1);
            if str_eq(inst.str_val, "-") {
                bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xF7); bb_write_u8(cg.code, 0xD8);
            } else if str_eq(inst.str_val, "!") {
                bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x83); bb_write_u8(cg.code, 0xF8); bb_write_u8(cg.code, 0x00);
                bb_write_u8(cg.code, 0x0F); bb_write_u8(cg.code, 0x94); bb_write_u8(cg.code, 0xC0);
                bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x0F); bb_write_u8(cg.code, 0xB6); bb_write_u8(cg.code, 0xC0);
            }
            cg_mov_local_reg(cg, inst.dest, 0);
        } else if inst.op == IR_OP_LOAD {
            cg_mov_reg_local(cg, 3, inst.src1);
            // mov rax, [r10 + offset] -> 49 8B 82 disp32
            bb_write_u8(cg.code, 0x49); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x82);
            bb_write_u32(cg.code, inst.offset);
            cg_mov_local_reg(cg, inst.dest, 0);
        } else if inst.op == IR_OP_STORE {
            cg_mov_reg_local(cg, 3, inst.dest);
            cg_mov_reg_local(cg, 0, inst.src1);
            // mov [r10 + offset], rax -> 49 89 82 disp32
            bb_write_u8(cg.code, 0x49); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0x82);
            bb_write_u32(cg.code, inst.offset);
        } else if inst.op == IR_OP_LOAD_INDEX {
            cg_mov_reg_local(cg, 3, inst.src1);
            cg_mov_reg_local(cg, 1, inst.src2);
            if inst.int_val == 1 {
                // movzx rax, byte ptr [r10 + rcx] -> 49 0F B6 04 0A
                bb_write_u8(cg.code, 0x49); bb_write_u8(cg.code, 0x0F); bb_write_u8(cg.code, 0xB6); bb_write_u8(cg.code, 0x04); bb_write_u8(cg.code, 0x0A);
            } else {
                // mov rax, qword ptr [r10 + rcx*8] -> 49 8B 04 CA
                bb_write_u8(cg.code, 0x49); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x04); bb_write_u8(cg.code, 0xCA);
            }
            cg_mov_local_reg(cg, inst.dest, 0);
        } else if inst.op == IR_OP_STORE_INDEX {
            cg_mov_reg_local(cg, 3, inst.dest);
            cg_mov_reg_local(cg, 1, inst.src2);
            cg_mov_reg_local(cg, 0, inst.src1);
            if inst.int_val == 1 {
                // mov byte ptr [r10 + rcx], al -> 41 88 04 0A
                bb_write_u8(cg.code, 0x41); bb_write_u8(cg.code, 0x88); bb_write_u8(cg.code, 0x04); bb_write_u8(cg.code, 0x0A);
            } else {
                // mov qword ptr [r10 + rcx*8], rax -> 49 89 04 CA
                bb_write_u8(cg.code, 0x49); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0x04); bb_write_u8(cg.code, 0xCA);
            }
        } else if inst.op == IR_OP_ALLOC_HEAP {
            bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xC7); bb_write_u8(cg.code, 0xC1);
            bb_write_u32(cg.code, inst.offset + 16);
            cg_call_sym(cg, "__gat_alloc_mem");
            bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xC7); bb_write_u8(cg.code, 0x00); bb_write_u32(cg.code, 1);
            bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xC7); bb_write_u8(cg.code, 0x40); bb_write_u8(cg.code, 0x08); bb_write_u32(cg.code, inst.int_val);
            bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x83); bb_write_u8(cg.code, 0xC0); bb_write_u8(cg.code, 0x10);
            cg_mov_local_reg(cg, inst.dest, 0);
        } else if inst.op == IR_OP_ALLOC_STACK {
            bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xC7); bb_write_u8(cg.code, 0xC1);
            bb_write_u32(cg.code, inst.offset + 8);
            cg_call_sym(cg, "__gat_alloc_mem");
            cg_mov_local_reg(cg, inst.dest, 0);
        } else if inst.op == IR_OP_RETAIN {
            cg_mov_reg_local(cg, 1, inst.src1);
            cg_call_sym(cg, "__gat_retain");
        } else if inst.op == IR_OP_RELEASE {
            cg_mov_reg_local(cg, 1, inst.src1);
            cg_call_sym(cg, "__gat_release");
        } else if inst.op == IR_OP_CALL {
            if inst.arg_count >= 1 { cg_mov_reg_local(cg, 1, inst.src1); }
            if inst.arg_count >= 2 { cg_mov_reg_local(cg, 2, inst.src2); }
            if inst.arg_count >= 3 { cg_mov_reg_local(cg, 4, inst.offset); }
            if inst.arg_count >= 4 { cg_mov_reg_local(cg, 5, inst.int_val); }
            if inst.arg_count >= 5 {
                cg_mov_reg_local(cg, 0, inst.extra);
                bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0x44); bb_write_u8(cg.code, 0x24); bb_write_u8(cg.code, 0x20); // mov [rsp+0x20], rax
            }
            let callee = inst.str_val;
            if str_eq(callee, "read_file") { callee = "__gat_read_file"; }
            else if str_eq(callee, "write_file") { callee = "__gat_write_file"; }
            else if str_eq(callee, "alloc_mem") { callee = "__gat_alloc_mem"; }
            else if str_eq(callee, "free_mem") { callee = "__gat_free_mem"; }
            else if str_eq(callee, "str_len") { callee = "__gat_str_len"; }
            else if str_eq(callee, "str_eq") { callee = "__gat_str_eq"; }
            else if str_eq(callee, "str_char") { callee = "__gat_str_char"; }
            else if str_eq(callee, "str_sub") { callee = "__gat_str_sub"; }
            else if str_eq(callee, "str_concat") { callee = "__gat_str_concat"; }
            else if str_eq(callee, "str_from_int") { callee = "__gat_str_from_int"; }
            else if str_eq(callee, "get_cmd_arg") { callee = "__gat_get_cmd_arg"; }
            cg_call_sym(cg, callee);
            if inst.dest != 0 {
                cg_mov_local_reg(cg, inst.dest, 0);
            }
        } else if inst.op == IR_OP_PRINT {
            cg_mov_reg_local(cg, 1, inst.src1);
            if inst.type_kind == TYPE_STRING {
                cg_call_sym(cg, "__gat_print_str");
            } else if inst.type_kind == TYPE_BOOL {
                cg_call_sym(cg, "__gat_print_bool");
            } else {
                cg_call_sym(cg, "__gat_print_i64");
            }
        } else if inst.op == IR_OP_RETURN {
            cg_mov_reg_local(cg, 0, inst.src1);
            bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0xEC);
            bb_write_u8(cg.code, 0x5D);
            bb_write_u8(cg.code, 0xC3);
        } else if inst.op == IR_OP_LABEL {
            cg_define_sym(cg, inst.label);
        } else if inst.op == IR_OP_JUMP {
            bb_write_u8(cg.code, 0xE9);
            cg_reloc(cg, inst.label, 1);
        } else if inst.op == IR_OP_BRANCH {
            cg_mov_reg_local(cg, 0, inst.src1);
            bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x85); bb_write_u8(cg.code, 0xC0);
            bb_write_u8(cg.code, 0x0F); bb_write_u8(cg.code, 0x84);
            cg_reloc(cg, inst.label, 1);
        }
        inst = inst.next;
    }

    // Default epilogue: mov rsp, rbp; pop rbp; ret
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0xEC);
    bb_write_u8(cg.code, 0x5D);
    bb_write_u8(cg.code, 0xC3);
}

// ----------------------------------------------------------------------------
