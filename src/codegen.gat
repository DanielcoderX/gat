    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x85); bb_write_u8(cg.code, 0xFF); // test rdi, rdi
    bb_write_u8(cg.code, 0x74); bb_write_u8(cg.code, 5);            // jz +5
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xFF); bb_write_u8(cg.code, 0x47); bb_write_u8(cg.code, 0xF0); // inc qword ptr [rdi-16]
    bb_write_u8(cg.code, 0xC3);                                     // ret

    // 24. __gat_weak_release(rdi: ptr)
    cg_define_sym(cg, "__gat_weak_release");
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x85); bb_write_u8(cg.code, 0xFF); // test rdi, rdi
    bb_write_u8(cg.code, 0x74); bb_write_u8(cg.code, 5);            // jz +5
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xFF); bb_write_u8(cg.code, 0x4F); bb_write_u8(cg.code, 0xF0); // dec qword ptr [rdi-16]
    bb_write_u8(cg.code, 0xC3);                                     // ret

    // 25. __gat_strong_count(rdi: ptr) -> i64
    cg_define_sym(cg, "__gat_strong_count");
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x85); bb_write_u8(cg.code, 0xFF); // test rdi, rdi
    bb_write_u8(cg.code, 0x74); bb_write_u8(cg.code, 5);            // jz +5
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x47); bb_write_u8(cg.code, 0xE8); // mov rax, [rdi-24]
    bb_write_u8(cg.code, 0xC3);                                     // ret
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x31); bb_write_u8(cg.code, 0xC0); // xor rax, rax
    bb_write_u8(cg.code, 0xC3);                                     // ret

    // 26. __gat_weak_count(rdi: ptr) -> i64
    cg_define_sym(cg, "__gat_weak_count");
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x85); bb_write_u8(cg.code, 0xFF); // test rdi, rdi
    bb_write_u8(cg.code, 0x74); bb_write_u8(cg.code, 5);            // jz +5
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x47); bb_write_u8(cg.code, 0xF0); // mov rax, [rdi-16]
    bb_write_u8(cg.code, 0xC3);                                     // ret
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x31); bb_write_u8(cg.code, 0xC0); // xor rax, rax
    bb_write_u8(cg.code, 0xC3);                                     // ret

    // 27. __gat_mutex_init(rdi: ptr)
    cg_define_sym(cg, "__gat_mutex_init");
    bb_write_u8(cg.code, 0xC7); bb_write_u8(cg.code, 0x07); bb_write_u32(cg.code, 0); // mov dword ptr [rdi], 0
    bb_write_u8(cg.code, 0xC3);                                     // ret

    // 28. __gat_mutex_lock(rdi: ptr)
    cg_define_sym(cg, "__gat_mutex_lock");
    // .Lspin:
    bb_write_u8(cg.code, 0x31); bb_write_u8(cg.code, 0xC0);         // xor eax, eax
    bb_write_u8(cg.code, 0xB9); bb_write_u32(cg.code, 1);          // mov ecx, 1
    bb_write_u8(cg.code, 0xF0); bb_write_u8(cg.code, 0x0F); bb_write_u8(cg.code, 0xB1); bb_write_u8(cg.code, 0x0F); // lock cmpxchg [rdi], ecx
    bb_write_u8(cg.code, 0x74); bb_write_u8(cg.code, 4);            // jz +4 (.Llock_done)
    bb_write_u8(cg.code, 0xF3); bb_write_u8(cg.code, 0x90);         // pause
    bb_write_u8(cg.code, 0xEB); bb_write_u8(cg.code, 0xF0);         // jmp -16 (.Lspin)
    // .Llock_done:
    bb_write_u8(cg.code, 0xC3);                                     // ret

    // 29. __gat_mutex_unlock(rdi: ptr)
    cg_define_sym(cg, "__gat_mutex_unlock");
    bb_write_u8(cg.code, 0xC7); bb_write_u8(cg.code, 0x07); bb_write_u32(cg.code, 0); // mov dword ptr [rdi], 0
    bb_write_u8(cg.code, 0xC3);                                     // ret

    // 30. __gat_mutex_destroy(rdi: ptr)
    cg_define_sym(cg, "__gat_mutex_destroy");
    bb_write_u8(cg.code, 0xC3);                                     // ret

    // 31. __gat_thread_spawn(rdi: fn_ptr, rsi: arg) -> i64
    cg_define_sym(cg, "__gat_thread_spawn");
    bb_write_u8(cg.code, 0x55);                                     // push rbp
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0xE5); // mov rbp, rsp
    bb_write_u8(cg.code, 0x53);                                     // push rbx
    bb_write_u8(cg.code, 0x41); bb_write_u8(cg.code, 0x54);         // push r12
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0xFB); // mov rbx, rdi (fn)
    bb_write_u8(cg.code, 0x49); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0xF4); // mov r12, rsi (arg)
    // Allocate 64KB thread stack
    bb_write_u8(cg.code, 0xBF); bb_write_u32(cg.code, 65536);      // mov edi, 65536
    cg_call_sym(cg, "__gat_alloc_mem");
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x05); bb_write_u32(cg.code, 65472); // add rax, 65472 (16-byte aligned stack top)
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0x58); bb_write_u8(cg.code, 0x10); // mov [rax+16], rbx (fn)
    bb_write_u8(cg.code, 0x4C); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0x60); bb_write_u8(cg.code, 0x18); // mov [rax+24], r12 (arg)
    // sys_clone(flags, child_stack, parent_tid, child_tid, tls)
    // flags = CLONE_VM(0x100)|CLONE_FS(0x200)|CLONE_FILES(0x400)|CLONE_SYSVSEM(0x40000)|SIGCHLD(17) = 0x40711 (263953)
    bb_write_u8(cg.code, 0xBF); bb_write_u32(cg.code, 263953);     // mov edi, 0x40711
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0xC6); // mov rsi, rax (child_stack)
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x31); bb_write_u8(cg.code, 0xD2); // xor rdx, rdx
    bb_write_u8(cg.code, 0x4D); bb_write_u8(cg.code, 0x31); bb_write_u8(cg.code, 0xD2); // xor r10, r10
    bb_write_u8(cg.code, 0x4D); bb_write_u8(cg.code, 0x31); bb_write_u8(cg.code, 0xC0); // xor r8, r8
    bb_write_u8(cg.code, 0xB8); bb_write_u32(cg.code, 56);         // mov eax, 56 (sys_clone)
    bb_write_u8(cg.code, 0x0F); bb_write_u8(cg.code, 0x05);         // syscall
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x85); bb_write_u8(cg.code, 0xC0); // test rax, rax
    bb_write_u8(cg.code, 0x75); bb_write_u8(cg.code, 19);           // jnz +19 (.Lspawn_parent)
    // Child: call fn(arg); sys_exit(0)
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x7C); bb_write_u8(cg.code, 0x24); bb_write_u8(cg.code, 0x18); // mov rdi, [rsp+24] (arg)
    bb_write_u8(cg.code, 0xFF); bb_write_u8(cg.code, 0x54); bb_write_u8(cg.code, 0x24); bb_write_u8(cg.code, 0x10); // call qword ptr [rsp+16] (fn)
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0xC7); // mov rdi, rax
    bb_write_u8(cg.code, 0xB8); bb_write_u32(cg.code, 60);         // mov eax, 60 (sys_exit)
    bb_write_u8(cg.code, 0x0F); bb_write_u8(cg.code, 0x05);         // syscall
    // .Lspawn_parent:
    bb_write_u8(cg.code, 0x41); bb_write_u8(cg.code, 0x5C);         // pop r12
    bb_write_u8(cg.code, 0x5B);                                     // pop rbx
    bb_write_u8(cg.code, 0x5D);                                     // pop rbp
    bb_write_u8(cg.code, 0xC3);                                     // ret

    // 32. __gat_thread_join(rdi: handle)
    cg_define_sym(cg, "__gat_thread_join");
    bb_write_u8(cg.code, 0xBF); bb_write_u32(cg.code, 10);         // mov edi, 10 (sleep 10ms)
    cg_call_sym(cg, "__gat_sleep");
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x31); bb_write_u8(cg.code, 0xC0); // xor rax, rax
    bb_write_u8(cg.code, 0xC3);                                     // ret
}

fn cg_emit_runtime(cg: CodeGen) {
    if cg_is_linux(cg) {
        cg_emit_runtime_linux(cg);
    } else {
        cg_emit_runtime_windows(cg);
    }
}

fn cg_emit_epilogue(cg: CodeGen, ra_res: RegAllocResult) {
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0xEC); // mov rsp, rbp
    if ra_res != nil {
        if ra_res.used_r14 == 1 { bb_write_u8(cg.code, 0x41); bb_write_u8(cg.code, 0x5E); } // pop r14
        if ra_res.used_r13 == 1 { bb_write_u8(cg.code, 0x41); bb_write_u8(cg.code, 0x5D); } // pop r13
        if ra_res.used_r12 == 1 { bb_write_u8(cg.code, 0x41); bb_write_u8(cg.code, 0x5C); } // pop r12
        if ra_res.used_rbx == 1 { bb_write_u8(cg.code, 0x5B); } // pop rbx
    }
    bb_write_u8(cg.code, 0x5D); // pop rbp
    bb_write_u8(cg.code, 0xC3); // ret
}

// Emit function machine instructions
fn cg_emit_function(cg: CodeGen, fn_obj: IRFunc) {
    let ra_res = ra_allocate_function(fn_obj);
    cg_define_sym(cg, fn_obj.name);

    // Prologue: push rbp; [push callee-saved regs]; mov rbp, rsp; sub rsp, frameSize
    bb_write_u8(cg.code, 0x55);
    if ra_res != nil {
        if ra_res.used_rbx == 1 { bb_write_u8(cg.code, 0x53); }
        if ra_res.used_r12 == 1 { bb_write_u8(cg.code, 0x41); bb_write_u8(cg.code, 0x54); }
        if ra_res.used_r13 == 1 { bb_write_u8(cg.code, 0x41); bb_write_u8(cg.code, 0x55); }
        if ra_res.used_r14 == 1 { bb_write_u8(cg.code, 0x41); bb_write_u8(cg.code, 0x56); }
    }
    let num_callee = 0;
    if ra_res != nil {
        num_callee = ra_res.used_rbx + ra_res.used_r12 + ra_res.used_r13 + ra_res.used_r14;
    }
    let frame_size = align_val((fn_obj.max_local + 4) * 8 + 32, 16);
    if cg_is_linux(cg) {
        frame_size = align_val((fn_obj.max_local + 6) * 8, 16);
    }
    if num_callee == 1 || num_callee == 3 {
        frame_size = frame_size + 8;
    }
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0xE5);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x81); bb_write_u8(cg.code, 0xEC);
    bb_write_u32(cg.code, frame_size);

    if cg_is_linux(cg) {
        if fn_obj.param_count > 0 { // RDI -> param 1
            let phys = 0;
            if ra_res != nil && 1 < ra_res.max_local + 64 { phys = ra_res.reg_map[1]; }
            if phys > 0 {
                cg_mov_phys_from_scratch(cg, phys, 6);
            } else {
                bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0xBD);
                bb_write_u32(cg.code, (0 - 8));
            }
        }
        if fn_obj.param_count > 1 { // RSI -> param 2
            let phys = 0;
            if ra_res != nil && 2 < ra_res.max_local + 64 { phys = ra_res.reg_map[2]; }
            if phys > 0 {
                cg_mov_phys_from_scratch(cg, phys, 7);
            } else {
                bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0xB5);
                bb_write_u32(cg.code, (0 - 16));
            }
        }
        if fn_obj.param_count > 2 { // RDX -> param 3
            let phys = 0;
            if ra_res != nil && 3 < ra_res.max_local + 64 { phys = ra_res.reg_map[3]; }
            if phys > 0 {
                cg_mov_phys_from_scratch(cg, phys, 2);
            } else {
                bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0x95);
                bb_write_u32(cg.code, (0 - 24));
            }
        }
        if fn_obj.param_count > 3 { // RCX -> param 4
            let phys = 0;
            if ra_res != nil && 4 < ra_res.max_local + 64 { phys = ra_res.reg_map[4]; }
            if phys > 0 {
                cg_mov_phys_from_scratch(cg, phys, 1);
            } else {
                bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0x8D);
                bb_write_u32(cg.code, (0 - 32));
            }
        }
        if fn_obj.param_count > 4 { // R8 -> param 5
            let phys = 0;
            if ra_res != nil && 5 < ra_res.max_local + 64 { phys = ra_res.reg_map[5]; }
            if phys > 0 {
                cg_mov_phys_from_scratch(cg, phys, 4);
            } else {
                bb_write_u8(cg.code, 0x4C); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0x85);
                bb_write_u32(cg.code, (0 - 40));
            }
        }
        if fn_obj.param_count > 5 { // R9 -> param 6
            let phys = 0;
            if ra_res != nil && 6 < ra_res.max_local + 64 { phys = ra_res.reg_map[6]; }
            if phys > 0 {
                cg_mov_phys_from_scratch(cg, phys, 5);
            } else {
                bb_write_u8(cg.code, 0x4C); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0x8D);
                bb_write_u32(cg.code, (0 - 48));
            }
        }
        if fn_obj.param_count > 6 { // 7th param from caller stack frame
            let phys = 0;
            if ra_res != nil && 7 < ra_res.max_local + 64 { phys = ra_res.reg_map[7]; }
            let arg7_disp = 16 + num_callee * 8;
            bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x45); bb_write_u8(cg.code, arg7_disp);
            if phys > 0 {
                cg_mov_phys_from_scratch(cg, phys, 0);
            } else {
                bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0x85);
                bb_write_u32(cg.code, (0 - 56));
            }
        }
    } else {
        // Save incoming fastcall parameters to their registers or stack slots
        if fn_obj.param_count > 0 { // RCX -> param 1
            let phys = 0;
            if ra_res != nil && 1 < ra_res.max_local + 64 { phys = ra_res.reg_map[1]; }
            if phys > 0 {
                cg_mov_phys_from_scratch(cg, phys, 1);
            } else {
                bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0x8D);
                bb_write_u32(cg.code, (0 - 8));
            }
        }
        if fn_obj.param_count > 1 { // RDX -> param 2
            let phys = 0;
            if ra_res != nil && 2 < ra_res.max_local + 64 { phys = ra_res.reg_map[2]; }
            if phys > 0 {
                cg_mov_phys_from_scratch(cg, phys, 2);
            } else {
                bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0x95);
                bb_write_u32(cg.code, (0 - 16));
            }
        }
        if fn_obj.param_count > 2 { // R8 -> param 3
            let phys = 0;
            if ra_res != nil && 3 < ra_res.max_local + 64 { phys = ra_res.reg_map[3]; }
            if phys > 0 {
                cg_mov_phys_from_scratch(cg, phys, 4);
            } else {
                bb_write_u8(cg.code, 0x4C); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0x85);
                bb_write_u32(cg.code, (0 - 24));
            }
        }
        if fn_obj.param_count > 3 { // R9 -> param 4
            let phys = 0;
            if ra_res != nil && 4 < ra_res.max_local + 64 { phys = ra_res.reg_map[4]; }
            if phys > 0 {
                cg_mov_phys_from_scratch(cg, phys, 5);
            } else {
                bb_write_u8(cg.code, 0x4C); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0x8D);
                bb_write_u32(cg.code, (0 - 32));
            }
        }
        if fn_obj.param_count > 4 { // 5th param from caller stack frame
            let phys = 0;
            if ra_res != nil && 5 < ra_res.max_local + 64 { phys = ra_res.reg_map[5]; }
            let arg5_disp = 48 + num_callee * 8;
            bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x45); bb_write_u8(cg.code, arg5_disp); // mov rax, [rbp + arg5_disp]
            if phys > 0 {
                cg_mov_phys_from_scratch(cg, phys, 0);
            } else {
                bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0x85);
                bb_write_u32(cg.code, (0 - 40));
            }
        }
    }

    // Zero-initialize remaining spilled local variable slots
    let loc_idx = fn_obj.param_count + 1;
    while loc_idx <= fn_obj.max_local {
        let phys = 0;
        if ra_res != nil && loc_idx < ra_res.max_local + 64 { phys = ra_res.reg_map[loc_idx]; }
        if phys == 0 {
            let disp = loc_idx * 8;
            bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xC7); bb_write_u8(cg.code, 0x85);
            bb_write_u32(cg.code, (0 - disp));
            bb_write_u32(cg.code, 0);
        }
        loc_idx = loc_idx + 1;
    }

    let inst = fn_obj.inst_head;
    while inst != nil {
        if inst.op == IR_OP_CONST_INT {
            let phys = 0;
            if ra_res != nil && inst.dest < ra_res.max_local + 64 { phys = ra_res.reg_map[inst.dest]; }
            if phys > 0 {
                if inst.int_val == 0 {
                    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x31); bb_write_u8(cg.code, 0xC0);
                } else if inst.int_val >= (0 - 2147483648) && inst.int_val <= 2147483647 {
                    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xC7); bb_write_u8(cg.code, 0xC0);
                    bb_write_u32(cg.code, inst.int_val);
                } else {
                    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xB8);
                    bb_write_u64(cg.code, inst.int_val);
                }
                cg_mov_phys_from_scratch(cg, phys, 0);
            } else {
                let disp = inst.dest * 8;
                if inst.int_val >= (0 - 2147483648) && inst.int_val <= 2147483647 {
                    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xC7); bb_write_u8(cg.code, 0x85);
                    bb_write_u32(cg.code, (0 - disp));
                    bb_write_u32(cg.code, inst.int_val);
                } else {
                    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xB8);
                    bb_write_u64(cg.code, inst.int_val);
                    cg_mov_local_reg(cg, inst.dest, 0, ra_res);
                }
            }
        } else if inst.op == IR_OP_CONST_BOOL {
            let phys = 0;
            if ra_res != nil && inst.dest < ra_res.max_local + 64 { phys = ra_res.reg_map[inst.dest]; }
            if phys > 0 {
                bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xC7); bb_write_u8(cg.code, 0xC0);
                bb_write_u32(cg.code, inst.int_val);
                cg_mov_phys_from_scratch(cg, phys, 0);
            } else {
                let disp = inst.dest * 8;
                bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xC7); bb_write_u8(cg.code, 0x85);
                bb_write_u32(cg.code, (0 - disp));
                bb_write_u32(cg.code, inst.int_val);
            }
        } else if inst.op == IR_OP_CONST_STR {
            bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x8D); bb_write_u8(cg.code, 0x05);
            cg_reloc(cg, inst.str_val, 1);
            cg_mov_local_reg(cg, inst.dest, 0, ra_res);
        } else if inst.op == IR_OP_COPY {
            cg_mov_reg_local(cg, 0, inst.src1, ra_res);
            cg_mov_local_reg(cg, inst.dest, 0, ra_res);
        } else if inst.op == IR_OP_BIN_OP {
            cg_mov_reg_local(cg, 0, inst.src1, ra_res); // RAX
            cg_mov_reg_local(cg, 2, inst.src2, ra_res); // RDX
            if str_eq(inst.str_val, "+") {
                bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x01); bb_write_u8(cg.code, 0xD0);
            } else if str_eq(inst.str_val, "-") {
                bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x29); bb_write_u8(cg.code, 0xD0);
            } else if str_eq(inst.str_val, "*") {
                bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x0F); bb_write_u8(cg.code, 0xAF); bb_write_u8(cg.code, 0xC2);
            } else if str_eq(inst.str_val, "/") {
                cg_mov_reg_local(cg, 3, inst.src2, ra_res); // R10 = src2
                bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x99); // cqo
                bb_write_u8(cg.code, 0x49); bb_write_u8(cg.code, 0xF7); bb_write_u8(cg.code, 0xFA); // idiv r10
            } else if str_eq(inst.str_val, "%") {
                cg_mov_reg_local(cg, 3, inst.src2, ra_res); // R10 = src2
                bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x99); // cqo
                bb_write_u8(cg.code, 0x49); bb_write_u8(cg.code, 0xF7); bb_write_u8(cg.code, 0xFA); // idiv r10
                bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0xD0); // mov rax, rdx
            } else if str_eq(inst.str_val, "&&") {
                bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x21); bb_write_u8(cg.code, 0xD0); // and rax, rdx
            } else if str_eq(inst.str_val, "||") {
                bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x09); bb_write_u8(cg.code, 0xD0); // or rax, rdx
            } else if str_eq(inst.str_val, "==") {
                bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x39); bb_write_u8(cg.code, 0xD0);
                bb_write_u8(cg.code, 0x0F); bb_write_u8(cg.code, 0x94); bb_write_u8(cg.code, 0xC0);
                bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x0F); bb_write_u8(cg.code, 0xB6); bb_write_u8(cg.code, 0xC0);
            } else if str_eq(inst.str_val, "!=") {
                bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x39); bb_write_u8(cg.code, 0xD0);
                bb_write_u8(cg.code, 0x0F); bb_write_u8(cg.code, 0x95); bb_write_u8(cg.code, 0xC0);
                bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x0F); bb_write_u8(cg.code, 0xB6); bb_write_u8(cg.code, 0xC0);
            } else if str_eq(inst.str_val, "<") {
                bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x39); bb_write_u8(cg.code, 0xD0);
                bb_write_u8(cg.code, 0x0F); bb_write_u8(cg.code, 0x9C); bb_write_u8(cg.code, 0xC0);
                bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x0F); bb_write_u8(cg.code, 0xB6); bb_write_u8(cg.code, 0xC0);
            } else if str_eq(inst.str_val, "<=") {
                bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x39); bb_write_u8(cg.code, 0xD0);
                bb_write_u8(cg.code, 0x0F); bb_write_u8(cg.code, 0x9E); bb_write_u8(cg.code, 0xC0);
                bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x0F); bb_write_u8(cg.code, 0xB6); bb_write_u8(cg.code, 0xC0);
            } else if str_eq(inst.str_val, ">") {
                bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x39); bb_write_u8(cg.code, 0xD0);
                bb_write_u8(cg.code, 0x0F); bb_write_u8(cg.code, 0x9F); bb_write_u8(cg.code, 0xC0);
                bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x0F); bb_write_u8(cg.code, 0xB6); bb_write_u8(cg.code, 0xC0);
            } else if str_eq(inst.str_val, ">=") {
                bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x39); bb_write_u8(cg.code, 0xD0);
                bb_write_u8(cg.code, 0x0F); bb_write_u8(cg.code, 0x9D); bb_write_u8(cg.code, 0xC0);
                bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x0F); bb_write_u8(cg.code, 0xB6); bb_write_u8(cg.code, 0xC0);
            }
            cg_mov_local_reg(cg, inst.dest, 0, ra_res);
        } else if inst.op == IR_OP_UN_OP {
            cg_mov_reg_local(cg, 0, inst.src1, ra_res);
            if str_eq(inst.str_val, "-") {
                bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xF7); bb_write_u8(cg.code, 0xD8);
            } else if str_eq(inst.str_val, "!") {
                bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x83); bb_write_u8(cg.code, 0xF8); bb_write_u8(cg.code, 0x00);
                bb_write_u8(cg.code, 0x0F); bb_write_u8(cg.code, 0x94); bb_write_u8(cg.code, 0xC0);
                bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x0F); bb_write_u8(cg.code, 0xB6); bb_write_u8(cg.code, 0xC0);
            }
            cg_mov_local_reg(cg, inst.dest, 0, ra_res);
        } else if inst.op == IR_OP_LOAD {
            cg_mov_reg_local(cg, 3, inst.src1, ra_res);
            // mov rax, [r10 + offset] -> 49 8B 82 disp32
            bb_write_u8(cg.code, 0x49); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x82);
            bb_write_u32(cg.code, inst.offset);
            cg_mov_local_reg(cg, inst.dest, 0, ra_res);
        } else if inst.op == IR_OP_STORE {
            cg_mov_reg_local(cg, 3, inst.dest, ra_res);
            cg_mov_reg_local(cg, 0, inst.src1, ra_res);
            // mov [r10 + offset], rax -> 49 89 82 disp32
            bb_write_u8(cg.code, 0x49); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0x82);
            bb_write_u32(cg.code, inst.offset);
        } else if inst.op == IR_OP_LOAD_INDEX {
            cg_mov_reg_local(cg, 3, inst.src1, ra_res);
            cg_mov_reg_local(cg, 1, inst.src2, ra_res);
            if inst.int_val == 1 {
                // movzx rax, byte ptr [r10 + rcx] -> 49 0F B6 04 0A
                bb_write_u8(cg.code, 0x49); bb_write_u8(cg.code, 0x0F); bb_write_u8(cg.code, 0xB6); bb_write_u8(cg.code, 0x04); bb_write_u8(cg.code, 0x0A);
            } else {
                // mov rax, qword ptr [r10 + rcx*8] -> 49 8B 04 CA
                bb_write_u8(cg.code, 0x49); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x04); bb_write_u8(cg.code, 0xCA);
            }
            cg_mov_local_reg(cg, inst.dest, 0, ra_res);
        } else if inst.op == IR_OP_STORE_INDEX {
            cg_mov_reg_local(cg, 3, inst.dest, ra_res);
            cg_mov_reg_local(cg, 1, inst.src2, ra_res);
            cg_mov_reg_local(cg, 0, inst.src1, ra_res);
            if inst.int_val == 1 {
                // mov byte ptr [r10 + rcx], al -> 41 88 04 0A
                bb_write_u8(cg.code, 0x41); bb_write_u8(cg.code, 0x88); bb_write_u8(cg.code, 0x04); bb_write_u8(cg.code, 0x0A);
            } else {
                // mov qword ptr [r10 + rcx*8], rax -> 49 89 04 CA
                bb_write_u8(cg.code, 0x49); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0x04); bb_write_u8(cg.code, 0xCA);
            }
        } else if inst.op == IR_OP_ALLOC_HEAP {
            if cg_is_linux(cg) {
                bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xC7); bb_write_u8(cg.code, 0xC7);
            } else {
                bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xC7); bb_write_u8(cg.code, 0xC1);
            }
            bb_write_u32(cg.code, inst.offset + 24);
            cg_call_sym(cg, "__gat_alloc_mem");
            bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xC7); bb_write_u8(cg.code, 0x00); bb_write_u32(cg.code, 1);
            bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xC7); bb_write_u8(cg.code, 0x40); bb_write_u8(cg.code, 0x08); bb_write_u32(cg.code, 0);
            bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xC7); bb_write_u8(cg.code, 0x40); bb_write_u8(cg.code, 0x10); bb_write_u32(cg.code, inst.int_val);
            bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x83); bb_write_u8(cg.code, 0xC0); bb_write_u8(cg.code, 0x18);
            cg_mov_local_reg(cg, inst.dest, 0, ra_res);
        } else if inst.op == IR_OP_ALLOC_STACK {
            if cg_is_linux(cg) {
                bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xC7); bb_write_u8(cg.code, 0xC7);
            } else {
                bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xC7); bb_write_u8(cg.code, 0xC1);
            }
            bb_write_u32(cg.code, inst.offset + 8);
            cg_call_sym(cg, "__gat_alloc_mem");
            cg_mov_local_reg(cg, inst.dest, 0, ra_res);
        } else if inst.op == IR_OP_RETAIN {
            if cg_is_linux(cg) {
                cg_mov_reg_local(cg, 6, inst.src1, ra_res);
            } else {
                cg_mov_reg_local(cg, 1, inst.src1, ra_res);
            }
            cg_call_sym(cg, "__gat_retain");
        } else if inst.op == IR_OP_RELEASE {
            if cg_is_linux(cg) {
                cg_mov_reg_local(cg, 6, inst.src1, ra_res);
            } else {
                cg_mov_reg_local(cg, 1, inst.src1, ra_res);
            }
            cg_call_sym(cg, "__gat_release");
        } else if inst.op == IR_OP_WEAK_RETAIN {
            if cg_is_linux(cg) {
                cg_mov_reg_local(cg, 6, inst.src1, ra_res);
            } else {
                cg_mov_reg_local(cg, 1, inst.src1, ra_res);
            }
            cg_call_sym(cg, "__gat_weak_retain");
        } else if inst.op == IR_OP_WEAK_RELEASE {
            if cg_is_linux(cg) {
                cg_mov_reg_local(cg, 6, inst.src1, ra_res);
            } else {
                cg_mov_reg_local(cg, 1, inst.src1, ra_res);
            }
            cg_call_sym(cg, "__gat_weak_release");
        } else if inst.op == IR_OP_CALL {
            if cg_is_linux(cg) {
                if inst.arg_count >= 1 { cg_mov_reg_local(cg, 6, inst.src1, ra_res); }
                if inst.arg_count >= 2 { cg_mov_reg_local(cg, 7, inst.src2, ra_res); }
                if inst.arg_count >= 3 { cg_mov_reg_local(cg, 2, inst.offset, ra_res); }
                if inst.arg_count >= 4 { cg_mov_reg_local(cg, 1, inst.int_val, ra_res); }
                if inst.arg_count >= 5 { cg_mov_reg_local(cg, 4, inst.extra, ra_res); }
            } else {
                if inst.arg_count >= 1 { cg_mov_reg_local(cg, 1, inst.src1, ra_res); }
                if inst.arg_count >= 2 { cg_mov_reg_local(cg, 2, inst.src2, ra_res); }
                if inst.arg_count >= 3 { cg_mov_reg_local(cg, 4, inst.offset, ra_res); }
                if inst.arg_count >= 4 { cg_mov_reg_local(cg, 5, inst.int_val, ra_res); }
                if inst.arg_count >= 5 {
                    cg_mov_reg_local(cg, 0, inst.extra, ra_res);
                    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0x44); bb_write_u8(cg.code, 0x24); bb_write_u8(cg.code, 0x20); // mov [rsp+0x20], rax
                }
            }
            let callee = inst.str_val;
            if str_eq(callee, "read_file") { callee = "__gat_read_file"; }
            else if str_eq(callee, "write_file") { callee = "__gat_write_file"; }
            else if str_eq(callee, "delete_file") { callee = "__gat_delete_file"; }
            else if str_eq(callee, "file_size") { callee = "__gat_file_size"; }
            else if str_eq(callee, "get_pid") { callee = "__gat_get_pid"; }
            else if str_eq(callee, "exit_process") { callee = "__gat_exit_process"; }
            else if str_eq(callee, "exec_cmd") { callee = "__gat_exec_cmd"; }
            else if str_eq(callee, "get_temp_dir") { callee = "__gat_get_temp_dir"; }
            else if str_eq(callee, "alloc_mem") { callee = "__gat_alloc_mem"; }
            else if str_eq(callee, "free_mem") { callee = "__gat_free_mem"; }
            else if str_eq(callee, "str_len") { callee = "__gat_str_len"; }
            else if str_eq(callee, "str_eq") { callee = "__gat_str_eq"; }
            else if str_eq(callee, "str_char") { callee = "__gat_str_char"; }
            else if str_eq(callee, "str_sub") { callee = "__gat_str_sub"; }
            else if str_eq(callee, "str_concat") { callee = "__gat_str_concat"; }
            else if str_eq(callee, "str_from_int") { callee = "__gat_str_from_int"; }
            else if str_eq(callee, "get_cmd_arg") { callee = "__gat_get_cmd_arg"; }
            else if str_eq(callee, "sleep") { callee = "__gat_sleep"; }
            else if str_eq(callee, "strong_retain") { callee = "__gat_retain"; }
            else if str_eq(callee, "strong_release") { callee = "__gat_release"; }
            else if str_eq(callee, "weak_retain") { callee = "__gat_weak_retain"; }
            else if str_eq(callee, "weak_release") { callee = "__gat_weak_release"; }
            else if str_eq(callee, "strong_count") { callee = "__gat_strong_count"; }
            else if str_eq(callee, "weak_count") { callee = "__gat_weak_count"; }
            else if str_eq(callee, "thread_spawn") { callee = "__gat_thread_spawn"; }
            else if str_eq(callee, "thread_join") { callee = "__gat_thread_join"; }
            else if str_eq(callee, "mutex_init") { callee = "__gat_mutex_init"; }
            else if str_eq(callee, "mutex_lock_raw") { callee = "__gat_mutex_lock"; }
            else if str_eq(callee, "mutex_unlock_raw") { callee = "__gat_mutex_unlock"; }
            else if str_eq(callee, "mutex_destroy_raw") { callee = "__gat_mutex_destroy"; }
            cg_call_sym(cg, callee);
            if inst.dest != 0 {
                cg_mov_local_reg(cg, inst.dest, 0, ra_res);
            }
        } else if inst.op == IR_OP_CONST_FN {
            bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x8D); bb_write_u8(cg.code, 0x05);
            cg_reloc(cg, inst.str_val, 1);
            if inst.dest != 0 {
                cg_mov_local_reg(cg, inst.dest, 0, ra_res);
            }
        } else if inst.op == IR_OP_CALL_INDIRECT {
            cg_mov_reg_local(cg, 3, inst.src1, ra_res);
            if cg_is_linux(cg) {
                if inst.arg_count >= 1 { cg_mov_reg_local(cg, 6, inst.src2, ra_res); }
                if inst.arg_count >= 2 { cg_mov_reg_local(cg, 7, inst.offset, ra_res); }
                if inst.arg_count >= 3 { cg_mov_reg_local(cg, 2, inst.int_val, ra_res); }
                if inst.arg_count >= 4 { cg_mov_reg_local(cg, 1, inst.extra, ra_res); }
            } else {
                if inst.arg_count >= 1 { cg_mov_reg_local(cg, 1, inst.src2, ra_res); }
                if inst.arg_count >= 2 { cg_mov_reg_local(cg, 2, inst.offset, ra_res); }
                if inst.arg_count >= 3 { cg_mov_reg_local(cg, 4, inst.int_val, ra_res); }
                if inst.arg_count >= 4 { cg_mov_reg_local(cg, 5, inst.extra, ra_res); }
            }
            bb_write_u8(cg.code, 0x41); bb_write_u8(cg.code, 0xFF); bb_write_u8(cg.code, 0xD2);
            if inst.dest != 0 {
                cg_mov_local_reg(cg, inst.dest, 0, ra_res);
            }
        } else if inst.op == IR_OP_PRINT {
            if cg_is_linux(cg) {
                cg_mov_reg_local(cg, 6, inst.src1, ra_res);
            } else {
                cg_mov_reg_local(cg, 1, inst.src1, ra_res);
            }
            if inst.type_kind == TYPE_STRING {
                cg_call_sym(cg, "__gat_print_str");
            } else if inst.type_kind == TYPE_BOOL {
                cg_call_sym(cg, "__gat_print_bool");
            } else {
                cg_call_sym(cg, "__gat_print_i64");
            }
        } else if inst.op == IR_OP_RETURN {
            cg_mov_reg_local(cg, 0, inst.src1, ra_res);
            cg_emit_epilogue(cg, ra_res);
        } else if inst.op == IR_OP_LABEL {
            cg_define_sym(cg, inst.label);
        } else if inst.op == IR_OP_JUMP {
            bb_write_u8(cg.code, 0xE9);
            cg_reloc(cg, inst.label, 1);
        } else if inst.op == IR_OP_BRANCH {
            cg_mov_reg_local(cg, 0, inst.src1, ra_res);
            bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x85); bb_write_u8(cg.code, 0xC0);
            bb_write_u8(cg.code, 0x0F); bb_write_u8(cg.code, 0x84);
            cg_reloc(cg, inst.label, 1);
        }
        inst = inst.next;
    }

    // Default epilogue: mov rsp, rbp; [pop callee-saved regs]; pop rbp; ret
    cg_emit_epilogue(cg, ra_res);
    ra_free_result(ra_res);
}

// ----------------------------------------------------------------------------
