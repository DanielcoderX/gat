let AST_IMPORT_DECL: i64 = 18;
let AST_INT_LIT: i64 = 20;
let AST_STR_LIT: i64 = 21;
let AST_BOOL_LIT: i64 = 22;
let AST_IDENT: i64 = 23;
let AST_BIN_OP: i64 = 24;
let AST_UN_OP: i64 = 25;
let AST_CALL: i64 = 26;
let AST_PRINT: i64 = 27;
let AST_MEMBER: i64 = 28;
let AST_INDEX: i64 = 29;
