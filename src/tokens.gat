// ----------------------------------------------------------------------------
// 1. Constants
// ----------------------------------------------------------------------------

// Token Kinds
let TOK_EOF: i64 = 0;
let TOK_IDENT: i64 = 1;
let TOK_INT: i64 = 2;
let TOK_STRING: i64 = 3;
let TOK_BOOL: i64 = 4;
let TOK_FN: i64 = 10;
let TOK_LET: i64 = 11;
let TOK_STRUCT: i64 = 12;
let TOK_CLASS: i64 = 13;
let TOK_DEINIT: i64 = 14;
let TOK_RETURN: i64 = 15;
let TOK_IF: i64 = 16;
let TOK_ELSE: i64 = 17;
let TOK_WHILE: i64 = 18;
let TOK_NEW: i64 = 19;
let TOK_RAW: i64 = 20;
let TOK_PRINT: i64 = 21;
let TOK_TRUE: i64 = 22;
let TOK_FALSE: i64 = 23;
let TOK_IMPORT: i64 = 24;
let TOK_PLUS: i64 = 30;
let TOK_MINUS: i64 = 31;
let TOK_STAR: i64 = 32;
let TOK_SLASH: i64 = 33;
let TOK_PERCENT: i64 = 34;
let TOK_EQ: i64 = 35;
let TOK_NOT_EQ: i64 = 36;
let TOK_LT: i64 = 37;
let TOK_LTE: i64 = 38;
let TOK_GT: i64 = 39;
let TOK_GTE: i64 = 40;
let TOK_AND: i64 = 41;
let TOK_OR: i64 = 42;
let TOK_BANG: i64 = 43;
let TOK_ASSIGN: i64 = 44;
let TOK_DOT: i64 = 45;
let TOK_COMMA: i64 = 46;
let TOK_COLON: i64 = 47;
let TOK_SEMICOLON: i64 = 48;
let TOK_LPAREN: i64 = 49;
let TOK_RPAREN: i64 = 50;
let TOK_LBRACE: i64 = 51;
let TOK_RBRACE: i64 = 52;
let TOK_LBRACKET: i64 = 53;
let TOK_RBRACKET: i64 = 54;
let TOK_ARROW: i64 = 55;
let TOK_ENUM: i64 = 56;
let TOK_MATCH: i64 = 57;
let TOK_FAT_ARROW: i64 = 58;
let TOK_FOR: i64 = 59;
let TOK_IN: i64 = 60;
let TOK_DOTDOT: i64 = 61;

fn token_kind_name(kind: i64) -> string {
    if kind == TOK_EOF { return "end of file"; }
    if kind == TOK_IDENT { return "identifier"; }
    if kind == TOK_INT { return "integer"; }
    if kind == TOK_STRING { return "string"; }
    if kind == TOK_BOOL { return "boolean"; }
    if kind == TOK_FN { return "fn"; }
    if kind == TOK_LET { return "let"; }
    if kind == TOK_STRUCT { return "struct"; }
    if kind == TOK_CLASS { return "class"; }
    if kind == TOK_DEINIT { return "deinit"; }
    if kind == TOK_RETURN { return "return"; }
    if kind == TOK_IF { return "if"; }
    if kind == TOK_ELSE { return "else"; }
    if kind == TOK_WHILE { return "while"; }
    if kind == TOK_NEW { return "new"; }
    if kind == TOK_RAW { return "raw"; }
    if kind == TOK_PRINT { return "print"; }
    if kind == TOK_TRUE { return "true"; }
    if kind == TOK_FALSE { return "false"; }
    if kind == TOK_IMPORT { return "import"; }
    if kind == TOK_ENUM { return "enum"; }
    if kind == TOK_MATCH { return "match"; }
    if kind == TOK_FOR { return "for"; }
    if kind == TOK_IN { return "in"; }
    if kind == TOK_DOTDOT { return ".."; }
    if kind == TOK_PLUS { return "+"; }
    if kind == TOK_MINUS { return "-"; }
    if kind == TOK_STAR { return "*"; }
    if kind == TOK_SLASH { return "/"; }
    if kind == TOK_PERCENT { return "%"; }
    if kind == TOK_EQ { return "=="; }
    if kind == TOK_NOT_EQ { return "!="; }
    if kind == TOK_LT { return "<"; }
    if kind == TOK_LTE { return "<="; }
    if kind == TOK_GT { return ">"; }
    if kind == TOK_GTE { return ">="; }
    if kind == TOK_AND { return "&&"; }
    if kind == TOK_OR { return "||"; }
    if kind == TOK_BANG { return "!"; }
    if kind == TOK_ASSIGN { return "="; }
    if kind == TOK_DOT { return "."; }
    if kind == TOK_COMMA { return ","; }
    if kind == TOK_COLON { return ":"; }
    if kind == TOK_SEMICOLON { return ";"; }
    if kind == TOK_LPAREN { return "("; }
    if kind == TOK_RPAREN { return ")"; }
    if kind == TOK_LBRACE { return "{"; }
    if kind == TOK_RBRACE { return "}"; }
    if kind == TOK_LBRACKET { return "["; }
    if kind == TOK_RBRACKET { return "]"; }
    if kind == TOK_ARROW { return "->"; }
    if kind == TOK_FAT_ARROW { return "=>"; }
    return "unknown token";
}

