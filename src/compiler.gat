// ============================================================================
// gatc-v1: Self-Hosted Gat Bootstrap Compiler (written in gat-min)
// ============================================================================

// ----------------------------------------------------------------------------
// 1. Constants
// ----------------------------------------------------------------------------

// Token Kinds
let TOK_EOF: i64 = 0;
let TOK_IDENT: i64 = 1;
let TOK_INT: i64 = 2;
let TOK_STRING: i64 = 3;
let TOK_BOOL: i64 = 4;
let TOK_FN: i64 = 10;
let TOK_LET: i64 = 11;
let TOK_STRUCT: i64 = 12;
let TOK_CLASS: i64 = 13;
let TOK_DEINIT: i64 = 14;
let TOK_RETURN: i64 = 15;
let TOK_IF: i64 = 16;
let TOK_ELSE: i64 = 17;
let TOK_WHILE: i64 = 18;
let TOK_NEW: i64 = 19;
let TOK_RAW: i64 = 20;
let TOK_PRINT: i64 = 21;
let TOK_TRUE: i64 = 22;
let TOK_FALSE: i64 = 23;
let TOK_PLUS: i64 = 30;
let TOK_MINUS: i64 = 31;
let TOK_STAR: i64 = 32;
let TOK_SLASH: i64 = 33;
let TOK_PERCENT: i64 = 34;
let TOK_EQ: i64 = 35;
let TOK_NOT_EQ: i64 = 36;
let TOK_LT: i64 = 37;
let TOK_LTE: i64 = 38;
let TOK_GT: i64 = 39;
let TOK_GTE: i64 = 40;
let TOK_AND: i64 = 41;
let TOK_OR: i64 = 42;
let TOK_BANG: i64 = 43;
let TOK_ASSIGN: i64 = 44;
let TOK_DOT: i64 = 45;
let TOK_COMMA: i64 = 46;
let TOK_COLON: i64 = 47;
let TOK_SEMICOLON: i64 = 48;
let TOK_LPAREN: i64 = 49;
let TOK_RPAREN: i64 = 50;
let TOK_LBRACE: i64 = 51;
let TOK_RBRACE: i64 = 52;
let TOK_LBRACKET: i64 = 53;
let TOK_RBRACKET: i64 = 54;
let TOK_ARROW: i64 = 55;
let TOK_ENUM: i64 = 56;
let TOK_MATCH: i64 = 57;
let TOK_FAT_ARROW: i64 = 58;

// AST Node Kinds
let AST_PROGRAM: i64 = 1;
let AST_FN_DECL: i64 = 2;
let AST_PARAM: i64 = 3;
let AST_BLOCK: i64 = 4;
let AST_LET_STMT: i64 = 5;
let AST_ASSIGN_STMT: i64 = 6;
let AST_RETURN_STMT: i64 = 7;
let AST_IF_STMT: i64 = 8;
let AST_WHILE_STMT: i64 = 9;
let AST_EXPR_STMT: i64 = 10;
let AST_STRUCT_DECL: i64 = 11;
let AST_CLASS_DECL: i64 = 12;
let AST_FIELD_DECL: i64 = 13;
let AST_ENUM_DECL: i64 = 14;
let AST_ENUM_VARIANT: i64 = 15;
let AST_MATCH_STMT: i64 = 16;
let AST_MATCH_ARM: i64 = 17;
let AST_INT_LIT: i64 = 20;
let AST_STR_LIT: i64 = 21;
let AST_BOOL_LIT: i64 = 22;
let AST_IDENT: i64 = 23;
let AST_BIN_OP: i64 = 24;
let AST_UN_OP: i64 = 25;
let AST_CALL: i64 = 26;
let AST_PRINT: i64 = 27;
let AST_MEMBER: i64 = 28;
let AST_INDEX: i64 = 29;
let AST_NEW: i64 = 30;
let AST_FIELD_INIT: i64 = 31;
let AST_ARRAY_LIT: i64 = 32;

// IR Opcode Kinds
let IR_OP_ALLOC_HEAP: i64 = 1;
let IR_OP_ALLOC_STACK: i64 = 2;
let IR_OP_LOAD: i64 = 3;
let IR_OP_STORE: i64 = 4;
let IR_OP_LOAD_INDEX: i64 = 5;
let IR_OP_STORE_INDEX: i64 = 6;
let IR_OP_COPY: i64 = 7;
let IR_OP_CONST_INT: i64 = 8;
let IR_OP_CONST_STR: i64 = 9;
let IR_OP_CONST_BOOL: i64 = 10;
let IR_OP_BIN_OP: i64 = 11;
let IR_OP_UN_OP: i64 = 12;
let IR_OP_CALL: i64 = 13;
let IR_OP_PRINT: i64 = 14;
let IR_OP_RETAIN: i64 = 15;
let IR_OP_RELEASE: i64 = 16;
let IR_OP_RETURN: i64 = 17;
let IR_OP_BRANCH: i64 = 18;
let IR_OP_JUMP: i64 = 19;
let IR_OP_LABEL: i64 = 20;

// Type Kinds
let TYPE_VOID: i64 = 0;
let TYPE_INT: i64 = 1;
let TYPE_BOOL: i64 = 2;
let TYPE_STRING: i64 = 3;
let TYPE_STRUCT: i64 = 4;
let TYPE_CLASS: i64 = 5;
let TYPE_RAW: i64 = 6;

// ----------------------------------------------------------------------------
// 2. Data Structures
// ----------------------------------------------------------------------------

class Token {
    kind: i64;
    lit: string;
    val_i64: i64;
    line: i64;
    col: i64;
    next: Token;
}

class Lexer {
    input: string;
    len: i64;
    pos: i64;
    read_pos: i64;
    ch: i64;
    line: i64;
    col: i64;
}

class ASTNode {
    kind: i64;
    str_val: string;
    int_val: i64;
    type_name: string;
    type_kind: i64;
    left: ASTNode;
    right: ASTNode;
    child: ASTNode;
    next: ASTNode;
}

class Parser {
    lex: Lexer;
    cur_tok: Token;
    peek_tok: Token;
}

class Symbol {
    name: string;
    type_kind: i64;
    type_name: string;
    is_ref: i64;
    size: i64;
    offset: i64;
    next: Symbol;
}

class TypeInfo {
    name: string;
    kind: i64;
    size: i64;
    is_ref: i64;
    type_id: i64;
    fields: Symbol;
    deinit_fn: string;
    next: TypeInfo;
}

class IRInst {
    op: i64;
    dest: i64;
    src1: i64;
    src2: i64;
    offset: i64;
    int_val: i64;
    extra: i64;
    str_val: string;
    label: string;
    type_kind: i64;
    type_is_ref: i64;
    arg_count: i64;
    next: IRInst;
}

class IRFunc {
    name: string;
    inst_head: IRInst;
    inst_tail: IRInst;
    next: IRFunc;
    max_local: i64;
    param_count: i64;
}

class StringConst {
    label: string;
    val: string;
    rdata_offset: i64;
    next: StringConst;
}

class ByteBuffer {
    data: raw i8;
    size: i64;
    cap: i64;
}

class Reloc {
    offset: i64;
    sym: string;
    kind: i64; // 1 = RIP relative, 2 = IAT relative
    next: Reloc;
}

class SymOffset {
    name: string;
    offset: i64;
    next: SymOffset;
}

// ----------------------------------------------------------------------------
// 3. Byte Buffer Helpers
// ----------------------------------------------------------------------------

fn bb_new(initial_cap: i64) -> ByteBuffer {
    let buf = new ByteBuffer {
        data: alloc_mem(initial_cap),
        size: 0,
        cap: initial_cap
    };
    return buf;
}

fn bb_grow(bb: ByteBuffer, needed: i64) {
    if bb.size + needed <= bb.cap {
        return;
    }
    let new_cap = bb.cap * 2;
    if new_cap < bb.size + needed {
        new_cap = bb.size + needed + 1024;
    }
    let new_data = alloc_mem(new_cap);
    let i = 0;
    while i < bb.size {
        new_data[i] = bb.data[i];
        i = i + 1;
    }
    free_mem(bb.data);
    bb.data = new_data;
    bb.cap = new_cap;
}

fn bb_write_u8(bb: ByteBuffer, b: i64) {
    let u = b;
    if u < 0 {
        u = u + 256;
    }
    bb_grow(bb, 1);
    bb.data[bb.size] = u;
    bb.size = bb.size + 1;
}

fn bb_write_u16(bb: ByteBuffer, w: i64) {
    let u = w;
    if u < 0 {
        u = u + 65536;
    }
    bb_grow(bb, 2);
    bb.data[bb.size] = u;
    bb.data[bb.size + 1] = u / 256;
    bb.size = bb.size + 2;
}

fn bb_write_u32(bb: ByteBuffer, dw: i64) {
    let u = dw;
    if u < 0 {
        u = u + 65536 * 65536;
    }
    bb_grow(bb, 4);
    bb.data[bb.size] = u;
    bb.data[bb.size + 1] = u / 256;
    bb.data[bb.size + 2] = u / 65536;
    bb.data[bb.size + 3] = (u / 65536) / 256;
    bb.size = bb.size + 4;
}

fn bb_write_u64(bb: ByteBuffer, qw: i64) {
    let lo = qw;
    if lo < 0 {
        lo = lo + 65536 * 65536;
    }
    bb_write_u32(bb, lo);
    let hi = qw / 65536 / 65536;
    if hi < 0 {
        hi = hi + 65536 * 65536;
    }
    bb_write_u32(bb, hi);
}

fn bb_write_bytes(bb: ByteBuffer, src: raw i8, count: i64) {
    bb_grow(bb, count);
    let i = 0;
    while i < count {
        bb.data[bb.size + i] = src[i];
        i = i + 1;
    }
    bb.size = bb.size + count;
}

fn bb_write_str(bb: ByteBuffer, s: string) {
    let len = str_len(s);
    bb_grow(bb, len);
    let i = 0;
    while i < len {
        bb.data[bb.size + i] = str_char(s, i);
        i = i + 1;
    }
    bb.size = bb.size + len;
}

fn bb_write_zeros(bb: ByteBuffer, count: i64) {
    bb_grow(bb, count);
    let i = 0;
    while i < count {
        bb.data[bb.size + i] = 0;
        i = i + 1;
    }
    bb.size = bb.size + count;
}

fn bb_align_up(bb: ByteBuffer, align: i64) {
    let rem = bb.size % align;
    if rem != 0 {
        bb_write_zeros(bb, align - rem);
    }
}

fn align_val(val: i64, align: i64) -> i64 {
    let rem = val % align;
    if rem == 0 {
        return val;
    }
    return val + (align - rem);
}

// ----------------------------------------------------------------------------
// 4. Lexer Implementation
// ----------------------------------------------------------------------------

fn lexer_new(input: string) -> Lexer {
    let l = new Lexer {
        input: input,
        len: str_len(input),
        pos: 0,
        read_pos: 0,
        ch: 0,
        line: 1,
        col: 0
    };
    lexer_read_char(l);
    return l;
}

fn lexer_read_char(l: Lexer) {
    if l.read_pos >= l.len {
        l.ch = 0;
    } else {
        l.ch = str_char(l.input, l.read_pos);
    }
    l.pos = l.read_pos;
    l.read_pos = l.read_pos + 1;
    l.col = l.col + 1;
}

fn lexer_peek_char(l: Lexer) -> i64 {
    if l.read_pos >= l.len {
        return 0;
    }
    return str_char(l.input, l.read_pos);
}

fn is_letter(ch: i64) -> bool {
    if (ch >= 65 && ch <= 90) || (ch >= 97 && ch <= 122) || ch == 95 {
        return true;
    }
    return false;
}

fn is_digit(ch: i64) -> bool {
    if ch >= 48 && ch <= 57 {
        return true;
    }
    return false;
}

fn is_hex_digit(ch: i64) -> bool {
    if is_digit(ch) || (ch >= 65 && ch <= 70) || (ch >= 97 && ch <= 102) {
        return true;
    }
    return false;
}

fn lexer_skip_whitespace(l: Lexer) {
    while l.ch == 32 || l.ch == 9 || l.ch == 10 || l.ch == 13 || l.ch == 47 {
        if l.ch == 10 {
            l.line = l.line + 1;
            l.col = 0;
            lexer_read_char(l);
        } else if l.ch == 47 {
            let next_ch = lexer_peek_char(l);
            if next_ch == 47 {
                // Line comment //
                while l.ch != 10 && l.ch != 0 {
                    lexer_read_char(l);
                }
            } else if next_ch == 42 {
                // Block comment /* ... */
                lexer_read_char(l);
                lexer_read_char(l);
                let inside = true;
                while inside && l.ch != 0 {
                    if l.ch == 10 {
                        l.line = l.line + 1;
                        l.col = 0;
                    }
                    if l.ch == 42 && lexer_peek_char(l) == 47 {
                        inside = false;
                        lexer_read_char(l);
                        lexer_read_char(l);
                    } else {
                        lexer_read_char(l);
                    }
                }
            } else {
                return;
            }
        } else {
            lexer_read_char(l);
        }
    }
}

fn lookup_keyword(ident: string) -> i64 {
    if str_eq(ident, "fn") { return TOK_FN; }
    if str_eq(ident, "let") { return TOK_LET; }
    if str_eq(ident, "struct") { return TOK_STRUCT; }
    if str_eq(ident, "class") { return TOK_CLASS; }
    if str_eq(ident, "enum") { return TOK_ENUM; }
    if str_eq(ident, "match") { return TOK_MATCH; }
    if str_eq(ident, "deinit") { return TOK_DEINIT; }
    if str_eq(ident, "return") { return TOK_RETURN; }
    if str_eq(ident, "if") { return TOK_IF; }
    if str_eq(ident, "else") { return TOK_ELSE; }
    if str_eq(ident, "while") { return TOK_WHILE; }
    if str_eq(ident, "new") { return TOK_NEW; }
    if str_eq(ident, "raw") { return TOK_RAW; }
    if str_eq(ident, "print") { return TOK_PRINT; }
    if str_eq(ident, "true") { return TOK_TRUE; }
    if str_eq(ident, "false") { return TOK_FALSE; }
    return TOK_IDENT;
}

fn lexer_next_token(l: Lexer) -> Token {
    lexer_skip_whitespace(l);

    let tok = new Token {
        kind: TOK_EOF,
        lit: "",
        val_i64: 0,
        line: l.line,
        col: l.col,
        next: nil
    };

    if l.ch == 0 {
        return tok;
    }

    if l.ch == 43 { tok.kind = TOK_PLUS; tok.lit = "+"; lexer_read_char(l); return tok; }
    if l.ch == 45 {
        if lexer_peek_char(l) == 62 {
            lexer_read_char(l);
            lexer_read_char(l);
            tok.kind = TOK_ARROW;
            tok.lit = "->";
            return tok;
        }
        tok.kind = TOK_MINUS; tok.lit = "-"; lexer_read_char(l); return tok;
    }
    if l.ch == 42 { tok.kind = TOK_STAR; tok.lit = "*"; lexer_read_char(l); return tok; }
    if l.ch == 47 { tok.kind = TOK_SLASH; tok.lit = "/"; lexer_read_char(l); return tok; }
    if l.ch == 37 { tok.kind = TOK_PERCENT; tok.lit = "%"; lexer_read_char(l); return tok; }
    if l.ch == 46 { tok.kind = TOK_DOT; tok.lit = "."; lexer_read_char(l); return tok; }
    if l.ch == 44 { tok.kind = TOK_COMMA; tok.lit = ","; lexer_read_char(l); return tok; }
    if l.ch == 58 { tok.kind = TOK_COLON; tok.lit = ":"; lexer_read_char(l); return tok; }
    if l.ch == 59 { tok.kind = TOK_SEMICOLON; tok.lit = ";"; lexer_read_char(l); return tok; }
    if l.ch == 40 { tok.kind = TOK_LPAREN; tok.lit = "("; lexer_read_char(l); return tok; }
    if l.ch == 41 { tok.kind = TOK_RPAREN; tok.lit = ")"; lexer_read_char(l); return tok; }
    if l.ch == 123 { tok.kind = TOK_LBRACE; tok.lit = "{"; lexer_read_char(l); return tok; }
    if l.ch == 125 { tok.kind = TOK_RBRACE; tok.lit = "}"; lexer_read_char(l); return tok; }
    if l.ch == 91 { tok.kind = TOK_LBRACKET; tok.lit = "["; lexer_read_char(l); return tok; }
    if l.ch == 93 { tok.kind = TOK_RBRACKET; tok.lit = "]"; lexer_read_char(l); return tok; }

    if l.ch == 61 {
        if lexer_peek_char(l) == 61 {
            lexer_read_char(l);
            lexer_read_char(l);
            tok.kind = TOK_EQ;
            tok.lit = "==";
            return tok;
        } else if lexer_peek_char(l) == 62 {
            lexer_read_char(l);
            lexer_read_char(l);
            tok.kind = TOK_FAT_ARROW;
            tok.lit = "=>";
            return tok;
        }
        tok.kind = TOK_ASSIGN; tok.lit = "="; lexer_read_char(l); return tok;
    }
    if l.ch == 33 {
        if lexer_peek_char(l) == 61 {
            lexer_read_char(l);
            lexer_read_char(l);
            tok.kind = TOK_NOT_EQ;
            tok.lit = "!=";
            return tok;
        }
        tok.kind = TOK_BANG; tok.lit = "!"; lexer_read_char(l); return tok;
    }
    if l.ch == 60 {
        if lexer_peek_char(l) == 61 {
            lexer_read_char(l);
            lexer_read_char(l);
            tok.kind = TOK_LTE;
            tok.lit = "<=";
            return tok;
        }
        tok.kind = TOK_LT; tok.lit = "<"; lexer_read_char(l); return tok;
    }
    if l.ch == 62 {
        if lexer_peek_char(l) == 61 {
            lexer_read_char(l);
            lexer_read_char(l);
            tok.kind = TOK_GTE;
            tok.lit = ">=";
            return tok;
        }
        tok.kind = TOK_GT; tok.lit = ">"; lexer_read_char(l); return tok;
    }
    if l.ch == 38 && lexer_peek_char(l) == 38 {
        lexer_read_char(l);
        lexer_read_char(l);
        tok.kind = TOK_AND;
        tok.lit = "&&";
        return tok;
    }
    if l.ch == 124 && lexer_peek_char(l) == 124 {
        lexer_read_char(l);
        lexer_read_char(l);
        tok.kind = TOK_OR;
        tok.lit = "||";
        return tok;
    }

    // String literals "..."
    if l.ch == 34 {
        lexer_read_char(l); // skip "
        let buf = bb_new(32);
        while l.ch != 34 && l.ch != 0 {
            if l.ch == 92 {
                lexer_read_char(l);
                if l.ch == 110 { bb_write_u8(buf, 10); }
                else if l.ch == 114 { bb_write_u8(buf, 13); }
                else if l.ch == 116 { bb_write_u8(buf, 9); }
                else if l.ch == 48 { bb_write_u8(buf, 0); }
                else if l.ch == 34 { bb_write_u8(buf, 34); }
                else if l.ch == 92 { bb_write_u8(buf, 92); }
                else { bb_write_u8(buf, l.ch); }
            } else {
                if l.ch == 10 {
                    l.line = l.line + 1;
                    l.col = 0;
                }
                bb_write_u8(buf, l.ch);
            }
            lexer_read_char(l);
        }
        if l.ch == 34 {
            lexer_read_char(l);
        }
        bb_write_u8(buf, 0);
        tok.kind = TOK_STRING;
        tok.lit = str_sub(buf.data, 0, buf.size - 1);
        free_mem(buf.data);
        return tok;
    }

    // Char literals '...'
    if l.ch == 39 {
        lexer_read_char(l);
        let ch_val = 0;
        if l.ch == 92 {
            lexer_read_char(l);
            if l.ch == 110 { ch_val = 10; }
            else if l.ch == 114 { ch_val = 13; }
            else if l.ch == 116 { ch_val = 9; }
            else if l.ch == 48 { ch_val = 0; }
            else if l.ch == 39 { ch_val = 39; }
            else if l.ch == 92 { ch_val = 92; }
            else { ch_val = l.ch; }
        } else {
            ch_val = l.ch;
        }
        lexer_read_char(l);
        if l.ch == 39 {
            lexer_read_char(l);
        }
        tok.kind = TOK_INT;
        tok.val_i64 = ch_val;
        tok.lit = str_from_int(ch_val);
        return tok;
    }

    // Number literals (Decimal or Hex)
    if is_digit(l.ch) {
        let num: i64 = 0;
        if l.ch == 48 && (lexer_peek_char(l) == 120 || lexer_peek_char(l) == 88) {
            lexer_read_char(l); // '0'
            lexer_read_char(l); // 'x'
            while is_hex_digit(l.ch) {
                let digit_val: i64 = 0;
                if l.ch >= 48 && l.ch <= 57 { digit_val = l.ch - 48; }
                else if l.ch >= 97 && l.ch <= 102 { digit_val = l.ch - 97 + 10; }
                else if l.ch >= 65 && l.ch <= 70 { digit_val = l.ch - 65 + 10; }
                num = num * 16 + digit_val;
                lexer_read_char(l);
            }
        } else {
            while is_digit(l.ch) {
                num = num * 10 + (l.ch - 48);
                lexer_read_char(l);
            }
        }
        tok.kind = TOK_INT;
        tok.val_i64 = num;
        tok.lit = str_from_int(num);
        return tok;
    }

    // Identifiers & Keywords
    if is_letter(l.ch) {
        let start = l.pos;
        while is_letter(l.ch) || is_digit(l.ch) {
            lexer_read_char(l);
        }
        let len = l.pos - start;
        let ident = str_sub(l.input, start, len);
        tok.lit = ident;
        tok.kind = lookup_keyword(ident);
        if tok.kind == TOK_TRUE {
            tok.val_i64 = 1;
        } else if tok.kind == TOK_FALSE {
            tok.val_i64 = 0;
        }
        return tok;
    }

    lexer_read_char(l);
    return tok;
}

// ----------------------------------------------------------------------------
// 5. Parser Implementation
// ----------------------------------------------------------------------------

fn parser_new(lex: Lexer) -> Parser {
    let p = new Parser {
        lex: lex,
        cur_tok: nil,
        peek_tok: nil
    };
    parser_next_token(p);
    parser_next_token(p);
    return p;
}

fn parser_next_token(p: Parser) {
    p.cur_tok = p.peek_tok;
    p.peek_tok = lexer_next_token(p.lex);
}

fn parser_cur_is(p: Parser, kind: i64) -> bool {
    if p.cur_tok == nil { return false; }
    return p.cur_tok.kind == kind;
}

fn parser_peek_is(p: Parser, kind: i64) -> bool {
    if p.peek_tok == nil { return false; }
    return p.peek_tok.kind == kind;
}

fn parser_expect_peek(p: Parser, kind: i64) -> bool {
    if parser_peek_is(p, kind) {
        parser_next_token(p);
        return true;
    }
    print("[Error] line ", p.peek_tok.line, ": expected token kind ", kind, ", got ", p.peek_tok.kind, "\n");
    return false;
}

// Precedence Table
let PREC_LOWEST: i64 = 1;
let PREC_OR: i64 = 2;
let PREC_AND: i64 = 3;
let PREC_EQUALS: i64 = 4;
let PREC_LESSGREATER: i64 = 5;
let PREC_SUM: i64 = 6;
let PREC_PRODUCT: i64 = 7;
let PREC_PREFIX: i64 = 8;
let PREC_CALL: i64 = 9;
let PREC_INDEX: i64 = 10;
let PREC_MEMBER: i64 = 11;

fn get_precedence(kind: i64) -> i64 {
    if kind == TOK_OR { return PREC_OR; }
    if kind == TOK_AND { return PREC_AND; }
    if kind == TOK_EQ || kind == TOK_NOT_EQ { return PREC_EQUALS; }
    if kind == TOK_LT || kind == TOK_LTE || kind == TOK_GT || kind == TOK_GTE { return PREC_LESSGREATER; }
    if kind == TOK_PLUS || kind == TOK_MINUS { return PREC_SUM; }
    if kind == TOK_SLASH || kind == TOK_STAR || kind == TOK_PERCENT { return PREC_PRODUCT; }
    if kind == TOK_LPAREN { return PREC_CALL; }
    if kind == TOK_LBRACKET { return PREC_INDEX; }
    if kind == TOK_DOT { return PREC_MEMBER; }
    return PREC_LOWEST;
}

fn parse_type_name(p: Parser) -> string {
    if parser_cur_is(p, TOK_RAW) {
        parser_next_token(p);
        return str_concat("raw ", p.cur_tok.lit);
    }
    return p.cur_tok.lit;
}

fn parse_expression(p: Parser, prec: i64) -> ASTNode {
    let left: ASTNode = nil;

    // Prefix rules
    if parser_cur_is(p, TOK_INT) {
        left = new ASTNode {
            kind: AST_INT_LIT,
            int_val: p.cur_tok.val_i64,
            str_val: p.cur_tok.lit,
            type_kind: TYPE_INT,
            type_name: "i64",
            left: nil, right: nil, child: nil, next: nil
        };
    } else if parser_cur_is(p, TOK_STRING) {
        left = new ASTNode {
            kind: AST_STR_LIT,
            str_val: p.cur_tok.lit,
            type_kind: TYPE_STRING,
            type_name: "string",
            left: nil, right: nil, child: nil, next: nil
        };
    } else if parser_cur_is(p, TOK_TRUE) || parser_cur_is(p, TOK_FALSE) {
        left = new ASTNode {
            kind: AST_BOOL_LIT,
            int_val: p.cur_tok.val_i64,
            str_val: p.cur_tok.lit,
            type_kind: TYPE_BOOL,
            type_name: "bool",
            left: nil, right: nil, child: nil, next: nil
        };
    } else if parser_cur_is(p, TOK_IDENT) {
        left = new ASTNode {
            kind: AST_IDENT,
            str_val: p.cur_tok.lit,
            left: nil, right: nil, child: nil, next: nil
        };
    } else if parser_cur_is(p, TOK_LBRACKET) {
        let head_elem: ASTNode = nil;
        let tail_elem: ASTNode = nil;
        if !parser_peek_is(p, TOK_RBRACKET) {
            parser_next_token(p);
            let e_node = parse_expression(p, PREC_LOWEST);
            head_elem = e_node;
            tail_elem = e_node;
            while parser_peek_is(p, TOK_COMMA) {
                parser_next_token(p);
                parser_next_token(p);
                let e_node2 = parse_expression(p, PREC_LOWEST);
                tail_elem.next = e_node2;
                tail_elem = e_node2;
            }
        }
        if !parser_expect_peek(p, TOK_RBRACKET) { return nil; }
        left = new ASTNode {
            kind: AST_ARRAY_LIT,
            child: head_elem,
            left: nil, right: nil, next: nil
        };
    } else if parser_cur_is(p, TOK_BANG) || parser_cur_is(p, TOK_MINUS) || parser_cur_is(p, TOK_RAW) {
        let op_str = p.cur_tok.lit;
        parser_next_token(p);
        let right_expr = parse_expression(p, PREC_PREFIX);
        left = new ASTNode {
            kind: AST_UN_OP,
            str_val: op_str,
            left: right_expr,
            right: nil, child: nil, next: nil
        };
    } else if parser_cur_is(p, TOK_LPAREN) {
        parser_next_token(p);
        left = parse_expression(p, PREC_LOWEST);
        if !parser_expect_peek(p, TOK_RPAREN) {
            return nil;
        }
    } else if parser_cur_is(p, TOK_NEW) {
        parser_next_token(p);
        let type_name = p.cur_tok.lit;
        if !parser_expect_peek(p, TOK_LBRACE) { return nil; }
        let head_init: ASTNode = nil;
        let tail_init: ASTNode = nil;
        parser_next_token(p);
        while !parser_cur_is(p, TOK_RBRACE) && !parser_cur_is(p, TOK_EOF) {
            if parser_cur_is(p, TOK_IDENT) {
                let f_name = p.cur_tok.lit;
                if !parser_expect_peek(p, TOK_COLON) { return nil; }
                parser_next_token(p);
                let f_val = parse_expression(p, PREC_LOWEST);
                let init_node = new ASTNode {
                    kind: AST_FIELD_INIT,
                    str_val: f_name,
                    left: f_val,
                    right: nil, child: nil, next: nil
                };
                if head_init == nil {
                    head_init = init_node;
                    tail_init = init_node;
                } else {
                    tail_init.next = init_node;
                    tail_init = init_node;
                }
                if parser_peek_is(p, TOK_COMMA) {
                    parser_next_token(p);
                }
            }
            parser_next_token(p);
        }
        left = new ASTNode {
            kind: AST_NEW,
            type_name: type_name,
            child: head_init,
            left: nil, right: nil, next: nil
        };
    } else if parser_cur_is(p, TOK_PRINT) {
        if !parser_expect_peek(p, TOK_LPAREN) { return nil; }
        let head_arg: ASTNode = nil;
        let tail_arg: ASTNode = nil;
        if !parser_peek_is(p, TOK_RPAREN) {
            parser_next_token(p);
            head_arg = parse_expression(p, PREC_LOWEST);
            tail_arg = head_arg;
            while parser_peek_is(p, TOK_COMMA) {
                parser_next_token(p);
                parser_next_token(p);
                let arg_node = parse_expression(p, PREC_LOWEST);
                tail_arg.next = arg_node;
                tail_arg = arg_node;
            }
        }
        if !parser_expect_peek(p, TOK_RPAREN) { return nil; }
        left = new ASTNode {
            kind: AST_PRINT,
            child: head_arg,
            left: nil, right: nil, next: nil
        };
    }

    // Infix rules
    while !parser_peek_is(p, TOK_SEMICOLON) && prec < get_precedence(p.peek_tok.kind) {
        let peek_kind = p.peek_tok.kind;
        if peek_kind == TOK_PLUS || peek_kind == TOK_MINUS || peek_kind == TOK_STAR ||
           peek_kind == TOK_SLASH || peek_kind == TOK_PERCENT || peek_kind == TOK_EQ ||
           peek_kind == TOK_NOT_EQ || peek_kind == TOK_LT || peek_kind == TOK_LTE ||
           peek_kind == TOK_GT || peek_kind == TOK_GTE || peek_kind == TOK_AND || peek_kind == TOK_OR {
            parser_next_token(p);
            let op_str = p.cur_tok.lit;
            let op_prec = get_precedence(p.cur_tok.kind);
            parser_next_token(p);
            let right_expr = parse_expression(p, op_prec);
            let bin = new ASTNode {
                kind: AST_BIN_OP,
                str_val: op_str,
                left: left,
                right: right_expr,
                child: nil, next: nil
            };
            left = bin;
        } else if peek_kind == TOK_LPAREN {
            parser_next_token(p);
            let callee_name = left.str_val;
            if left.kind == AST_MEMBER {
                callee_name = str_concat(left.left.str_val, str_concat(".", left.str_val));
            }
            let head_arg: ASTNode = nil;
            let tail_arg: ASTNode = nil;
            if !parser_peek_is(p, TOK_RPAREN) {
                parser_next_token(p);
                head_arg = parse_expression(p, PREC_LOWEST);
                tail_arg = head_arg;
                while parser_peek_is(p, TOK_COMMA) {
                    parser_next_token(p);
                    parser_next_token(p);
                    let arg_node = parse_expression(p, PREC_LOWEST);
                    tail_arg.next = arg_node;
                    tail_arg = arg_node;
                }
            }
            if !parser_expect_peek(p, TOK_RPAREN) { return nil; }
            let call = new ASTNode {
                kind: AST_CALL,
                str_val: callee_name,
                child: head_arg,
                left: nil, right: nil, next: nil
            };
            left = call;
        } else if peek_kind == TOK_DOT {
            parser_next_token(p);
            if !parser_expect_peek(p, TOK_IDENT) { return nil; }
            let member_name = p.cur_tok.lit;
            let mem = new ASTNode {
                kind: AST_MEMBER,
                str_val: member_name,
                left: left,
                right: nil, child: nil, next: nil
            };
            left = mem;
        } else if peek_kind == TOK_LBRACKET {
            parser_next_token(p);
            parser_next_token(p);
            let idx_expr = parse_expression(p, PREC_LOWEST);
            if !parser_expect_peek(p, TOK_RBRACKET) { return nil; }
            let idx_node = new ASTNode {
                kind: AST_INDEX,
                left: left,
                right: idx_expr,
                child: nil, next: nil
            };
            left = idx_node;
        } else {
            return left;
        }
    }

    return left;
}

fn parse_block(p: Parser) -> ASTNode {
    if !parser_cur_is(p, TOK_LBRACE) {
        return nil;
    }
    let head_stmt: ASTNode = nil;
    let tail_stmt: ASTNode = nil;
    parser_next_token(p);
    while !parser_cur_is(p, TOK_RBRACE) && !parser_cur_is(p, TOK_EOF) {
        let stmt = parse_statement(p);
        if stmt != nil {
            if head_stmt == nil {
                head_stmt = stmt;
                tail_stmt = stmt;
            } else {
                tail_stmt.next = stmt;
                tail_stmt = stmt;
            }
        }
        parser_next_token(p);
    }
    return new ASTNode {
        kind: AST_BLOCK,
        child: head_stmt,
        left: nil, right: nil, next: nil
    };
}

fn parse_statement(p: Parser) -> ASTNode {
    if parser_cur_is(p, TOK_MATCH) {
        return parse_match_stmt(p);
    }
    if parser_cur_is(p, TOK_LET) {
        if !parser_expect_peek(p, TOK_IDENT) { return nil; }
        let var_name = p.cur_tok.lit;
        let type_name = "";
        if parser_peek_is(p, TOK_COLON) {
            parser_next_token(p);
            parser_next_token(p);
            type_name = parse_type_name(p);
        }
        if !parser_expect_peek(p, TOK_ASSIGN) { return nil; }
        parser_next_token(p);
        let val_expr = parse_expression(p, PREC_LOWEST);
        if parser_peek_is(p, TOK_SEMICOLON) {
            parser_next_token(p);
        }
        return new ASTNode {
            kind: AST_LET_STMT,
            str_val: var_name,
            type_name: type_name,
            left: val_expr,
            right: nil, child: nil, next: nil
        };
    }

    if parser_cur_is(p, TOK_RETURN) {
        let ret_val: ASTNode = nil;
        if !parser_peek_is(p, TOK_SEMICOLON) {
            parser_next_token(p);
            ret_val = parse_expression(p, PREC_LOWEST);
        }
        if parser_peek_is(p, TOK_SEMICOLON) {
            parser_next_token(p);
        }
        return new ASTNode {
            kind: AST_RETURN_STMT,
            left: ret_val,
            right: nil, child: nil, next: nil
        };
    }

    if parser_cur_is(p, TOK_IF) {
        parser_next_token(p);
        let cond_expr = parse_expression(p, PREC_LOWEST);
        if !parser_expect_peek(p, TOK_LBRACE) { return nil; }
        let then_block = parse_block(p);
        let else_block: ASTNode = nil;
        if parser_peek_is(p, TOK_ELSE) {
            parser_next_token(p);
            if parser_peek_is(p, TOK_IF) {
                parser_next_token(p);
                else_block = parse_statement(p);
            } else if parser_peek_is(p, TOK_LBRACE) {
                parser_next_token(p);
                else_block = parse_block(p);
            }
        }
        return new ASTNode {
            kind: AST_IF_STMT,
            left: cond_expr,
            right: then_block,
            child: else_block,
            next: nil
        };
    }

    if parser_cur_is(p, TOK_WHILE) {
        parser_next_token(p);
        let cond_expr = parse_expression(p, PREC_LOWEST);
        if !parser_expect_peek(p, TOK_LBRACE) { return nil; }
        let body_block = parse_block(p);
        return new ASTNode {
            kind: AST_WHILE_STMT,
            left: cond_expr,
            right: body_block,
            child: nil, next: nil
        };
    }

    // Expression statement or Assignment
    let expr = parse_expression(p, PREC_LOWEST);
    if parser_peek_is(p, TOK_ASSIGN) {
        parser_next_token(p);
        parser_next_token(p);
        let rhs = parse_expression(p, PREC_LOWEST);
        if parser_peek_is(p, TOK_SEMICOLON) {
            parser_next_token(p);
        }
        return new ASTNode {
            kind: AST_ASSIGN_STMT,
            left: expr,
            right: rhs,
            child: nil, next: nil
        };
    }

    if parser_peek_is(p, TOK_SEMICOLON) {
        parser_next_token(p);
    }
    return new ASTNode {
        kind: AST_EXPR_STMT,
        left: expr,
        right: nil, child: nil, next: nil
    };
}

fn parse_match_stmt(p: Parser) -> ASTNode {
    parser_next_token(p);
    let target = parse_expression(p, PREC_LOWEST);
    if !parser_expect_peek(p, TOK_LBRACE) { return nil; }
    let head_arm: ASTNode = nil;
    let tail_arm: ASTNode = nil;
    parser_next_token(p);
    while !parser_cur_is(p, TOK_RBRACE) && !parser_cur_is(p, TOK_EOF) {
        if parser_cur_is(p, TOK_IDENT) {
            let first = p.cur_tok.lit;
            let is_wildcard: i64 = 0;
            let enum_name = "";
            let var_name = first;
            if str_eq(first, "_") {
                is_wildcard = 1;
            } else if parser_peek_is(p, TOK_DOT) {
                parser_next_token(p);
                if !parser_expect_peek(p, TOK_IDENT) { return nil; }
                enum_name = first;
                var_name = p.cur_tok.lit;
            }
            let head_bind: ASTNode = nil;
            let tail_bind: ASTNode = nil;
            if is_wildcard == 0 && parser_peek_is(p, TOK_LPAREN) {
                parser_next_token(p);
                if !parser_peek_is(p, TOK_RPAREN) {
                    parser_next_token(p);
                    let b_node = new ASTNode {
                        kind: AST_IDENT,
                        str_val: p.cur_tok.lit,
                        left: nil, right: nil, child: nil, next: nil
                    };
                    head_bind = b_node;
                    tail_bind = b_node;
                    while parser_peek_is(p, TOK_COMMA) {
                        parser_next_token(p);
                        parser_next_token(p);
                        let b_node2 = new ASTNode {
                            kind: AST_IDENT,
                            str_val: p.cur_tok.lit,
                            left: nil, right: nil, child: nil, next: nil
                        };
                        tail_bind.next = b_node2;
                        tail_bind = b_node2;
                    }
                }
                if !parser_expect_peek(p, TOK_RPAREN) { return nil; }
            }
            if !parser_expect_peek(p, TOK_FAT_ARROW) { return nil; }
            if !parser_expect_peek(p, TOK_LBRACE) { return nil; }
            let body = parse_block(p);
            let arm = new ASTNode {
                kind: AST_MATCH_ARM,
                str_val: var_name,
                type_name: enum_name,
                int_val: is_wildcard,
                left: head_bind,
                right: body,
                child: nil, next: nil
            };
            if head_arm == nil {
                head_arm = arm;
                tail_arm = arm;
            } else {
                tail_arm.next = arm;
                tail_arm = arm;
            }
            if parser_peek_is(p, TOK_COMMA) {
                parser_next_token(p);
            }
        }
        parser_next_token(p);
    }
    return new ASTNode {
        kind: AST_MATCH_STMT,
        left: target,
        child: head_arm,
        right: nil, next: nil
    };
}

fn parse_fn_decl(p: Parser) -> ASTNode {
    if !parser_expect_peek(p, TOK_IDENT) { return nil; }
    let fn_name = p.cur_tok.lit;
    if !parser_expect_peek(p, TOK_LPAREN) { return nil; }

    let head_param: ASTNode = nil;
    let tail_param: ASTNode = nil;
    if !parser_peek_is(p, TOK_RPAREN) {
        parser_next_token(p);
        let p_name = p.cur_tok.lit;
        let p_type = "i64";
        if !parser_expect_peek(p, TOK_COLON) { return nil; }
        parser_next_token(p);
        p_type = parse_type_name(p);
        head_param = new ASTNode {
            kind: AST_PARAM,
            str_val: p_name,
            type_name: p_type,
            left: nil, right: nil, child: nil, next: nil
        };
        tail_param = head_param;

        while parser_peek_is(p, TOK_COMMA) {
            parser_next_token(p);
            parser_next_token(p);
            let pn = p.cur_tok.lit;
            if !parser_expect_peek(p, TOK_COLON) { return nil; }
            parser_next_token(p);
            let pt = parse_type_name(p);
            let param_node = new ASTNode {
                kind: AST_PARAM,
                str_val: pn,
                type_name: pt,
                left: nil, right: nil, child: nil, next: nil
            };
            tail_param.next = param_node;
            tail_param = param_node;
        }
    }
    if !parser_expect_peek(p, TOK_RPAREN) { return nil; }

    let ret_type = "void";
    if parser_peek_is(p, TOK_ARROW) {
        parser_next_token(p);
        parser_next_token(p);
        ret_type = parse_type_name(p);
    }

    if !parser_expect_peek(p, TOK_LBRACE) { return nil; }
    let body = parse_block(p);

    return new ASTNode {
        kind: AST_FN_DECL,
        str_val: fn_name,
        type_name: ret_type,
        left: head_param,
        right: body,
        child: nil, next: nil
    };
}

fn parse_struct_or_class(p: Parser, is_class: bool) -> ASTNode {
    if !parser_expect_peek(p, TOK_IDENT) { return nil; }
    let type_name = p.cur_tok.lit;
    if !parser_expect_peek(p, TOK_LBRACE) { return nil; }

    let head_field: ASTNode = nil;
    let tail_field: ASTNode = nil;
    let deinit_block: ASTNode = nil;

    parser_next_token(p);
    while !parser_cur_is(p, TOK_RBRACE) && !parser_cur_is(p, TOK_EOF) {
        if parser_cur_is(p, TOK_DEINIT) {
            if !parser_expect_peek(p, TOK_LBRACE) { return nil; }
            deinit_block = parse_block(p);
        } else if parser_cur_is(p, TOK_IDENT) {
            let f_name = p.cur_tok.lit;
            if !parser_expect_peek(p, TOK_COLON) { return nil; }
            parser_next_token(p);
            let f_type = parse_type_name(p);
            if parser_peek_is(p, TOK_SEMICOLON) {
                parser_next_token(p);
            }
            let field_node = new ASTNode {
                kind: AST_FIELD_DECL,
                str_val: f_name,
                type_name: f_type,
                left: nil, right: nil, child: nil, next: nil
            };
            if head_field == nil {
                head_field = field_node;
                tail_field = field_node;
            } else {
                tail_field.next = field_node;
                tail_field = field_node;
            }
        }
        parser_next_token(p);
    }

    let k = AST_STRUCT_DECL;
    if is_class { k = AST_CLASS_DECL; }

    return new ASTNode {
        kind: k,
        str_val: type_name,
        left: head_field,
        right: deinit_block,
        child: nil, next: nil
    };
}

fn parse_enum_decl(p: Parser) -> ASTNode {
    if !parser_expect_peek(p, TOK_IDENT) { return nil; }
    let enum_name = p.cur_tok.lit;
    if !parser_expect_peek(p, TOK_LBRACE) { return nil; }
    let head_var: ASTNode = nil;
    let tail_var: ASTNode = nil;
    let tag: i64 = 0;
    parser_next_token(p);
    while !parser_cur_is(p, TOK_RBRACE) && !parser_cur_is(p, TOK_EOF) {
        if parser_cur_is(p, TOK_IDENT) {
            let v_name = p.cur_tok.lit;
            let head_param: ASTNode = nil;
            let tail_param: ASTNode = nil;
            if parser_peek_is(p, TOK_LPAREN) {
                parser_next_token(p);
                if !parser_peek_is(p, TOK_RPAREN) {
                    parser_next_token(p);
                    let pt = parse_type_name(p);
                    let param_node = new ASTNode {
                        kind: AST_PARAM,
                        str_val: "",
                        type_name: pt,
                        left: nil, right: nil, child: nil, next: nil
                    };
                    head_param = param_node;
                    tail_param = param_node;
                    while parser_peek_is(p, TOK_COMMA) {
                        parser_next_token(p);
                        parser_next_token(p);
                        let pt2 = parse_type_name(p);
                        let param_node2 = new ASTNode {
                            kind: AST_PARAM,
                            str_val: "",
                            type_name: pt2,
                            left: nil, right: nil, child: nil, next: nil
                        };
                        tail_param.next = param_node2;
                        tail_param = param_node2;
                    }
                }
                if !parser_expect_peek(p, TOK_RPAREN) { return nil; }
            }
            let v_node = new ASTNode {
                kind: AST_ENUM_VARIANT,
                str_val: v_name,
                int_val: tag,
                left: head_param,
                right: nil, child: nil, next: nil
            };
            tag = tag + 1;
            if head_var == nil {
                head_var = v_node;
                tail_var = v_node;
            } else {
                tail_var.next = v_node;
                tail_var = v_node;
            }
            if parser_peek_is(p, TOK_COMMA) || parser_peek_is(p, TOK_SEMICOLON) {
                parser_next_token(p);
            }
        }
        parser_next_token(p);
    }
    return new ASTNode {
        kind: AST_ENUM_DECL,
        str_val: enum_name,
        child: head_var,
        left: nil, right: nil, next: nil
    };
}

fn parse_program(p: Parser) -> ASTNode {
    let head_decl: ASTNode = nil;
    let tail_decl: ASTNode = nil;

    while !parser_cur_is(p, TOK_EOF) {
        let decl: ASTNode = nil;
        if parser_cur_is(p, TOK_FN) {
            decl = parse_fn_decl(p);
        } else if parser_cur_is(p, TOK_STRUCT) {
            decl = parse_struct_or_class(p, false);
        } else if parser_cur_is(p, TOK_CLASS) {
            decl = parse_struct_or_class(p, true);
        } else if parser_cur_is(p, TOK_ENUM) {
            decl = parse_enum_decl(p);
        } else if parser_cur_is(p, TOK_LET) {
            decl = parse_statement(p);
        }
        if decl != nil {
            if head_decl == nil {
                head_decl = decl;
                tail_decl = decl;
            } else {
                tail_decl.next = decl;
                tail_decl = decl;
            }
        }
        parser_next_token(p);
    }

    return new ASTNode {
        kind: AST_PROGRAM,
        child: head_decl,
        left: nil, right: nil, next: nil
    };
}

// ----------------------------------------------------------------------------
// 6. Typechecker & Layout Engine
// ----------------------------------------------------------------------------

class TypeChecker {
    types_head: TypeInfo;
    types_tail: TypeInfo;
    type_id_seq: i64;
    funcs_head: Symbol;
    funcs_tail: Symbol;
}

fn tc_new() -> TypeChecker {
    let tc = new TypeChecker {
        types_head: nil,
        types_tail: nil,
        type_id_seq: 1,
        funcs_head: nil,
        funcs_tail: nil
    };

    tc_add_primitive(tc, "void", TYPE_VOID, 0);
    tc_add_primitive(tc, "i8", TYPE_INT, 1);
    tc_add_primitive(tc, "i64", TYPE_INT, 8);
    tc_add_primitive(tc, "bool", TYPE_BOOL, 8);
    tc_add_primitive(tc, "string", TYPE_STRING, 8);

    return tc;
}

fn tc_add_primitive(tc: TypeChecker, name: string, kind: i64, size: i64) {
    let ti = new TypeInfo {
        name: name,
        kind: kind,
        size: size,
        is_ref: 0,
        type_id: 0,
        fields: nil,
        deinit_fn: "",
        next: nil
    };
    if tc.types_head == nil {
        tc.types_head = ti;
        tc.types_tail = ti;
    } else {
        tc.types_tail.next = ti;
        tc.types_tail = ti;
    }
}

fn tc_find_type(tc: TypeChecker, name: string) -> TypeInfo {
    let t_name = name;
    if str_len(t_name) > 4 {
        if str_eq(str_sub(t_name, 0, 4), "raw ") {
            t_name = str_sub(t_name, 4, str_len(t_name) - 4);
        }
    }
    let cur = tc.types_head;
    while cur != nil {
        if str_eq(cur.name, t_name) {
            return cur;
        }
        cur = cur.next;
    }
    return nil;
}

fn tc_find_func(tc: TypeChecker, name: string) -> Symbol {
    let cur = tc.funcs_head;
    while cur != nil {
        if str_eq(cur.name, name) {
            return cur;
        }
        cur = cur.next;
    }
    return nil;
}

fn tc_register_decl(tc: TypeChecker, decl: ASTNode) {
    if decl == nil { return; }
    if decl.kind == AST_FN_DECL {
        let ret_type = decl.type_name;
        if str_len(ret_type) == 0 {
            ret_type = "i64";
        }
        let fn_sym = new Symbol {
            name: decl.str_val,
            type_kind: TYPE_INT,
            type_name: ret_type,
            is_ref: 0,
            size: 8,
            offset: 0,
            next: nil
        };
        if tc.funcs_head == nil {
            tc.funcs_head = fn_sym;
            tc.funcs_tail = fn_sym;
        } else {
            tc.funcs_tail.next = fn_sym;
            tc.funcs_tail = fn_sym;
        }
        return;
    }

    if decl.kind == AST_STRUCT_DECL || decl.kind == AST_CLASS_DECL {
        let is_ref: i64 = 0;
        let k = TYPE_STRUCT;
        if decl.kind == AST_CLASS_DECL {
            is_ref = 1;
            k = TYPE_CLASS;
        }
        let ti = new TypeInfo {
            name: decl.str_val,
            kind: k,
            size: 0,
            is_ref: is_ref,
            type_id: tc.type_id_seq,
            fields: nil,
            deinit_fn: "",
            next: nil
        };
        tc.type_id_seq = tc.type_id_seq + 1;

        // Layout fields
        let offset: i64 = 0;
        let f = decl.left;
        let head_sym: Symbol = nil;
        let tail_sym: Symbol = nil;
        while f != nil {
            let f_sym = new Symbol {
                name: f.str_val,
                type_name: f.type_name,
                type_kind: TYPE_INT,
                is_ref: 0,
                size: 8,
                offset: offset,
                next: nil
            };
            offset = offset + 8;
            if head_sym == nil {
                head_sym = f_sym;
                tail_sym = f_sym;
            } else {
                tail_sym.next = f_sym;
                tail_sym = f_sym;
            }
            f = f.next;
        }
        ti.fields = head_sym;
        ti.size = offset;

        if tc.types_head == nil {
            tc.types_head = ti;
            tc.types_tail = ti;
        } else {
            tc.types_tail.next = ti;
            tc.types_tail = ti;
        }
        return;
    }

    if decl.kind == AST_ENUM_DECL {
        let ti = new TypeInfo {
            name: decl.str_val,
            kind: TYPE_STRUCT,
            size: 64,
            is_ref: 0,
            type_id: tc.type_id_seq,
            fields: nil,
            deinit_fn: "",
            next: nil
        };
        tc.type_id_seq = tc.type_id_seq + 1;
        let v = decl.child;
        let head_sym: Symbol = nil;
        let tail_sym: Symbol = nil;
        while v != nil {
            let v_sym = new Symbol {
                name: v.str_val,
                type_name: decl.str_val,
                type_kind: TYPE_INT,
                is_ref: 0,
                size: 8,
                offset: v.int_val,
                next: nil
            };
            if head_sym == nil {
                head_sym = v_sym;
                tail_sym = v_sym;
            } else {
                tail_sym.next = v_sym;
                tail_sym = v_sym;
            }
            v = v.next;
        }
        ti.fields = head_sym;
        if tc.types_head == nil {
            tc.types_head = ti;
            tc.types_tail = ti;
        } else {
            tc.types_tail.next = ti;
            tc.types_tail = ti;
        }
        return;
    }
}

fn tc_get_field_offset(ti: TypeInfo, field_name: string) -> i64 {
    if ti == nil { return 0; }
    let f = ti.fields;
    while f != nil {
        if str_eq(f.name, field_name) {
            return f.offset;
        }
        f = f.next;
    }
    return 0;
}

fn tc_get_field_type(ti: TypeInfo, field_name: string) -> string {
    if ti == nil { return ""; }
    let f = ti.fields;
    while f != nil {
        if str_eq(f.name, field_name) {
            return f.type_name;
        }
        f = f.next;
    }
    return "";
}

// ----------------------------------------------------------------------------
// 7. IR Builder & ARC Pass
// ----------------------------------------------------------------------------

class IRContext {
    tc: TypeChecker;
    funcs_head: IRFunc;
    funcs_tail: IRFunc;
    cur_fn: IRFunc;
    val_seq: i64;
    label_seq: i64;
    strings_head: StringConst;
    strings_tail: StringConst;
    string_count: i64;
    locals: Symbol;
}

fn ir_new(tc: TypeChecker) -> IRContext {
    return new IRContext {
        tc: tc,
        funcs_head: nil,
        funcs_tail: nil,
        cur_fn: nil,
        val_seq: 1,
        label_seq: 1,
        strings_head: nil,
        strings_tail: nil,
        string_count: 0,
        locals: nil
    };
}

fn ir_add_string(ctx: IRContext, str: string) -> string {
    let cur = ctx.strings_head;
    while cur != nil {
        if str_eq(cur.val, str) {
            return cur.label;
        }
        cur = cur.next;
    }
    let lbl = str_concat("str_", str_from_int(ctx.string_count));
    ctx.string_count = ctx.string_count + 1;
    let sc = new StringConst {
        label: lbl,
        val: str,
        rdata_offset: 0,
        next: nil
    };
    if ctx.strings_head == nil {
        ctx.strings_head = sc;
        ctx.strings_tail = sc;
    } else {
        ctx.strings_tail.next = sc;
        ctx.strings_tail = sc;
    }
    return lbl;
}

fn ir_new_label(ctx: IRContext, prefix: string) -> string {
    let lbl = str_concat(prefix, str_from_int(ctx.label_seq));
    ctx.label_seq = ctx.label_seq + 1;
    return lbl;
}

fn ir_alloc_val(ctx: IRContext) -> i64 {
    let id = ctx.val_seq;
    ctx.val_seq = ctx.val_seq + 1;
    if id > ctx.cur_fn.max_local {
        ctx.cur_fn.max_local = id;
    }
    return id;
}

fn ir_emit(ctx: IRContext, op: i64, dest: i64, src1: i64) -> IRInst {
    let inst = new IRInst {
        op: op,
        dest: dest,
        src1: src1,
        src2: 0,
        offset: 0,
        int_val: 0,
        extra: 0,
        str_val: "",
        label: "",
        type_kind: TYPE_INT,
        type_is_ref: 0,
        arg_count: 0,
        next: nil
    };
    if ctx.cur_fn.inst_head == nil {
        ctx.cur_fn.inst_head = inst;
        ctx.cur_fn.inst_tail = inst;
    } else {
        ctx.cur_fn.inst_tail.next = inst;
        ctx.cur_fn.inst_tail = inst;
    }
    return inst;
}

fn ir_set_local(ctx: IRContext, name: string, val_id: i64, is_ref: i64, type_name: string) {
    let s = new Symbol {
        name: name,
        type_kind: TYPE_INT,
        type_name: type_name,
        is_ref: is_ref,
        size: 8,
        offset: val_id,
        next: ctx.locals
    };
    ctx.locals = s;
}

fn ir_get_local(ctx: IRContext, name: string) -> Symbol {
    let cur = ctx.locals;
    while cur != nil {
        if str_eq(cur.name, name) {
            return cur;
        }
        cur = cur.next;
    }
    return nil;
}

fn ir_get_expr_type(ctx: IRContext, expr: ASTNode) -> string {
    if expr == nil { return ""; }
    if str_len(expr.type_name) > 0 { return expr.type_name; }
    if expr.kind == AST_IDENT {
        let sym = ir_get_local(ctx, expr.str_val);
        if sym != nil { return sym.type_name; }
    } else if expr.kind == AST_MEMBER {
        let base_type = ir_get_expr_type(ctx, expr.left);
        let ti = tc_find_type(ctx.tc, base_type);
        if ti != nil {
            return tc_get_field_type(ti, expr.str_val);
        }
    } else if expr.kind == AST_NEW {
        return expr.type_name;
    } else if expr.kind == AST_CALL {
        let fs = tc_find_func(ctx.tc, expr.str_val);
        if fs != nil {
            return fs.type_name;
        }
        let callee = expr.str_val;
        if str_eq(callee, "str_concat") || str_eq(callee, "str_sub") ||
           str_eq(callee, "str_from_int") || str_eq(callee, "get_cmd_arg") ||
           str_eq(callee, "read_file") {
            return "string";
        } else if str_eq(callee, "str_eq") {
            return "bool";
        } else if str_eq(callee, "str_len") || str_eq(callee, "str_char") ||
                  str_eq(callee, "alloc_mem") {
            return "i64";
        }
    } else if expr.kind == AST_ARRAY_LIT {
        return "array";
    } else if expr.kind == AST_STR_LIT {
        return "string";
    } else if expr.kind == AST_BOOL_LIT {
        return "bool";
    } else if expr.kind == AST_INT_LIT {
        return "i64";
    }
    return "";
}

fn get_const_val(name: string) -> i64 {
    if str_eq(name, "TOK_EOF") { return 0; }
    if str_eq(name, "TOK_IDENT") { return 1; }
    if str_eq(name, "TOK_INT") { return 2; }
    if str_eq(name, "TOK_STRING") { return 3; }
    if str_eq(name, "TOK_BOOL") { return 4; }
    if str_eq(name, "TOK_FN") { return 10; }
    if str_eq(name, "TOK_LET") { return 11; }
    if str_eq(name, "TOK_STRUCT") { return 12; }
    if str_eq(name, "TOK_CLASS") { return 13; }
    if str_eq(name, "TOK_DEINIT") { return 14; }
    if str_eq(name, "TOK_RETURN") { return 15; }
    if str_eq(name, "TOK_IF") { return 16; }
    if str_eq(name, "TOK_ELSE") { return 17; }
    if str_eq(name, "TOK_WHILE") { return 18; }
    if str_eq(name, "TOK_NEW") { return 19; }
    if str_eq(name, "TOK_RAW") { return 20; }
    if str_eq(name, "TOK_PRINT") { return 21; }
    if str_eq(name, "TOK_TRUE") { return 22; }
    if str_eq(name, "TOK_FALSE") { return 23; }
    if str_eq(name, "TOK_PLUS") { return 30; }
    if str_eq(name, "TOK_MINUS") { return 31; }
    if str_eq(name, "TOK_STAR") { return 32; }
    if str_eq(name, "TOK_SLASH") { return 33; }
    if str_eq(name, "TOK_PERCENT") { return 34; }
    if str_eq(name, "TOK_EQ") { return 35; }
    if str_eq(name, "TOK_NOT_EQ") { return 36; }
    if str_eq(name, "TOK_LT") { return 37; }
    if str_eq(name, "TOK_LTE") { return 38; }
    if str_eq(name, "TOK_GT") { return 39; }
    if str_eq(name, "TOK_GTE") { return 40; }
    if str_eq(name, "TOK_AND") { return 41; }
    if str_eq(name, "TOK_OR") { return 42; }
    if str_eq(name, "TOK_BANG") { return 43; }
    if str_eq(name, "TOK_ASSIGN") { return 44; }
    if str_eq(name, "TOK_DOT") { return 45; }
    if str_eq(name, "TOK_COMMA") { return 46; }
    if str_eq(name, "TOK_COLON") { return 47; }
    if str_eq(name, "TOK_SEMICOLON") { return 48; }
    if str_eq(name, "TOK_LPAREN") { return 49; }
    if str_eq(name, "TOK_RPAREN") { return 50; }
    if str_eq(name, "TOK_LBRACE") { return 51; }
    if str_eq(name, "TOK_RBRACE") { return 52; }
    if str_eq(name, "TOK_LBRACKET") { return 53; }
    if str_eq(name, "TOK_RBRACKET") { return 54; }
    if str_eq(name, "TOK_ARROW") { return 55; }
    if str_eq(name, "TOK_ENUM") { return 56; }
    if str_eq(name, "TOK_MATCH") { return 57; }
    if str_eq(name, "TOK_FAT_ARROW") { return 58; }

    if str_eq(name, "AST_PROGRAM") { return 1; }
    if str_eq(name, "AST_FN_DECL") { return 2; }
    if str_eq(name, "AST_PARAM") { return 3; }
    if str_eq(name, "AST_BLOCK") { return 4; }
    if str_eq(name, "AST_LET_STMT") { return 5; }
    if str_eq(name, "AST_ASSIGN_STMT") { return 6; }
    if str_eq(name, "AST_RETURN_STMT") { return 7; }
    if str_eq(name, "AST_IF_STMT") { return 8; }
    if str_eq(name, "AST_WHILE_STMT") { return 9; }
    if str_eq(name, "AST_EXPR_STMT") { return 10; }
    if str_eq(name, "AST_STRUCT_DECL") { return 11; }
    if str_eq(name, "AST_CLASS_DECL") { return 12; }
    if str_eq(name, "AST_FIELD_DECL") { return 13; }
    if str_eq(name, "AST_ENUM_DECL") { return 14; }
    if str_eq(name, "AST_ENUM_VARIANT") { return 15; }
    if str_eq(name, "AST_MATCH_STMT") { return 16; }
    if str_eq(name, "AST_MATCH_ARM") { return 17; }
    if str_eq(name, "AST_INT_LIT") { return 20; }
    if str_eq(name, "AST_STR_LIT") { return 21; }
    if str_eq(name, "AST_BOOL_LIT") { return 22; }
    if str_eq(name, "AST_IDENT") { return 23; }
    if str_eq(name, "AST_BIN_OP") { return 24; }
    if str_eq(name, "AST_UN_OP") { return 25; }
    if str_eq(name, "AST_CALL") { return 26; }
    if str_eq(name, "AST_PRINT") { return 27; }
    if str_eq(name, "AST_MEMBER") { return 28; }
    if str_eq(name, "AST_INDEX") { return 29; }
    if str_eq(name, "AST_NEW") { return 30; }
    if str_eq(name, "AST_FIELD_INIT") { return 31; }
    if str_eq(name, "AST_ARRAY_LIT") { return 32; }

    if str_eq(name, "IR_OP_ALLOC_HEAP") { return 1; }
    if str_eq(name, "IR_OP_ALLOC_STACK") { return 2; }
    if str_eq(name, "IR_OP_LOAD") { return 3; }
    if str_eq(name, "IR_OP_STORE") { return 4; }
    if str_eq(name, "IR_OP_LOAD_INDEX") { return 5; }
    if str_eq(name, "IR_OP_STORE_INDEX") { return 6; }
    if str_eq(name, "IR_OP_COPY") { return 7; }
    if str_eq(name, "IR_OP_CONST_INT") { return 8; }
    if str_eq(name, "IR_OP_CONST_STR") { return 9; }
    if str_eq(name, "IR_OP_CONST_BOOL") { return 10; }
    if str_eq(name, "IR_OP_BIN_OP") { return 11; }
    if str_eq(name, "IR_OP_UN_OP") { return 12; }
    if str_eq(name, "IR_OP_CALL") { return 13; }
    if str_eq(name, "IR_OP_PRINT") { return 14; }
    if str_eq(name, "IR_OP_RETAIN") { return 15; }
    if str_eq(name, "IR_OP_RELEASE") { return 16; }
    if str_eq(name, "IR_OP_RETURN") { return 17; }
    if str_eq(name, "IR_OP_BRANCH") { return 18; }
    if str_eq(name, "IR_OP_JUMP") { return 19; }
    if str_eq(name, "IR_OP_LABEL") { return 20; }

    if str_eq(name, "TYPE_VOID") { return 0; }
    if str_eq(name, "TYPE_INT") { return 1; }
    if str_eq(name, "TYPE_BOOL") { return 2; }
    if str_eq(name, "TYPE_STRING") { return 3; }
    if str_eq(name, "TYPE_STRUCT") { return 4; }
    if str_eq(name, "TYPE_CLASS") { return 5; }
    if str_eq(name, "TYPE_RAW") { return 6; }

    if str_eq(name, "PREC_LOWEST") { return 1; }
    if str_eq(name, "PREC_OR") { return 2; }
    if str_eq(name, "PREC_AND") { return 3; }
    if str_eq(name, "PREC_EQUALS") { return 4; }
    if str_eq(name, "PREC_LESSGREATER") { return 5; }
    if str_eq(name, "PREC_SUM") { return 6; }
    if str_eq(name, "PREC_PRODUCT") { return 7; }
    if str_eq(name, "PREC_PREFIX") { return 8; }
    if str_eq(name, "PREC_CALL") { return 9; }
    if str_eq(name, "PREC_INDEX") { return 10; }
    if str_eq(name, "PREC_MEMBER") { return 11; }

    return 0 - 999999;
}

fn ir_build_expr(ctx: IRContext, expr: ASTNode) -> i64 {
    if expr == nil { return 0; }

    if expr.kind == AST_INT_LIT {
        let dest = ir_alloc_val(ctx);
        let inst = ir_emit(ctx, IR_OP_CONST_INT, dest, 0);
        inst.int_val = expr.int_val;
        return dest;
    }

    if expr.kind == AST_STR_LIT {
        let lbl = ir_add_string(ctx, expr.str_val);
        let dest = ir_alloc_val(ctx);
        let inst = ir_emit(ctx, IR_OP_CONST_STR, dest, 0);
        inst.str_val = lbl;
        return dest;
    }

    if expr.kind == AST_BOOL_LIT {
        let dest = ir_alloc_val(ctx);
        let inst = ir_emit(ctx, IR_OP_CONST_BOOL, dest, 0);
        inst.int_val = expr.int_val;
        return dest;
    }

    if expr.kind == AST_IDENT {
        if str_eq(expr.str_val, "nil") {
            let dest = ir_alloc_val(ctx);
            ir_emit(ctx, IR_OP_CONST_INT, dest, 0);
            return dest;
        }
        let cv = get_const_val(expr.str_val);
        if cv != (0 - 999999) {
            let dest = ir_alloc_val(ctx);
            let inst = ir_emit(ctx, IR_OP_CONST_INT, dest, 0);
            inst.int_val = cv;
            return dest;
        }
        let sym = ir_get_local(ctx, expr.str_val);
        if sym != nil {
            return sym.offset;
        }
        return 0;
    }

    if expr.kind == AST_BIN_OP {
        let left = ir_build_expr(ctx, expr.left);
        let right = ir_build_expr(ctx, expr.right);
        let dest = ir_alloc_val(ctx);
        let inst = ir_emit(ctx, IR_OP_BIN_OP, dest, left);
        inst.src2 = right;
        inst.str_val = expr.str_val;
        return dest;
    }

    if expr.kind == AST_UN_OP {
        let right = ir_build_expr(ctx, expr.left);
        let dest = ir_alloc_val(ctx);
        let inst = ir_emit(ctx, IR_OP_UN_OP, dest, right);
        inst.str_val = expr.str_val;
        return dest;
    }

    if expr.kind == AST_CALL {
        if str_eq(expr.str_val, "print") {
            let arg = expr.child;
            while arg != nil {
                let v = ir_build_expr(ctx, arg);
                let inst = ir_emit(ctx, IR_OP_PRINT, 0, v);
                let t_kind = TYPE_INT;
                if arg.kind == AST_STR_LIT {
                    t_kind = TYPE_STRING;
                } else if arg.kind == AST_BOOL_LIT {
                    t_kind = TYPE_BOOL;
                } else {
                    let t_name = ir_get_expr_type(ctx, arg);
                    if str_eq(t_name, "string") {
                        t_kind = TYPE_STRING;
                    } else if str_eq(t_name, "bool") {
                        t_kind = TYPE_BOOL;
                    }
                }
                inst.type_kind = t_kind;
                arg = arg.next;
            }
            return 0;
        }

        let dot_pos: i64 = 0 - 1;
        let k: i64 = 0;
        while k < str_len(expr.str_val) {
            if str_char(expr.str_val, k) == 46 { dot_pos = k; }
            k = k + 1;
        }
        if dot_pos > 0 {
            let enum_n = str_sub(expr.str_val, 0, dot_pos);
            let var_n = str_sub(expr.str_val, dot_pos + 1, str_len(expr.str_val) - dot_pos - 1);
            let ti = tc_find_type(ctx.tc, enum_n);
            if ti != nil {
                let tag_val = tc_get_field_offset(ti, var_n);
                let dest = ir_alloc_val(ctx);
                let alloc_inst = ir_emit(ctx, IR_OP_ALLOC_STACK, dest, 0);
                alloc_inst.offset = ti.size;
                let tag_const = ir_alloc_val(ctx);
                let ci = ir_emit(ctx, IR_OP_CONST_INT, tag_const, 0);
                ci.int_val = tag_val;
                let st = ir_emit(ctx, IR_OP_STORE, dest, tag_const);
                st.offset = 0;
                let arg = expr.child;
                let p_idx: i64 = 0;
                while arg != nil {
                    let arg_val = ir_build_expr(ctx, arg);
                    let st2 = ir_emit(ctx, IR_OP_STORE, dest, arg_val);
                    st2.offset = 8 + p_idx * 8;
                    p_idx = p_idx + 1;
                    arg = arg.next;
                }
                return dest;
            }
        }

        let arg = expr.child;
        let count: i64 = 0;
        let a1: i64 = 0;
        let a2: i64 = 0;
        let a3: i64 = 0;
        let a4: i64 = 0;
        let a5: i64 = 0;
        while arg != nil {
            let v = ir_build_expr(ctx, arg);
            if count == 0 { a1 = v; }
            else if count == 1 { a2 = v; }
            else if count == 2 { a3 = v; }
            else if count == 3 { a4 = v; }
            else if count == 4 { a5 = v; }
            count = count + 1;
            arg = arg.next;
        }
        let dest = ir_alloc_val(ctx);
        let inst = ir_emit(ctx, IR_OP_CALL, dest, a1);
        inst.src2 = a2;
        inst.offset = a3;
        inst.int_val = a4;
        inst.extra = a5;
        inst.str_val = expr.str_val;
        inst.arg_count = count;
        return dest;
    }

    if expr.kind == AST_MEMBER {
        if expr.left.kind == AST_IDENT {
            let enum_ti = tc_find_type(ctx.tc, expr.left.str_val);
            if enum_ti != nil {
                let tag_val = tc_get_field_offset(enum_ti, expr.str_val);
                let dest = ir_alloc_val(ctx);
                let alloc_inst = ir_emit(ctx, IR_OP_ALLOC_STACK, dest, 0);
                alloc_inst.offset = enum_ti.size;
                let tag_const = ir_alloc_val(ctx);
                let ci = ir_emit(ctx, IR_OP_CONST_INT, tag_const, 0);
                ci.int_val = tag_val;
                let st = ir_emit(ctx, IR_OP_STORE, dest, tag_const);
                st.offset = 0;
                return dest;
            }
        }
        let obj = ir_build_expr(ctx, expr.left);
        let base_type = ir_get_expr_type(ctx, expr.left);
        let ti = tc_find_type(ctx.tc, base_type);
        let offset = tc_get_field_offset(ti, expr.str_val);
        let dest = ir_alloc_val(ctx);
        let inst = ir_emit(ctx, IR_OP_LOAD, dest, obj);
        inst.offset = offset;
        return dest;
    }

    if expr.kind == AST_ARRAY_LIT {
        let dest = ir_alloc_val(ctx);
        let alloc_inst = ir_emit(ctx, IR_OP_ALLOC_STACK, dest, 0);
        alloc_inst.offset = 64;
        let elem = expr.child;
        let elem_idx: i64 = 0;
        while elem != nil {
            let elem_val = ir_build_expr(ctx, elem);
            let st = ir_emit(ctx, IR_OP_STORE, dest, elem_val);
            st.offset = elem_idx * 8;
            elem_idx = elem_idx + 1;
            elem = elem.next;
        }
        return dest;
    }

    if expr.kind == AST_INDEX {
        let base = ir_build_expr(ctx, expr.left);
        let idx = ir_build_expr(ctx, expr.right);
        let dest = ir_alloc_val(ctx);
        let inst = ir_emit(ctx, IR_OP_LOAD_INDEX, dest, base);
        inst.src2 = idx;
        let base_type = ir_get_expr_type(ctx, expr.left);
        if str_eq(base_type, "array") || str_eq(base_type, "[i64]") {
            inst.int_val = 8;
        } else {
            inst.int_val = 1;
        }
        return dest;
    }

    if expr.kind == AST_NEW {
        let ti = tc_find_type(ctx.tc, expr.type_name);
        let dest = ir_alloc_val(ctx);
        let is_ref_type: i64 = 0;
        if ti != nil {
            if ti.is_ref == 1 {
                is_ref_type = 1;
            }
        }
        if is_ref_type == 1 {
            let inst = ir_emit(ctx, IR_OP_ALLOC_HEAP, dest, 0);
            inst.str_val = expr.type_name;
            inst.offset = ti.size;
            inst.int_val = ti.type_id;
            inst.type_is_ref = 1;
        } else {
            let inst = ir_emit(ctx, IR_OP_ALLOC_STACK, dest, 0);
            inst.str_val = expr.type_name;
            if ti != nil { inst.offset = ti.size; }
        }
        // Initialize fields
        let init = expr.child;
        while init != nil {
            let val = ir_build_expr(ctx, init.left);
            let offset = tc_get_field_offset(ti, init.str_val);
            let st = ir_emit(ctx, IR_OP_STORE, dest, val);
            st.offset = offset;
            init = init.next;
        }
        return dest;
    }

    if expr.kind == AST_PRINT {
        let arg = expr.child;
        while arg != nil {
            let v = ir_build_expr(ctx, arg);
            let inst = ir_emit(ctx, IR_OP_PRINT, 0, v);
            let type_n = ir_get_expr_type(ctx, arg);
            if arg.kind == AST_STR_LIT || str_eq(type_n, "string") {
                inst.type_kind = TYPE_STRING;
            } else if arg.kind == AST_BOOL_LIT || str_eq(type_n, "bool") {
                inst.type_kind = TYPE_BOOL;
            } else {
                inst.type_kind = TYPE_INT;
            }
            arg = arg.next;
        }
        return 0;
    }

    return 0;
}

fn ir_build_stmt(ctx: IRContext, stmt: ASTNode) {
    if stmt == nil { return; }

    if stmt.kind == AST_LET_STMT {
        let val = ir_build_expr(ctx, stmt.left);
        let var_id = ir_alloc_val(ctx);
        ir_emit(ctx, IR_OP_COPY, var_id, val);
        let type_n = stmt.type_name;
        if str_len(type_n) == 0 {
            type_n = ir_get_expr_type(ctx, stmt.left);
        }
        let ti = tc_find_type(ctx.tc, type_n);
        let is_ref: i64 = 0;
        if ti != nil {
            if ti.is_ref == 1 {
                is_ref = 1;
            }
        }
        ir_set_local(ctx, stmt.str_val, var_id, is_ref, type_n);
        return;
    }

    if stmt.kind == AST_ASSIGN_STMT {
        let rhs = ir_build_expr(ctx, stmt.right);
        if stmt.left.kind == AST_IDENT {
            let sym = ir_get_local(ctx, stmt.left.str_val);
            if sym != nil {
                ir_emit(ctx, IR_OP_COPY, sym.offset, rhs);
            }
        } else if stmt.left.kind == AST_MEMBER {
            let obj = ir_build_expr(ctx, stmt.left.left);
            let base_type = ir_get_expr_type(ctx, stmt.left.left);
            let ti = tc_find_type(ctx.tc, base_type);
            let offset = tc_get_field_offset(ti, stmt.left.str_val);
            let inst = ir_emit(ctx, IR_OP_STORE, obj, rhs);
            inst.offset = offset;
        } else if stmt.left.kind == AST_INDEX {
            let base = ir_build_expr(ctx, stmt.left.left);
            let idx = ir_build_expr(ctx, stmt.left.right);
            let inst = ir_emit(ctx, IR_OP_STORE_INDEX, base, rhs);
            inst.src2 = idx;
            let base_type = ir_get_expr_type(ctx, stmt.left.left);
            if str_eq(base_type, "array") || str_eq(base_type, "[i64]") {
                inst.int_val = 8;
            } else {
                inst.int_val = 1;
            }
        }
        return;
    }

    if stmt.kind == AST_RETURN_STMT {
        let ret_val: i64 = 0;
        if stmt.left != nil {
            ret_val = ir_build_expr(ctx, stmt.left);
        }
        ir_emit(ctx, IR_OP_RETURN, 0, ret_val);
        return;
    }

    if stmt.kind == AST_IF_STMT {
        let cond = ir_build_expr(ctx, stmt.left);
        let else_lbl = ir_new_label(ctx, ".L_else_");
        let end_lbl = ir_new_label(ctx, ".L_ifend_");
        let b_inst = ir_emit(ctx, IR_OP_BRANCH, 0, cond);
        b_inst.label = else_lbl;
        ir_build_block(ctx, stmt.right);
        let j_inst = ir_emit(ctx, IR_OP_JUMP, 0, 0);
        j_inst.label = end_lbl;
        let l_inst = ir_emit(ctx, IR_OP_LABEL, 0, 0);
        l_inst.label = else_lbl;
        if stmt.child != nil {
            if stmt.child.kind == AST_BLOCK {
                ir_build_block(ctx, stmt.child);
            } else {
                ir_build_stmt(ctx, stmt.child);
            }
        }
        let e_inst = ir_emit(ctx, IR_OP_LABEL, 0, 0);
        e_inst.label = end_lbl;
        return;
    }

    if stmt.kind == AST_MATCH_STMT {
        let target_val = ir_build_expr(ctx, stmt.left);
        let end_lbl = ir_new_label(ctx, ".L_matchend_");
        let tag_val = ir_alloc_val(ctx);
        let load_inst = ir_emit(ctx, IR_OP_LOAD, tag_val, target_val);
        load_inst.offset = 0;

        let arm = stmt.child;
        while arm != nil {
            if arm.int_val == 1 { // wildcard
                ir_build_block(ctx, arm.right);
                let j_inst = ir_emit(ctx, IR_OP_JUMP, 0, 0);
                j_inst.label = end_lbl;
                arm = nil;
            } else {
                let arm_lbl = ir_new_label(ctx, ".L_arm_");
                let next_lbl = ir_new_label(ctx, ".L_nextarm_");
                let exp_tag = ir_alloc_val(ctx);
                let ti = tc_find_type(ctx.tc, arm.type_name);
                let exp_val: i64 = 0;
                if ti != nil {
                    exp_val = tc_get_field_offset(ti, arm.str_val);
                }
                let const_inst = ir_emit(ctx, IR_OP_CONST_INT, exp_tag, 0);
                const_inst.int_val = exp_val;
                let eq_val = ir_alloc_val(ctx);
                let bin_inst = ir_emit(ctx, IR_OP_BIN_OP, eq_val, tag_val);
                bin_inst.src2 = exp_tag;
                bin_inst.str_val = "==";
                let b_inst = ir_emit(ctx, IR_OP_BRANCH, 0, eq_val);
                b_inst.label = next_lbl;

                // Bindings
                let b_var = arm.left;
                let b_idx: i64 = 0;
                while b_var != nil {
                    let b_val = ir_alloc_val(ctx);
                    let ld = ir_emit(ctx, IR_OP_LOAD, b_val, target_val);
                    ld.offset = 8 + b_idx * 8;
                    ir_set_local(ctx, b_var.str_val, b_val, 0, "i64");
                    b_idx = b_idx + 1;
                    b_var = b_var.next;
                }

                ir_build_block(ctx, arm.right);
                let j_inst = ir_emit(ctx, IR_OP_JUMP, 0, 0);
                j_inst.label = end_lbl;

                let lbl_inst = ir_emit(ctx, IR_OP_LABEL, 0, 0);
                lbl_inst.label = next_lbl;
                arm = arm.next;
            }
        }
        let end_inst = ir_emit(ctx, IR_OP_LABEL, 0, 0);
        end_inst.label = end_lbl;
        return;
    }

    if stmt.kind == AST_WHILE_STMT {
        let loop_lbl = ir_new_label(ctx, ".L_loop_");
        let end_lbl = ir_new_label(ctx, ".L_loop_end_");
        let l_inst = ir_emit(ctx, IR_OP_LABEL, 0, 0);
        l_inst.label = loop_lbl;
        let cond = ir_build_expr(ctx, stmt.left);
        let b_inst = ir_emit(ctx, IR_OP_BRANCH, 0, cond);
        b_inst.label = end_lbl;
        ir_build_block(ctx, stmt.right);
        let j_inst = ir_emit(ctx, IR_OP_JUMP, 0, 0);
        j_inst.label = loop_lbl;
        let e_inst = ir_emit(ctx, IR_OP_LABEL, 0, 0);
        e_inst.label = end_lbl;
        return;
    }

    if stmt.kind == AST_EXPR_STMT {
        ir_build_expr(ctx, stmt.left);
    }
}

fn ir_build_block(ctx: IRContext, block: ASTNode) {
    if block == nil { return; }
    let s = block.child;
    while s != nil {
        ir_build_stmt(ctx, s);
        s = s.next;
    }
}

fn ir_build_function(ctx: IRContext, fn_decl: ASTNode) {
    let fn_obj = new IRFunc {
        name: fn_decl.str_val,
        param_count: 0,
        max_local: 0,
        inst_head: nil,
        inst_tail: nil,
        next: nil
    };
    ctx.cur_fn = fn_obj;
    ctx.val_seq = 1;
    ctx.locals = nil;

    // Parameters (borrowed by default)
    let p = fn_decl.left;
    let p_idx: i64 = 0;
    while p != nil {
        let pid = ir_alloc_val(ctx);
        ir_set_local(ctx, p.str_val, pid, 0, p.type_name);
        p_idx = p_idx + 1;
        p = p.next;
    }
    fn_obj.param_count = p_idx;

    ir_build_block(ctx, fn_decl.right);

    if fn_obj.inst_tail == nil || fn_obj.inst_tail.op != IR_OP_RETURN {
        ir_emit(ctx, IR_OP_RETURN, 0, 0);
    }

    if ctx.funcs_head == nil {
        ctx.funcs_head = fn_obj;
        ctx.funcs_tail = fn_obj;
    } else {
        ctx.funcs_tail.next = fn_obj;
        ctx.funcs_tail = fn_obj;
    }
}

fn ir_build_program(ctx: IRContext, prog: ASTNode) {
    let d = prog.child;
    while d != nil {
        if d.kind == AST_FN_DECL {
            ir_build_function(ctx, d);
        } else if d.kind == AST_CLASS_DECL && d.right != nil {
            let deinit_fn = new ASTNode {
                kind: AST_FN_DECL,
                str_val: str_concat("__gat_deinit_", d.str_val),
                type_name: "void",
                left: new ASTNode {
                    kind: AST_PARAM,
                    str_val: "self",
                    type_name: d.str_val,
                    left: nil, right: nil, child: nil, next: nil
                },
                right: d.right,
                child: nil, next: nil
            };
            ir_build_function(ctx, deinit_fn);
        }
        d = d.next;
    }
}

// ----------------------------------------------------------------------------
// 8. Machine Codegen (x86-64 Windows Fastcall)
// ----------------------------------------------------------------------------

class CodeGen {
    code: ByteBuffer;
    relocs_head: Reloc;
    relocs_tail: Reloc;
    syms_head: SymOffset;
    syms_tail: SymOffset;
}

fn cg_new() -> CodeGen {
    return new CodeGen {
        code: bb_new(4096),
        relocs_head: nil,
        relocs_tail: nil,
        syms_head: nil,
        syms_tail: nil
    };
}

fn cg_define_sym(cg: CodeGen, name: string) {
    let s = new SymOffset {
        name: name,
        offset: cg.code.size,
        next: nil
    };
    if cg.syms_head == nil {
        cg.syms_head = s;
        cg.syms_tail = s;
    } else {
        cg.syms_tail.next = s;
        cg.syms_tail = s;
    }
}

fn cg_reloc(cg: CodeGen, sym: string, kind: i64) {
    let r = new Reloc {
        offset: cg.code.size,
        sym: sym,
        kind: kind,
        next: nil
    };
    if cg.relocs_head == nil {
        cg.relocs_head = r;
        cg.relocs_tail = r;
    } else {
        cg.relocs_tail.next = r;
        cg.relocs_tail = r;
    }
    bb_write_u32(cg.code, 0);
}

fn cg_call_sym(cg: CodeGen, sym: string) {
    bb_write_u8(cg.code, 0xE8); // call rel32
    cg_reloc(cg, sym, 1);
}

fn cg_call_iat(cg: CodeGen, sym: string) {
    bb_write_u8(cg.code, 0xFF); // call qword ptr [rip + __iat_sym]
    bb_write_u8(cg.code, 0x15);
    cg_reloc(cg, str_concat("__iat_", sym), 2);
}

fn cg_mov_reg_local(cg: CodeGen, reg_idx: i64, val_id: i64) {
    if val_id == 0 {
        if reg_idx == 0 { // RAX
            bb_write_u8(cg.code, 0x31); bb_write_u8(cg.code, 0xC0);
        } else if reg_idx == 1 { // RCX
            bb_write_u8(cg.code, 0x31); bb_write_u8(cg.code, 0xC9);
        } else if reg_idx == 2 { // RDX
            bb_write_u8(cg.code, 0x31); bb_write_u8(cg.code, 0xD2);
        } else if reg_idx == 3 { // R10
            bb_write_u8(cg.code, 0x45); bb_write_u8(cg.code, 0x31); bb_write_u8(cg.code, 0xD2);
        } else if reg_idx == 4 { // R8
            bb_write_u8(cg.code, 0x45); bb_write_u8(cg.code, 0x31); bb_write_u8(cg.code, 0xC0);
        } else if reg_idx == 5 { // R9
            bb_write_u8(cg.code, 0x45); bb_write_u8(cg.code, 0x31); bb_write_u8(cg.code, 0xC9);
        }
        return;
    }
    let disp = val_id * 8;
    // mov reg, [rbp - disp]
    if reg_idx == 0 { // RAX
        bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x85);
        bb_write_u32(cg.code, (0 - disp));
    } else if reg_idx == 1 { // RCX
        bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x8D);
        bb_write_u32(cg.code, (0 - disp));
    } else if reg_idx == 2 { // RDX
        bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x95);
        bb_write_u32(cg.code, (0 - disp));
    } else if reg_idx == 3 { // R10
        bb_write_u8(cg.code, 0x4C); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x95);
        bb_write_u32(cg.code, (0 - disp));
    } else if reg_idx == 4 { // R8
        bb_write_u8(cg.code, 0x4C); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x85);
        bb_write_u32(cg.code, (0 - disp));
    } else if reg_idx == 5 { // R9
        bb_write_u8(cg.code, 0x4C); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x8D);
        bb_write_u32(cg.code, (0 - disp));
    }
}

fn cg_mov_local_reg(cg: CodeGen, val_id: i64, reg_idx: i64) {
    let disp = val_id * 8;
    // mov [rbp - disp], reg
    if reg_idx == 0 { // RAX
        bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0x85);
        bb_write_u32(cg.code, (0 - disp));
    }
}

// Emit runtime helpers into code stream
fn cg_emit_runtime(cg: CodeGen) {
    // 0. Entrypoint Trampoline
    cg_define_sym(cg, "__gat_entry");
    // sub rsp, 40 -> 48 83 EC 28
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x83); bb_write_u8(cg.code, 0xEC); bb_write_u8(cg.code, 0x28);
    // call main -> E8 disp32
    bb_write_u8(cg.code, 0xE8);
    cg_reloc(cg, "main", 1);
    // mov rcx, rax -> 48 89 C1
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0xC1);
    // call [rip + __iat_ExitProcess] -> FF 15 disp32
    bb_write_u8(cg.code, 0xFF); bb_write_u8(cg.code, 0x15);
    cg_reloc(cg, "__iat_ExitProcess", 2);

    // 1. __gat_print_str(rcx: str)
    cg_define_sym(cg, "__gat_print_str");
    bb_write_u8(cg.code, 0x55);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0xE5);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x83); bb_write_u8(cg.code, 0xEC); bb_write_u8(cg.code, 0x40);
    // test rcx, rcx; jz null (+70)
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x85); bb_write_u8(cg.code, 0xC9);
    bb_write_u8(cg.code, 0x74); bb_write_u8(cg.code, 0x46);
    // save rcx at [rbp-8]
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0x4D); bb_write_u8(cg.code, 0xF8);
    // strlen
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x31); bb_write_u8(cg.code, 0xC0); // xor rax, rax
    bb_write_u8(cg.code, 0x4C); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x55); bb_write_u8(cg.code, 0xF8); // mov r10, [rbp-8]
    let str_loop = cg.code.size;
    bb_write_u8(cg.code, 0x41); bb_write_u8(cg.code, 0x80); bb_write_u8(cg.code, 0x3C); bb_write_u8(cg.code, 0x02); bb_write_u8(cg.code, 0x00); // cmp byte ptr [r10+rax], 0
    bb_write_u8(cg.code, 0x74); bb_write_u8(cg.code, 0x05); // jz +5
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xFF); bb_write_u8(cg.code, 0xC0); // inc rax
    bb_write_u8(cg.code, 0xEB); bb_write_u8(cg.code, 0xF4); // jmp str_loop (-12)
    // len in rax, save at [rbp-16]
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0x45); bb_write_u8(cg.code, 0xF0);
    // GetStdHandle(-11)
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xC7); bb_write_u8(cg.code, 0xC1); bb_write_u32(cg.code, (0 - 11));
    cg_call_iat(cg, "GetStdHandle");
    // WriteFile(hStdOut: rcx, buf: rdx, len: r8, &written: r9, lpOverlapped: [rsp+0x20]=0)
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0xC1); // rcx = rax
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x55); bb_write_u8(cg.code, 0xF8); // rdx = [rbp-8]
    bb_write_u8(cg.code, 0x4C); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x45); bb_write_u8(cg.code, 0xF0); // r8 = [rbp-16]
    bb_write_u8(cg.code, 0x4C); bb_write_u8(cg.code, 0x8D); bb_write_u8(cg.code, 0x4D); bb_write_u8(cg.code, 0xE8); // r9 = lea [rbp-24]
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xC7); bb_write_u8(cg.code, 0x44); bb_write_u8(cg.code, 0x24); bb_write_u8(cg.code, 0x20); bb_write_u32(cg.code, 0);
    cg_call_iat(cg, "WriteFile");
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0xEC); bb_write_u8(cg.code, 0x5D); bb_write_u8(cg.code, 0xC3);

    // 2. __gat_print_bool(rcx: bool)
    cg_define_sym(cg, "__gat_print_bool");
    bb_write_u8(cg.code, 0x55);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0xE5);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x83); bb_write_u8(cg.code, 0xEC); bb_write_u8(cg.code, 0x40);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x85); bb_write_u8(cg.code, 0xC9); // test rcx, rcx
    bb_write_u8(cg.code, 0x75); bb_write_u8(cg.code, 0x11); // jnz +17 (skip false branch)
    // false branch
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x8D); bb_write_u8(cg.code, 0x0D); cg_reloc(cg, "str_false_const", 1);
    cg_call_sym(cg, "__gat_print_str");
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0xEC); bb_write_u8(cg.code, 0x5D); bb_write_u8(cg.code, 0xC3);
    // true branch
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x8D); bb_write_u8(cg.code, 0x0D); cg_reloc(cg, "str_true_const", 1);
    cg_call_sym(cg, "__gat_print_str");
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0xEC); bb_write_u8(cg.code, 0x5D); bb_write_u8(cg.code, 0xC3);

    // 3. __gat_print_i64(rcx: i64)
    cg_define_sym(cg, "__gat_print_i64");
    bb_write_u8(cg.code, 0x55);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0xE5);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x83); bb_write_u8(cg.code, 0xEC); bb_write_u8(cg.code, 0x40);
    cg_call_sym(cg, "__gat_str_from_int");
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0xC1); // rcx = rax
    cg_call_sym(cg, "__gat_print_str");
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0xEC); bb_write_u8(cg.code, 0x5D); bb_write_u8(cg.code, 0xC3);

    // 4. __gat_alloc_mem(rcx: size) -> rax
    cg_define_sym(cg, "__gat_alloc_mem");
    bb_write_u8(cg.code, 0x55);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0xE5);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x83); bb_write_u8(cg.code, 0xEC); bb_write_u8(cg.code, 0x40);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0x4D); bb_write_u8(cg.code, 0xF8); // [rbp-8] = size
    cg_call_iat(cg, "GetProcessHeap");
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0xC1); // rcx = hHeap
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xC7); bb_write_u8(cg.code, 0xC2); bb_write_u32(cg.code, 8); // rdx = HEAP_ZERO_MEMORY (8)
    bb_write_u8(cg.code, 0x4C); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x45); bb_write_u8(cg.code, 0xF8); // r8 = size
    cg_call_iat(cg, "HeapAlloc");
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0xEC); bb_write_u8(cg.code, 0x5D); bb_write_u8(cg.code, 0xC3);

    // 5. __gat_free_mem(rcx: ptr)
    cg_define_sym(cg, "__gat_free_mem");
    bb_write_u8(cg.code, 0x55);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0xE5);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x83); bb_write_u8(cg.code, 0xEC); bb_write_u8(cg.code, 0x40);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x85); bb_write_u8(cg.code, 0xC9); // test rcx, rcx
    bb_write_u8(cg.code, 0x74); bb_write_u8(cg.code, 0x1A); // jz +26
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0x4D); bb_write_u8(cg.code, 0xF8); // [rbp-8] = ptr
    cg_call_iat(cg, "GetProcessHeap");
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0xC1); // rcx = hHeap
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x31); bb_write_u8(cg.code, 0xD2); // rdx = 0
    bb_write_u8(cg.code, 0x4C); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x45); bb_write_u8(cg.code, 0xF8); // r8 = ptr
    cg_call_iat(cg, "HeapFree");
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0xEC); bb_write_u8(cg.code, 0x5D); bb_write_u8(cg.code, 0xC3);

    // 6. __gat_str_len(rcx: str) -> rax
    cg_define_sym(cg, "__gat_str_len");
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x85); bb_write_u8(cg.code, 0xC9); // test rcx, rcx
    bb_write_u8(cg.code, 0x75); bb_write_u8(cg.code, 0x04); // jnz +4 (skip xor rax,rax; ret)
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x31); bb_write_u8(cg.code, 0xC0); bb_write_u8(cg.code, 0xC3); // ret 0
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x31); bb_write_u8(cg.code, 0xC0); // xor rax, rax
    let sl_loop = cg.code.size;
    bb_write_u8(cg.code, 0x80); bb_write_u8(cg.code, 0x3C); bb_write_u8(cg.code, 0x01); bb_write_u8(cg.code, 0x00); // cmp [rcx+rax], 0
    bb_write_u8(cg.code, 0x74); bb_write_u8(cg.code, 0x05);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xFF); bb_write_u8(cg.code, 0xC0);
    bb_write_u8(cg.code, 0xEB); bb_write_u8(cg.code, 0xF5); // jmp -11
    bb_write_u8(cg.code, 0xC3);

    // 7. __gat_str_char(rcx: str, rdx: idx) -> rax
    cg_define_sym(cg, "__gat_str_char");
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x0F); bb_write_u8(cg.code, 0xB6); bb_write_u8(cg.code, 0x04); bb_write_u8(cg.code, 0x11); // movzx rax, byte ptr [rcx+rdx]
    bb_write_u8(cg.code, 0xC3);

    // 8. __gat_str_eq(rcx: s1, rdx: s2) -> rax
    cg_define_sym(cg, "__gat_str_eq");
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x39); bb_write_u8(cg.code, 0xD1); // cmp rcx, rdx
    bb_write_u8(cg.code, 0x74); bb_write_u8(cg.code, 0x1F); // je eqLbl (+31)
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x85); bb_write_u8(cg.code, 0xC9); // test rcx, rcx
    bb_write_u8(cg.code, 0x74); bb_write_u8(cg.code, 0x17); // jz diffLbl (+23)
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x85); bb_write_u8(cg.code, 0xD2); // test rdx, rdx
    bb_write_u8(cg.code, 0x74); bb_write_u8(cg.code, 0x12); // jz diffLbl (+18)
    // loop
    bb_write_u8(cg.code, 0x8A); bb_write_u8(cg.code, 0x01); // mov al, [rcx]
    bb_write_u8(cg.code, 0x3A); bb_write_u8(cg.code, 0x02); // cmp al, [rdx]
    bb_write_u8(cg.code, 0x75); bb_write_u8(cg.code, 0x0C); // jne diffLbl (+12)
    bb_write_u8(cg.code, 0x84); bb_write_u8(cg.code, 0xC0); // test al, al
    bb_write_u8(cg.code, 0x74); bb_write_u8(cg.code, 0x0B); // jz eqLbl (+11)
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xFF); bb_write_u8(cg.code, 0xC1); // inc rcx
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xFF); bb_write_u8(cg.code, 0xC2); // inc rdx
    bb_write_u8(cg.code, 0xEB); bb_write_u8(cg.code, 0xEE); // jmp loop (-18)
    // diffLbl
    bb_write_u8(cg.code, 0x31); bb_write_u8(cg.code, 0xC0); bb_write_u8(cg.code, 0xC3); // xor eax, eax; ret
    // eqLbl
    bb_write_u8(cg.code, 0xB8); bb_write_u32(cg.code, 1); bb_write_u8(cg.code, 0xC3); // mov eax, 1; ret

    // 9. __gat_str_sub(rcx: s, rdx: start, r8: len) -> rax
    cg_define_sym(cg, "__gat_str_sub");
    bb_write_u8(cg.code, 0x55);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0xE5);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x83); bb_write_u8(cg.code, 0xEC); bb_write_u8(cg.code, 0x40);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0x4D); bb_write_u8(cg.code, 0xF8); // s
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0x55); bb_write_u8(cg.code, 0xF0); // start
    bb_write_u8(cg.code, 0x4C); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0x45); bb_write_u8(cg.code, 0xE8); // len
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x4D); bb_write_u8(cg.code, 0xE8); // rcx = len
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xFF); bb_write_u8(cg.code, 0xC1); // rcx = len + 1
    cg_call_sym(cg, "__gat_alloc_mem");
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0x45); bb_write_u8(cg.code, 0xE0); // dest
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x31); bb_write_u8(cg.code, 0xC9); // i = 0
    let sub_loop = cg.code.size;
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x3B); bb_write_u8(cg.code, 0x4D); bb_write_u8(cg.code, 0xE8); // cmp rcx, [rbp-24]
    bb_write_u8(cg.code, 0x7D); bb_write_u8(cg.code, 0x18); // jge done (+24)
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x55); bb_write_u8(cg.code, 0xF8); // src = [rbp-8]
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x03); bb_write_u8(cg.code, 0x55); bb_write_u8(cg.code, 0xF0); // + start
    bb_write_u8(cg.code, 0x8A); bb_write_u8(cg.code, 0x04); bb_write_u8(cg.code, 0x0A); // al = [rdx+rcx]
    bb_write_u8(cg.code, 0x4C); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x55); bb_write_u8(cg.code, 0xE0); // r10 = dst [rbp-32]
    bb_write_u8(cg.code, 0x41); bb_write_u8(cg.code, 0x88); bb_write_u8(cg.code, 0x04); bb_write_u8(cg.code, 0x0A); // [r10+rcx] = al
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xFF); bb_write_u8(cg.code, 0xC1); // inc rcx
    bb_write_u8(cg.code, 0xEB); bb_write_u8(cg.code, 0xE2); // jmp -30
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x45); bb_write_u8(cg.code, 0xE0); // rax = dest
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0xEC); bb_write_u8(cg.code, 0x5D); bb_write_u8(cg.code, 0xC3);

    // 10. __gat_str_concat(rcx: s1, rdx: s2) -> rax
    cg_define_sym(cg, "__gat_str_concat");
    bb_write_u8(cg.code, 0x55);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0xE5);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x83); bb_write_u8(cg.code, 0xEC); bb_write_u8(cg.code, 0x40);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0x4D); bb_write_u8(cg.code, 0xF8); // s1
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0x55); bb_write_u8(cg.code, 0xF0); // s2
    cg_call_sym(cg, "__gat_str_len");
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0x45); bb_write_u8(cg.code, 0xE8); // len1
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x4D); bb_write_u8(cg.code, 0xF0); // rcx = s2
    cg_call_sym(cg, "__gat_str_len");
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0x45); bb_write_u8(cg.code, 0xE0); // len2
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x4D); bb_write_u8(cg.code, 0xE8);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x03); bb_write_u8(cg.code, 0x4D); bb_write_u8(cg.code, 0xE0); // len1 + len2
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xFF); bb_write_u8(cg.code, 0xC1); // + 1
    cg_call_sym(cg, "__gat_alloc_mem");
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0x45); bb_write_u8(cg.code, 0xD8); // new_buf
    // copy s1
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x31); bb_write_u8(cg.code, 0xC9);
    let c1_loop = cg.code.size;
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x3B); bb_write_u8(cg.code, 0x4D); bb_write_u8(cg.code, 0xE8);
    bb_write_u8(cg.code, 0x7D); bb_write_u8(cg.code, 0x14); // jge +20
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x55); bb_write_u8(cg.code, 0xF8);
    bb_write_u8(cg.code, 0x8A); bb_write_u8(cg.code, 0x04); bb_write_u8(cg.code, 0x0A);
    bb_write_u8(cg.code, 0x4C); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x55); bb_write_u8(cg.code, 0xD8); // r10 = dst
    bb_write_u8(cg.code, 0x41); bb_write_u8(cg.code, 0x88); bb_write_u8(cg.code, 0x04); bb_write_u8(cg.code, 0x0A);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xFF); bb_write_u8(cg.code, 0xC1);
    bb_write_u8(cg.code, 0xEB); bb_write_u8(cg.code, 0xE6); // jmp -26
    // copy s2
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x31); bb_write_u8(cg.code, 0xC9);
    let c2_loop = cg.code.size;
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x3B); bb_write_u8(cg.code, 0x4D); bb_write_u8(cg.code, 0xE0);
    bb_write_u8(cg.code, 0x7D); bb_write_u8(cg.code, 0x18); // jge +24
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x55); bb_write_u8(cg.code, 0xF0);
    bb_write_u8(cg.code, 0x8A); bb_write_u8(cg.code, 0x04); bb_write_u8(cg.code, 0x0A);
    bb_write_u8(cg.code, 0x4C); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x55); bb_write_u8(cg.code, 0xD8); // r10 = dst
    bb_write_u8(cg.code, 0x4C); bb_write_u8(cg.code, 0x03); bb_write_u8(cg.code, 0x55); bb_write_u8(cg.code, 0xE8); // r10 += len1
    bb_write_u8(cg.code, 0x41); bb_write_u8(cg.code, 0x88); bb_write_u8(cg.code, 0x04); bb_write_u8(cg.code, 0x0A);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xFF); bb_write_u8(cg.code, 0xC1);
    bb_write_u8(cg.code, 0xEB); bb_write_u8(cg.code, 0xE2); // jmp -30
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x45); bb_write_u8(cg.code, 0xD8);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0xEC); bb_write_u8(cg.code, 0x5D); bb_write_u8(cg.code, 0xC3);

    // 11. __gat_str_from_int(rcx: n) -> rax
    cg_define_sym(cg, "__gat_str_from_int");
    bb_write_u8(cg.code, 0x55);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0xE5);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x83); bb_write_u8(cg.code, 0xEC); bb_write_u8(cg.code, 0x40);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0x4D); bb_write_u8(cg.code, 0xF8); // [rbp-8] = n
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xC7); bb_write_u8(cg.code, 0xC1); bb_write_u32(cg.code, 32);
    cg_call_sym(cg, "__gat_alloc_mem");
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0x45); bb_write_u8(cg.code, 0xF0); // [rbp-16] = buf
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x45); bb_write_u8(cg.code, 0xF8); // rax = n
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x85); bb_write_u8(cg.code, 0xC0);
    bb_write_u8(cg.code, 0x75); bb_write_u8(cg.code, 0x10); // jnz +16 (skip n == 0 branch)
    // n == 0
    bb_write_u8(cg.code, 0x4C); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x55); bb_write_u8(cg.code, 0xF0); // r10 = buf
    bb_write_u8(cg.code, 0x41); bb_write_u8(cg.code, 0xC6); bb_write_u8(cg.code, 0x02); bb_write_u8(cg.code, 0x30); // [r10] = '0'
    bb_write_u8(cg.code, 0x4C); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0xD0); // rax = r10
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0xEC); bb_write_u8(cg.code, 0x5D); bb_write_u8(cg.code, 0xC3);
    // n != 0
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xC7); bb_write_u8(cg.code, 0x45); bb_write_u8(cg.code, 0xE8); bb_write_u32(cg.code, 0); // is_neg = 0
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x85); bb_write_u8(cg.code, 0xC0);
    bb_write_u8(cg.code, 0x79); bb_write_u8(cg.code, 0x0F); // jge
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xC7); bb_write_u8(cg.code, 0x45); bb_write_u8(cg.code, 0xE8); bb_write_u32(cg.code, 1); // is_neg = 1
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xF7); bb_write_u8(cg.code, 0xD8); // neg rax
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0x45); bb_write_u8(cg.code, 0xF8); // save n
    // format digits backwards
    bb_write_u8(cg.code, 0x4C); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x55); bb_write_u8(cg.code, 0xF0); // r10 = buf
    bb_write_u8(cg.code, 0x49); bb_write_u8(cg.code, 0x83); bb_write_u8(cg.code, 0xC2); bb_write_u8(cg.code, 0x1E); // r10 = buf + 30
    bb_write_u8(cg.code, 0x41); bb_write_u8(cg.code, 0xC6); bb_write_u8(cg.code, 0x02); bb_write_u8(cg.code, 0x00); // [r10] = 0
    bb_write_u8(cg.code, 0x49); bb_write_u8(cg.code, 0xFF); bb_write_u8(cg.code, 0xCA); // dec r10
    let sfi_loop = cg.code.size;
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x31); bb_write_u8(cg.code, 0xD2);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xB9); bb_write_u64(cg.code, 10);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xF7); bb_write_u8(cg.code, 0xF1); // div rcx -> rem in rdx, quot in rax
    bb_write_u8(cg.code, 0x80); bb_write_u8(cg.code, 0xC2); bb_write_u8(cg.code, 0x30); // dl += '0'
    bb_write_u8(cg.code, 0x41); bb_write_u8(cg.code, 0x88); bb_write_u8(cg.code, 0x12); // [r10] = dl
    bb_write_u8(cg.code, 0x49); bb_write_u8(cg.code, 0xFF); bb_write_u8(cg.code, 0xCA); // dec r10
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x85); bb_write_u8(cg.code, 0xC0);
    bb_write_u8(cg.code, 0x75); bb_write_u8(cg.code, 0xE2); // jnz -30
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x83); bb_write_u8(cg.code, 0x7D); bb_write_u8(cg.code, 0xE8); bb_write_u8(cg.code, 0x00);
    bb_write_u8(cg.code, 0x74); bb_write_u8(cg.code, 0x07);
    bb_write_u8(cg.code, 0x41); bb_write_u8(cg.code, 0xC6); bb_write_u8(cg.code, 0x02); bb_write_u8(cg.code, 0x2D); // [r10] = '-'
    bb_write_u8(cg.code, 0x49); bb_write_u8(cg.code, 0xFF); bb_write_u8(cg.code, 0xCA);
    bb_write_u8(cg.code, 0x49); bb_write_u8(cg.code, 0x8D); bb_write_u8(cg.code, 0x42); bb_write_u8(cg.code, 0x01); // rax = r10 + 1
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0xEC); bb_write_u8(cg.code, 0x5D); bb_write_u8(cg.code, 0xC3);

    // 12. __gat_get_cmd_arg(rcx: idx) -> rax
    cg_define_sym(cg, "__gat_get_cmd_arg");
    bb_write_u8(cg.code, 0x55);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0xE5);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x83); bb_write_u8(cg.code, 0xEC); bb_write_u8(cg.code, 0x40);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0x4D); bb_write_u8(cg.code, 0xF8); // [rbp-8] = target_idx
    cg_call_iat(cg, "GetCommandLineA");
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0x45); bb_write_u8(cg.code, 0xF0); // [rbp-16] = cmdline
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0xC1); // rcx = cmdline
    cg_call_sym(cg, "__gat_str_len");
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0x45); bb_write_u8(cg.code, 0xE8); // [rbp-24] = cmd_len

    // [rbp-32] = i (0), [rbp-40] = cur_arg (0)
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xC7); bb_write_u8(cg.code, 0x45); bb_write_u8(cg.code, 0xE0); bb_write_u32(cg.code, 0);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xC7); bb_write_u8(cg.code, 0x45); bb_write_u8(cg.code, 0xD8); bb_write_u32(cg.code, 0);

    let arg_loop = cg.code.size;
    // skip whitespace
    let ws_loop = cg.code.size;
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x4D); bb_write_u8(cg.code, 0xE0); // rcx = i
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x3B); bb_write_u8(cg.code, 0x4D); bb_write_u8(cg.code, 0xE8); // cmp i, cmd_len
    let jge_not_found_pos = cg.code.size;
    bb_write_u8(cg.code, 0x0F); bb_write_u8(cg.code, 0x8D); // jge disp32
    bb_write_u32(cg.code, 0); // placeholder
    bb_write_u8(cg.code, 0x4C); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x55); bb_write_u8(cg.code, 0xF0); // r10 = cmdline
    bb_write_u8(cg.code, 0x41); bb_write_u8(cg.code, 0x8A); bb_write_u8(cg.code, 0x04); bb_write_u8(cg.code, 0x0A); // al = cmdline[i]
    bb_write_u8(cg.code, 0x3C); bb_write_u8(cg.code, 0x20); // ' '
    bb_write_u8(cg.code, 0x74); bb_write_u8(cg.code, 0x04);
    bb_write_u8(cg.code, 0x3C); bb_write_u8(cg.code, 0x09); // '\t'
    bb_write_u8(cg.code, 0x75); bb_write_u8(cg.code, 0x07); // not ws -> break
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xFF); bb_write_u8(cg.code, 0x45); bb_write_u8(cg.code, 0xE0); // inc i
    let back_ws = cg.code.size + 2 - ws_loop;
    let b_ws = 256 - back_ws;
    bb_write_u8(cg.code, 0xEB); bb_write_u8(cg.code, b_ws);

    // [rbp-48] = start_idx = i
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x45); bb_write_u8(cg.code, 0xE0);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0x45); bb_write_u8(cg.code, 0xD0);

    // check if quoted: cmdline[i] == '"'
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x4D); bb_write_u8(cg.code, 0xE0);
    bb_write_u8(cg.code, 0x4C); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x55); bb_write_u8(cg.code, 0xF0);
    bb_write_u8(cg.code, 0x41); bb_write_u8(cg.code, 0x8A); bb_write_u8(cg.code, 0x04); bb_write_u8(cg.code, 0x0A);
    bb_write_u8(cg.code, 0x3C); bb_write_u8(cg.code, 0x22); // '"'
    let jne_uq_pos = cg.code.size;
    bb_write_u8(cg.code, 0x75); bb_write_u8(cg.code, 0x00); // placeholder to uq_loop

    // quoted: start_idx = i + 1, inc i
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xFF); bb_write_u8(cg.code, 0x45); bb_write_u8(cg.code, 0xE0); // inc i
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x45); bb_write_u8(cg.code, 0xE0);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0x45); bb_write_u8(cg.code, 0xD0); // start_idx = i
    let q_loop = cg.code.size;
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x4D); bb_write_u8(cg.code, 0xE0);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x3B); bb_write_u8(cg.code, 0x4D); bb_write_u8(cg.code, 0xE8);
    let jge_q_pos = cg.code.size;
    bb_write_u8(cg.code, 0x7D); bb_write_u8(cg.code, 0x00); // placeholder to tok_end
    bb_write_u8(cg.code, 0x4C); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x55); bb_write_u8(cg.code, 0xF0);
    bb_write_u8(cg.code, 0x41); bb_write_u8(cg.code, 0x8A); bb_write_u8(cg.code, 0x04); bb_write_u8(cg.code, 0x0A);
    bb_write_u8(cg.code, 0x3C); bb_write_u8(cg.code, 0x22); // '"'
    let jz_q_pos = cg.code.size;
    bb_write_u8(cg.code, 0x74); bb_write_u8(cg.code, 0x00); // placeholder to tok_end
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xFF); bb_write_u8(cg.code, 0x45); bb_write_u8(cg.code, 0xE0); // inc i
    let back_q = cg.code.size + 2 - q_loop;
    let b_q = 256 - back_q;
    bb_write_u8(cg.code, 0xEB); bb_write_u8(cg.code, b_q);
    let jmp_tok_end_q_pos = cg.code.size;
    bb_write_u8(cg.code, 0xEB); bb_write_u8(cg.code, 0x00); // placeholder to tok_end

    // Patch jne_uq
    cg.code.data[jne_uq_pos + 1] = cg.code.size - (jne_uq_pos + 2);

    // unquoted loop:
    let uq_loop = cg.code.size;
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x4D); bb_write_u8(cg.code, 0xE0);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x3B); bb_write_u8(cg.code, 0x4D); bb_write_u8(cg.code, 0xE8);
    let jge_uq_pos = cg.code.size;
    bb_write_u8(cg.code, 0x7D); bb_write_u8(cg.code, 0x00); // placeholder
    bb_write_u8(cg.code, 0x4C); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x55); bb_write_u8(cg.code, 0xF0);
    bb_write_u8(cg.code, 0x41); bb_write_u8(cg.code, 0x8A); bb_write_u8(cg.code, 0x04); bb_write_u8(cg.code, 0x0A);
    bb_write_u8(cg.code, 0x3C); bb_write_u8(cg.code, 0x20); // ' '
    let jz_sp_pos = cg.code.size;
    bb_write_u8(cg.code, 0x74); bb_write_u8(cg.code, 0x00);
    bb_write_u8(cg.code, 0x3C); bb_write_u8(cg.code, 0x09); // '\t'
    let jz_tb_pos = cg.code.size;
    bb_write_u8(cg.code, 0x74); bb_write_u8(cg.code, 0x00);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xFF); bb_write_u8(cg.code, 0x45); bb_write_u8(cg.code, 0xE0); // inc i
    let back_uq = cg.code.size + 2 - uq_loop;
    let b_uq = 256 - back_uq;
    bb_write_u8(cg.code, 0xEB); bb_write_u8(cg.code, b_uq);

    // tok_end
    let tok_end_pos = cg.code.size;
    cg.code.data[jge_q_pos + 1] = tok_end_pos - (jge_q_pos + 2);
    cg.code.data[jz_q_pos + 1] = tok_end_pos - (jz_q_pos + 2);
    cg.code.data[jmp_tok_end_q_pos + 1] = tok_end_pos - (jmp_tok_end_q_pos + 2);
    cg.code.data[jge_uq_pos + 1] = tok_end_pos - (jge_uq_pos + 2);
    cg.code.data[jz_sp_pos + 1] = tok_end_pos - (jz_sp_pos + 2);
    cg.code.data[jz_tb_pos + 1] = tok_end_pos - (jz_tb_pos + 2);

    // check if cur_arg == target_idx
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x45); bb_write_u8(cg.code, 0xD8); // cur_arg
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x3B); bb_write_u8(cg.code, 0x45); bb_write_u8(cg.code, 0xF8); // target_idx
    let jne_next_pos = cg.code.size;
    bb_write_u8(cg.code, 0x75); bb_write_u8(cg.code, 0x00);

    // matched: call str_sub(cmdline: rcx, start_idx: rdx, len: r8)
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x4D); bb_write_u8(cg.code, 0xF0); // rcx = cmdline
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x55); bb_write_u8(cg.code, 0xD0); // rdx = start_idx
    bb_write_u8(cg.code, 0x4C); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x45); bb_write_u8(cg.code, 0xE0); // r8 = i
    bb_write_u8(cg.code, 0x4C); bb_write_u8(cg.code, 0x2B); bb_write_u8(cg.code, 0x45); bb_write_u8(cg.code, 0xD0); // r8 = i - start_idx
    cg_call_sym(cg, "__gat_str_sub");
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0xEC); bb_write_u8(cg.code, 0x5D); bb_write_u8(cg.code, 0xC3);

    // next_arg
    let next_arg_pos = cg.code.size;
    cg.code.data[jne_next_pos + 1] = next_arg_pos - (jne_next_pos + 2);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x4D); bb_write_u8(cg.code, 0xE0);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x3B); bb_write_u8(cg.code, 0x4D); bb_write_u8(cg.code, 0xE8);
    let jge_skip_q = cg.code.size;
    bb_write_u8(cg.code, 0x7D); bb_write_u8(cg.code, 0x0F);
    bb_write_u8(cg.code, 0x4C); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x55); bb_write_u8(cg.code, 0xF0);
    bb_write_u8(cg.code, 0x41); bb_write_u8(cg.code, 0x8A); bb_write_u8(cg.code, 0x04); bb_write_u8(cg.code, 0x0A);
    bb_write_u8(cg.code, 0x3C); bb_write_u8(cg.code, 0x22); // '"'
    bb_write_u8(cg.code, 0x75); bb_write_u8(cg.code, 0x04);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xFF); bb_write_u8(cg.code, 0x45); bb_write_u8(cg.code, 0xE0); // inc i
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xFF); bb_write_u8(cg.code, 0x45); bb_write_u8(cg.code, 0xD8); // inc cur_arg
    bb_write_u8(cg.code, 0xE9);
    let back_main = cg.code.size + 4 - arg_loop;
    let diff_m = 0 - back_main;
    bb_write_u32(cg.code, diff_m);

    // not_found
    let not_found_pos = cg.code.size;
    let diff_nf = not_found_pos - (jge_not_found_pos + 6);
    cg.code.data[jge_not_found_pos + 2] = diff_nf;
    cg.code.data[jge_not_found_pos + 3] = diff_nf / 256;
    cg.code.data[jge_not_found_pos + 4] = diff_nf / 65536;
    cg.code.data[jge_not_found_pos + 5] = (diff_nf / 65536) / 256;
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x8D); bb_write_u8(cg.code, 0x05); cg_reloc(cg, "str_empty_const", 1);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0xEC); bb_write_u8(cg.code, 0x5D); bb_write_u8(cg.code, 0xC3);

    // 13. __gat_read_file(rcx: path) -> rax
    cg_define_sym(cg, "__gat_read_file");
    bb_write_u8(cg.code, 0x55);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0xE5);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x83); bb_write_u8(cg.code, 0xEC); bb_write_u8(cg.code, 0x60);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0x4D); bb_write_u8(cg.code, 0xF8); // [rbp-8] = path
    // CreateFileA(path: rcx, GENERIC_READ: rdx, FILE_SHARE_READ: r8, NULL: r9, OPEN_EXISTING: [rsp+0x20]=3, NORMAL: [rsp+0x28]=0x80, NULL: [rsp+0x30]=0)
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xC7); bb_write_u8(cg.code, 0xC2); bb_write_u32(cg.code, 0x80000000);
    bb_write_u8(cg.code, 0x49); bb_write_u8(cg.code, 0xC7); bb_write_u8(cg.code, 0xC0); bb_write_u32(cg.code, 1);
    bb_write_u8(cg.code, 0x4D); bb_write_u8(cg.code, 0x31); bb_write_u8(cg.code, 0xC9);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xC7); bb_write_u8(cg.code, 0x44); bb_write_u8(cg.code, 0x24); bb_write_u8(cg.code, 0x20); bb_write_u32(cg.code, 3);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xC7); bb_write_u8(cg.code, 0x44); bb_write_u8(cg.code, 0x24); bb_write_u8(cg.code, 0x28); bb_write_u32(cg.code, 0x80);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xC7); bb_write_u8(cg.code, 0x44); bb_write_u8(cg.code, 0x24); bb_write_u8(cg.code, 0x30); bb_write_u32(cg.code, 0);
    cg_call_iat(cg, "CreateFileA");
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x83); bb_write_u8(cg.code, 0xF8); bb_write_u8(cg.code, 0xFF); // cmp rax, -1
    bb_write_u8(cg.code, 0x75); bb_write_u8(cg.code, 0x0C); // jne success (+12)
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x8D); bb_write_u8(cg.code, 0x05); cg_reloc(cg, "str_empty_const", 1);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0xEC); bb_write_u8(cg.code, 0x5D); bb_write_u8(cg.code, 0xC3);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0x45); bb_write_u8(cg.code, 0xF0); // [rbp-16] = hFile
    // GetFileSizeEx
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x4D); bb_write_u8(cg.code, 0xF0); // rcx = [rbp-16] (hFile)
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x8D); bb_write_u8(cg.code, 0x55); bb_write_u8(cg.code, 0xE8); // rdx = lea [rbp-24]
    cg_call_iat(cg, "GetFileSizeEx");
    // Alloc size + 1
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x4D); bb_write_u8(cg.code, 0xE8);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xFF); bb_write_u8(cg.code, 0xC1);
    cg_call_sym(cg, "__gat_alloc_mem");
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0x45); bb_write_u8(cg.code, 0xE0); // [rbp-32] = buf
    // ReadFile
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x4D); bb_write_u8(cg.code, 0xF0); // hFile
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x55); bb_write_u8(cg.code, 0xE0); // buf
    bb_write_u8(cg.code, 0x4C); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x45); bb_write_u8(cg.code, 0xE8); // size
    bb_write_u8(cg.code, 0x4C); bb_write_u8(cg.code, 0x8D); bb_write_u8(cg.code, 0x4D); bb_write_u8(cg.code, 0xD8); // r9 = lea [rbp-40]
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xC7); bb_write_u8(cg.code, 0x44); bb_write_u8(cg.code, 0x24); bb_write_u8(cg.code, 0x20); bb_write_u32(cg.code, 0);
    cg_call_iat(cg, "ReadFile");
    // Null-terminate buf[size] = 0
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x45); bb_write_u8(cg.code, 0xE0); // rax = buf
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x55); bb_write_u8(cg.code, 0xE8); // rdx = size
    bb_write_u8(cg.code, 0xC6); bb_write_u8(cg.code, 0x04); bb_write_u8(cg.code, 0x10); bb_write_u8(cg.code, 0x00); // mov byte ptr [rax+rdx], 0
    // CloseHandle
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x4D); bb_write_u8(cg.code, 0xF0);
    cg_call_iat(cg, "CloseHandle");
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x45); bb_write_u8(cg.code, 0xE0); // rax = buf
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0xEC); bb_write_u8(cg.code, 0x5D); bb_write_u8(cg.code, 0xC3);

    // 14. __gat_write_file(rcx: path, rdx: data, r8: len) -> rax
    cg_define_sym(cg, "__gat_write_file");
    bb_write_u8(cg.code, 0x55);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0xE5);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x83); bb_write_u8(cg.code, 0xEC); bb_write_u8(cg.code, 0x60);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0x4D); bb_write_u8(cg.code, 0xF8); // path
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0x55); bb_write_u8(cg.code, 0xF0); // data
    bb_write_u8(cg.code, 0x4C); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0x45); bb_write_u8(cg.code, 0xE8); // len
    // CreateFileA(CREATE_ALWAYS = 2)
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xC7); bb_write_u8(cg.code, 0xC2); bb_write_u32(cg.code, 0x40000000); // GENERIC_WRITE
    bb_write_u8(cg.code, 0x49); bb_write_u8(cg.code, 0xC7); bb_write_u8(cg.code, 0xC0); bb_write_u32(cg.code, 0);
    bb_write_u8(cg.code, 0x4D); bb_write_u8(cg.code, 0x31); bb_write_u8(cg.code, 0xC9);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xC7); bb_write_u8(cg.code, 0x44); bb_write_u8(cg.code, 0x24); bb_write_u8(cg.code, 0x20); bb_write_u32(cg.code, 2);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xC7); bb_write_u8(cg.code, 0x44); bb_write_u8(cg.code, 0x24); bb_write_u8(cg.code, 0x28); bb_write_u32(cg.code, 0x80);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xC7); bb_write_u8(cg.code, 0x44); bb_write_u8(cg.code, 0x24); bb_write_u8(cg.code, 0x30); bb_write_u32(cg.code, 0);
    cg_call_iat(cg, "CreateFileA");
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x83); bb_write_u8(cg.code, 0xF8); bb_write_u8(cg.code, 0xFF);
    bb_write_u8(cg.code, 0x75); bb_write_u8(cg.code, 0x07); // jne success (+7)
    bb_write_u8(cg.code, 0x31); bb_write_u8(cg.code, 0xC0); bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0xEC); bb_write_u8(cg.code, 0x5D); bb_write_u8(cg.code, 0xC3);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0x45); bb_write_u8(cg.code, 0xD0); // [rbp-48] = hFile
    // WriteFile
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x4D); bb_write_u8(cg.code, 0xD0);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x55); bb_write_u8(cg.code, 0xF0);
    bb_write_u8(cg.code, 0x4C); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x45); bb_write_u8(cg.code, 0xE8);
    bb_write_u8(cg.code, 0x4C); bb_write_u8(cg.code, 0x8D); bb_write_u8(cg.code, 0x4D); bb_write_u8(cg.code, 0xD8);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xC7); bb_write_u8(cg.code, 0x44); bb_write_u8(cg.code, 0x24); bb_write_u8(cg.code, 0x20); bb_write_u32(cg.code, 0);
    cg_call_iat(cg, "WriteFile");
    // CloseHandle
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x4D); bb_write_u8(cg.code, 0xD0);
    cg_call_iat(cg, "CloseHandle");
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x45); bb_write_u8(cg.code, 0xD8); // written
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0xEC); bb_write_u8(cg.code, 0x5D); bb_write_u8(cg.code, 0xC3);

    // 15. __gat_retain(rcx: ptr)
    cg_define_sym(cg, "__gat_retain");
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x85); bb_write_u8(cg.code, 0xC9);
    bb_write_u8(cg.code, 0x74); bb_write_u8(cg.code, 0x04);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xFF); bb_write_u8(cg.code, 0x41); bb_write_u8(cg.code, 0xF0); // inc qword ptr [rcx-16]
    bb_write_u8(cg.code, 0xC3);

    // 16. __gat_release(rcx: ptr)
    cg_define_sym(cg, "__gat_release");
    bb_write_u8(cg.code, 0x55);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0xE5);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x83); bb_write_u8(cg.code, 0xEC); bb_write_u8(cg.code, 0x40);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x85); bb_write_u8(cg.code, 0xC9);
    bb_write_u8(cg.code, 0x74); bb_write_u8(cg.code, 0x17); // jz +23
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0x4D); bb_write_u8(cg.code, 0xF8); // ptr
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xFF); bb_write_u8(cg.code, 0x49); bb_write_u8(cg.code, 0xF0); // dec [rcx-16]
    bb_write_u8(cg.code, 0x75); bb_write_u8(cg.code, 0x0D); // jnz +13
    // free memory
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x4D); bb_write_u8(cg.code, 0xF8);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x83); bb_write_u8(cg.code, 0xE9); bb_write_u8(cg.code, 0x10); // rcx = ptr - 16
    cg_call_sym(cg, "__gat_free_mem");
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0xEC); bb_write_u8(cg.code, 0x5D); bb_write_u8(cg.code, 0xC3);
}

// Emit function machine instructions
fn cg_emit_function(cg: CodeGen, fn_obj: IRFunc) {
    cg_define_sym(cg, fn_obj.name);

    // Prologue: push rbp; mov rbp, rsp; sub rsp, frameSize
    let frame_size = align_val((fn_obj.max_local + 4) * 8 + 32, 16);
    bb_write_u8(cg.code, 0x55);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0xE5);
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x81); bb_write_u8(cg.code, 0xEC);
    bb_write_u32(cg.code, frame_size);

    // Save incoming fastcall parameters to their stack slots
    if fn_obj.param_count > 0 { // RCX -> param 1
        bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0x8D);
        bb_write_u32(cg.code, (0 - 8));
    }
    if fn_obj.param_count > 1 { // RDX -> param 2
        bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0x95);
        bb_write_u32(cg.code, (0 - 16));
    }
    if fn_obj.param_count > 2 { // R8 -> param 3
        bb_write_u8(cg.code, 0x4C); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0x85);
        bb_write_u32(cg.code, (0 - 24));
    }
    if fn_obj.param_count > 3 { // R9 -> param 4
        bb_write_u8(cg.code, 0x4C); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0x8D);
        bb_write_u32(cg.code, (0 - 32));
    }
    if fn_obj.param_count > 4 { // [rbp + 48] -> param 5
        bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x45); bb_write_u8(cg.code, 0x30); // mov rax, [rbp+0x30]
        bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0x85);
        bb_write_u32(cg.code, (0 - 40)); // mov [rbp-40], rax
    }

    // Zero-initialize remaining local variable slots
    let loc_idx = fn_obj.param_count + 1;
    while loc_idx <= fn_obj.max_local {
        let disp = loc_idx * 8;
        bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xC7); bb_write_u8(cg.code, 0x85);
        bb_write_u32(cg.code, (0 - disp));
        bb_write_u32(cg.code, 0);
        loc_idx = loc_idx + 1;
    }

    let inst = fn_obj.inst_head;
    while inst != nil {
        if inst.op == IR_OP_CONST_INT {
            let disp = inst.dest * 8;
            if inst.int_val >= (0 - 2147483648) && inst.int_val <= 2147483647 {
                bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xC7); bb_write_u8(cg.code, 0x85);
                bb_write_u32(cg.code, (0 - disp));
                bb_write_u32(cg.code, inst.int_val);
            } else {
                bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xB8);
                bb_write_u64(cg.code, inst.int_val);
                cg_mov_local_reg(cg, inst.dest, 0);
            }
        } else if inst.op == IR_OP_CONST_BOOL {
            let disp = inst.dest * 8;
            bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xC7); bb_write_u8(cg.code, 0x85);
            bb_write_u32(cg.code, (0 - disp));
            bb_write_u32(cg.code, inst.int_val);
        } else if inst.op == IR_OP_CONST_STR {
            bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x8D); bb_write_u8(cg.code, 0x05);
            cg_reloc(cg, inst.str_val, 1);
            cg_mov_local_reg(cg, inst.dest, 0);
        } else if inst.op == IR_OP_COPY {
            cg_mov_reg_local(cg, 0, inst.src1);
            cg_mov_local_reg(cg, inst.dest, 0);
        } else if inst.op == IR_OP_BIN_OP {
            cg_mov_reg_local(cg, 0, inst.src1); // RAX
            cg_mov_reg_local(cg, 2, inst.src2); // RDX
            if str_eq(inst.str_val, "+") {
                bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x01); bb_write_u8(cg.code, 0xD0);
            } else if str_eq(inst.str_val, "-") {
                bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x29); bb_write_u8(cg.code, 0xD0);
            } else if str_eq(inst.str_val, "*") {
                bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x0F); bb_write_u8(cg.code, 0xAF); bb_write_u8(cg.code, 0xC2);
            } else if str_eq(inst.str_val, "/") {
                cg_mov_reg_local(cg, 3, inst.src2); // R10 = src2
                bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x99); // cqo
                bb_write_u8(cg.code, 0x49); bb_write_u8(cg.code, 0xF7); bb_write_u8(cg.code, 0xFA); // idiv r10
            } else if str_eq(inst.str_val, "%") {
                cg_mov_reg_local(cg, 3, inst.src2); // R10 = src2
                bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x99); // cqo
                bb_write_u8(cg.code, 0x49); bb_write_u8(cg.code, 0xF7); bb_write_u8(cg.code, 0xFA); // idiv r10
                bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0xD0); // mov rax, rdx
            } else if str_eq(inst.str_val, "&&") {
                bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x21); bb_write_u8(cg.code, 0xD0); // and rax, rdx
            } else if str_eq(inst.str_val, "||") {
                bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x09); bb_write_u8(cg.code, 0xD0); // or rax, rdx
            } else if str_eq(inst.str_val, "==") {
                bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x39); bb_write_u8(cg.code, 0xD0);
                bb_write_u8(cg.code, 0x0F); bb_write_u8(cg.code, 0x94); bb_write_u8(cg.code, 0xC0);
                bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x0F); bb_write_u8(cg.code, 0xB6); bb_write_u8(cg.code, 0xC0);
            } else if str_eq(inst.str_val, "!=") {
                bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x39); bb_write_u8(cg.code, 0xD0);
                bb_write_u8(cg.code, 0x0F); bb_write_u8(cg.code, 0x95); bb_write_u8(cg.code, 0xC0);
                bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x0F); bb_write_u8(cg.code, 0xB6); bb_write_u8(cg.code, 0xC0);
            } else if str_eq(inst.str_val, "<") {
                bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x39); bb_write_u8(cg.code, 0xD0);
                bb_write_u8(cg.code, 0x0F); bb_write_u8(cg.code, 0x9C); bb_write_u8(cg.code, 0xC0);
                bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x0F); bb_write_u8(cg.code, 0xB6); bb_write_u8(cg.code, 0xC0);
            } else if str_eq(inst.str_val, "<=") {
                bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x39); bb_write_u8(cg.code, 0xD0);
                bb_write_u8(cg.code, 0x0F); bb_write_u8(cg.code, 0x9E); bb_write_u8(cg.code, 0xC0);
                bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x0F); bb_write_u8(cg.code, 0xB6); bb_write_u8(cg.code, 0xC0);
            } else if str_eq(inst.str_val, ">") {
                bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x39); bb_write_u8(cg.code, 0xD0);
                bb_write_u8(cg.code, 0x0F); bb_write_u8(cg.code, 0x9F); bb_write_u8(cg.code, 0xC0);
                bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x0F); bb_write_u8(cg.code, 0xB6); bb_write_u8(cg.code, 0xC0);
            } else if str_eq(inst.str_val, ">=") {
                bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x39); bb_write_u8(cg.code, 0xD0);
                bb_write_u8(cg.code, 0x0F); bb_write_u8(cg.code, 0x9D); bb_write_u8(cg.code, 0xC0);
                bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x0F); bb_write_u8(cg.code, 0xB6); bb_write_u8(cg.code, 0xC0);
            }
            cg_mov_local_reg(cg, inst.dest, 0);
        } else if inst.op == IR_OP_UN_OP {
            cg_mov_reg_local(cg, 0, inst.src1);
            if str_eq(inst.str_val, "-") {
                bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xF7); bb_write_u8(cg.code, 0xD8);
            } else if str_eq(inst.str_val, "!") {
                bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x83); bb_write_u8(cg.code, 0xF8); bb_write_u8(cg.code, 0x00);
                bb_write_u8(cg.code, 0x0F); bb_write_u8(cg.code, 0x94); bb_write_u8(cg.code, 0xC0);
                bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x0F); bb_write_u8(cg.code, 0xB6); bb_write_u8(cg.code, 0xC0);
            }
            cg_mov_local_reg(cg, inst.dest, 0);
        } else if inst.op == IR_OP_LOAD {
            cg_mov_reg_local(cg, 3, inst.src1);
            // mov rax, [r10 + offset] -> 49 8B 82 disp32
            bb_write_u8(cg.code, 0x49); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x82);
            bb_write_u32(cg.code, inst.offset);
            cg_mov_local_reg(cg, inst.dest, 0);
        } else if inst.op == IR_OP_STORE {
            cg_mov_reg_local(cg, 3, inst.dest);
            cg_mov_reg_local(cg, 0, inst.src1);
            // mov [r10 + offset], rax -> 49 89 82 disp32
            bb_write_u8(cg.code, 0x49); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0x82);
            bb_write_u32(cg.code, inst.offset);
        } else if inst.op == IR_OP_LOAD_INDEX {
            cg_mov_reg_local(cg, 3, inst.src1);
            cg_mov_reg_local(cg, 1, inst.src2);
            if inst.int_val == 1 {
                // movzx rax, byte ptr [r10 + rcx] -> 49 0F B6 04 0A
                bb_write_u8(cg.code, 0x49); bb_write_u8(cg.code, 0x0F); bb_write_u8(cg.code, 0xB6); bb_write_u8(cg.code, 0x04); bb_write_u8(cg.code, 0x0A);
            } else {
                // mov rax, qword ptr [r10 + rcx*8] -> 49 8B 04 CA
                bb_write_u8(cg.code, 0x49); bb_write_u8(cg.code, 0x8B); bb_write_u8(cg.code, 0x04); bb_write_u8(cg.code, 0xCA);
            }
            cg_mov_local_reg(cg, inst.dest, 0);
        } else if inst.op == IR_OP_STORE_INDEX {
            cg_mov_reg_local(cg, 3, inst.dest);
            cg_mov_reg_local(cg, 1, inst.src2);
            cg_mov_reg_local(cg, 0, inst.src1);
            if inst.int_val == 1 {
                // mov byte ptr [r10 + rcx], al -> 41 88 04 0A
                bb_write_u8(cg.code, 0x41); bb_write_u8(cg.code, 0x88); bb_write_u8(cg.code, 0x04); bb_write_u8(cg.code, 0x0A);
            } else {
                // mov qword ptr [r10 + rcx*8], rax -> 49 89 04 CA
                bb_write_u8(cg.code, 0x49); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0x04); bb_write_u8(cg.code, 0xCA);
            }
        } else if inst.op == IR_OP_ALLOC_HEAP {
            bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xC7); bb_write_u8(cg.code, 0xC1);
            bb_write_u32(cg.code, inst.offset + 16);
            cg_call_sym(cg, "__gat_alloc_mem");
            bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xC7); bb_write_u8(cg.code, 0x00); bb_write_u32(cg.code, 1);
            bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xC7); bb_write_u8(cg.code, 0x40); bb_write_u8(cg.code, 0x08); bb_write_u32(cg.code, inst.int_val);
            bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x83); bb_write_u8(cg.code, 0xC0); bb_write_u8(cg.code, 0x10);
            cg_mov_local_reg(cg, inst.dest, 0);
        } else if inst.op == IR_OP_ALLOC_STACK {
            bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0xC7); bb_write_u8(cg.code, 0xC1);
            bb_write_u32(cg.code, inst.offset + 8);
            cg_call_sym(cg, "__gat_alloc_mem");
            cg_mov_local_reg(cg, inst.dest, 0);
        } else if inst.op == IR_OP_RETAIN {
            cg_mov_reg_local(cg, 1, inst.src1);
            cg_call_sym(cg, "__gat_retain");
        } else if inst.op == IR_OP_RELEASE {
            cg_mov_reg_local(cg, 1, inst.src1);
            cg_call_sym(cg, "__gat_release");
        } else if inst.op == IR_OP_CALL {
            if inst.arg_count >= 1 { cg_mov_reg_local(cg, 1, inst.src1); }
            if inst.arg_count >= 2 { cg_mov_reg_local(cg, 2, inst.src2); }
            if inst.arg_count >= 3 { cg_mov_reg_local(cg, 4, inst.offset); }
            if inst.arg_count >= 4 { cg_mov_reg_local(cg, 5, inst.int_val); }
            if inst.arg_count >= 5 {
                cg_mov_reg_local(cg, 0, inst.extra);
                bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0x44); bb_write_u8(cg.code, 0x24); bb_write_u8(cg.code, 0x20); // mov [rsp+0x20], rax
            }
            let callee = inst.str_val;
            if str_eq(callee, "read_file") { callee = "__gat_read_file"; }
            else if str_eq(callee, "write_file") { callee = "__gat_write_file"; }
            else if str_eq(callee, "alloc_mem") { callee = "__gat_alloc_mem"; }
            else if str_eq(callee, "free_mem") { callee = "__gat_free_mem"; }
            else if str_eq(callee, "str_len") { callee = "__gat_str_len"; }
            else if str_eq(callee, "str_eq") { callee = "__gat_str_eq"; }
            else if str_eq(callee, "str_char") { callee = "__gat_str_char"; }
            else if str_eq(callee, "str_sub") { callee = "__gat_str_sub"; }
            else if str_eq(callee, "str_concat") { callee = "__gat_str_concat"; }
            else if str_eq(callee, "str_from_int") { callee = "__gat_str_from_int"; }
            else if str_eq(callee, "get_cmd_arg") { callee = "__gat_get_cmd_arg"; }
            cg_call_sym(cg, callee);
            if inst.dest != 0 {
                cg_mov_local_reg(cg, inst.dest, 0);
            }
        } else if inst.op == IR_OP_PRINT {
            cg_mov_reg_local(cg, 1, inst.src1);
            if inst.type_kind == TYPE_STRING {
                cg_call_sym(cg, "__gat_print_str");
            } else if inst.type_kind == TYPE_BOOL {
                cg_call_sym(cg, "__gat_print_bool");
            } else {
                cg_call_sym(cg, "__gat_print_i64");
            }
        } else if inst.op == IR_OP_RETURN {
            cg_mov_reg_local(cg, 0, inst.src1);
            bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0xEC);
            bb_write_u8(cg.code, 0x5D);
            bb_write_u8(cg.code, 0xC3);
        } else if inst.op == IR_OP_LABEL {
            cg_define_sym(cg, inst.label);
        } else if inst.op == IR_OP_JUMP {
            bb_write_u8(cg.code, 0xE9);
            cg_reloc(cg, inst.label, 1);
        } else if inst.op == IR_OP_BRANCH {
            cg_mov_reg_local(cg, 0, inst.src1);
            bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x85); bb_write_u8(cg.code, 0xC0);
            bb_write_u8(cg.code, 0x0F); bb_write_u8(cg.code, 0x84);
            cg_reloc(cg, inst.label, 1);
        }
        inst = inst.next;
    }

    // Default epilogue: mov rsp, rbp; pop rbp; ret
    bb_write_u8(cg.code, 0x48); bb_write_u8(cg.code, 0x89); bb_write_u8(cg.code, 0xEC);
    bb_write_u8(cg.code, 0x5D);
    bb_write_u8(cg.code, 0xC3);
}

// ----------------------------------------------------------------------------
// 9. PE Binary Emitter
// ----------------------------------------------------------------------------

fn pe_build_executable(ir_ctx: IRContext, cg: CodeGen, out_path: string) -> bool {
    let out_buf = bb_new(8192);

    let file_align: i64 = 0x200;   // 512
    let sec_align: i64 = 0x1000;   // 4096

    // Prepare .rdata
    let rdata = bb_new(4096);

    let rdata_str_true_off = rdata.size;
    bb_write_str(rdata, "true"); bb_write_u8(rdata, 0);

    let rdata_str_false_off = rdata.size;
    bb_write_str(rdata, "false"); bb_write_u8(rdata, 0);

    let rdata_str_empty_off = rdata.size;
    bb_write_str(rdata, ""); bb_write_u8(rdata, 0);

    let sc = ir_ctx.strings_head;
    while sc != nil {
        sc.rdata_offset = rdata.size;
        bb_write_str(rdata, sc.val);
        bb_write_u8(rdata, 0);
        sc = sc.next;
    }
    bb_align_up(rdata, 8);

    // IAT
    let iat_start = rdata.size;
    let num_imports: i64 = 11;
    let i: i64 = 0;
    while i <= num_imports {
        bb_write_u64(rdata, 0);
        i = i + 1;
    }

    // ILT
    let ilt_start = rdata.size;
    i = 0;
    while i <= num_imports {
        bb_write_u64(rdata, 0);
        i = i + 1;
    }

    // Import Directory Descriptor
    let import_dir_offset = rdata.size;
    bb_write_zeros(rdata, 40);

    // DLL name string
    let dll_name_offset = rdata.size;
    bb_write_str(rdata, "KERNEL32.dll"); bb_write_u8(rdata, 0);
    bb_align_up(rdata, 2);

    // Hint/Name Table
    let hn_offsets = bb_new(128);
    let imp_names = "ExitProcess,GetStdHandle,WriteFile,GetProcessHeap,HeapAlloc,HeapFree,CreateFileA,ReadFile,CloseHandle,GetFileSizeEx,GetCommandLineA,";
    let imp_start = 0;
    i = 0;
    while i < str_len(imp_names) {
        if str_char(imp_names, i) == 44 { // ','
            let name = str_sub(imp_names, imp_start, i - imp_start);
            bb_write_u64(hn_offsets, rdata.size);
            bb_write_u16(rdata, 0); // Hint
            bb_write_str(rdata, name);
            bb_write_u8(rdata, 0);
            bb_align_up(rdata, 2);
            imp_start = i + 1;
        }
        i = i + 1;
    }

    let header_size = 0x400;
    let text_rva = sec_align;
    let text_raw_size = align_val(cg.code.size, file_align);
    let text_size = align_val(cg.code.size, sec_align);

    let rdata_rva = text_rva + text_size;
    let rdata_raw_size = align_val(rdata.size, file_align);
    let rdata_size = align_val(rdata.size, sec_align);

    let image_size = rdata_rva + rdata_size;

    // Patch RVAs: ILT & IAT
    i = 0;
    while i < num_imports {
        let p_hn: raw i8 = hn_offsets.data;
        let b0 = p_hn[i * 8]; if b0 < 0 { b0 = b0 + 256; }
        let b1 = p_hn[i * 8 + 1]; if b1 < 0 { b1 = b1 + 256; }
        let b2 = p_hn[i * 8 + 2]; if b2 < 0 { b2 = b2 + 256; }
        let b3 = p_hn[i * 8 + 3]; if b3 < 0 { b3 = b3 + 256; }
        let hn_val = b0 + b1 * 256 + b2 * 65536 + b3 * 16777216;
        let rva_val = rdata_rva + hn_val;

        let p_ilt: raw i8 = rdata.data;
        let ilt_pos = ilt_start + i * 8;
        p_ilt[ilt_pos] = rva_val;
        p_ilt[ilt_pos + 1] = rva_val / 256;
        p_ilt[ilt_pos + 2] = rva_val / 65536;
        p_ilt[ilt_pos + 3] = (rva_val / 65536) / 256;

        let iat_pos = iat_start + i * 8;
        p_ilt[iat_pos] = rva_val;
        p_ilt[iat_pos + 1] = rva_val / 256;
        p_ilt[iat_pos + 2] = rva_val / 65536;
        p_ilt[iat_pos + 3] = (rva_val / 65536) / 256;

        i = i + 1;
    }

    // Patch Descriptor
    let p_desc: raw i8 = rdata.data;
    let d_ilt = rdata_rva + ilt_start;
    p_desc[import_dir_offset + 0] = d_ilt;
    p_desc[import_dir_offset + 1] = d_ilt / 256;
    p_desc[import_dir_offset + 2] = d_ilt / 65536;
    p_desc[import_dir_offset + 3] = (d_ilt / 65536) / 256;

    let d_name = rdata_rva + dll_name_offset;
    p_desc[import_dir_offset + 12] = d_name;
    p_desc[import_dir_offset + 13] = d_name / 256;
    p_desc[import_dir_offset + 14] = d_name / 65536;
    p_desc[import_dir_offset + 15] = (d_name / 65536) / 256;

    let d_iat = rdata_rva + iat_start;
    p_desc[import_dir_offset + 16] = d_iat;
    p_desc[import_dir_offset + 17] = d_iat / 256;
    p_desc[import_dir_offset + 18] = d_iat / 65536;
    p_desc[import_dir_offset + 19] = (d_iat / 65536) / 256;

    // Resolve Relocations
    let rel = cg.relocs_head;
    while rel != nil {
        let p_code: raw i8 = cg.code.data;
        let target_rva: i64 = 0;

        if rel.kind == 1 { // RIP relative (within .text or to .rdata)
            if str_eq(rel.sym, "str_true_const") {
                target_rva = rdata_rva + rdata_str_true_off;
            } else if str_eq(rel.sym, "str_false_const") {
                target_rva = rdata_rva + rdata_str_false_off;
            } else if str_eq(rel.sym, "str_empty_const") {
                target_rva = rdata_rva + rdata_str_empty_off;
            } else if str_len(rel.sym) > 4 && str_char(rel.sym, 0) == 115 && str_char(rel.sym, 1) == 116 && str_char(rel.sym, 2) == 114 && str_char(rel.sym, 3) == 95 {
                let sc_cur = ir_ctx.strings_head;
                while sc_cur != nil {
                    if str_eq(sc_cur.label, rel.sym) {
                        target_rva = rdata_rva + sc_cur.rdata_offset;
                    }
                    sc_cur = sc_cur.next;
                }
            } else {
                let sym_cur = cg.syms_head;
                while sym_cur != nil {
                    if str_eq(sym_cur.name, rel.sym) {
                        target_rva = text_rva + sym_cur.offset;
                    }
                    sym_cur = sym_cur.next;
                }
            }

            let from_rva = text_rva + rel.offset + 4;
            let diff = target_rva - from_rva;
            let u_diff = diff;
            if u_diff < 0 {
                u_diff = u_diff + 65536 * 65536;
            }
            p_code[rel.offset + 0] = u_diff;
            p_code[rel.offset + 1] = u_diff / 256;
            p_code[rel.offset + 2] = u_diff / 65536;
            p_code[rel.offset + 3] = (u_diff / 65536) / 256;
        } else if rel.kind == 2 { // IAT relative
            let imp_idx = 0;
            if str_eq(rel.sym, "__iat_ExitProcess") { imp_idx = 0; }
            else if str_eq(rel.sym, "__iat_GetStdHandle") { imp_idx = 1; }
            else if str_eq(rel.sym, "__iat_WriteFile") { imp_idx = 2; }
            else if str_eq(rel.sym, "__iat_GetProcessHeap") { imp_idx = 3; }
            else if str_eq(rel.sym, "__iat_HeapAlloc") { imp_idx = 4; }
            else if str_eq(rel.sym, "__iat_HeapFree") { imp_idx = 5; }
            else if str_eq(rel.sym, "__iat_CreateFileA") { imp_idx = 6; }
            else if str_eq(rel.sym, "__iat_ReadFile") { imp_idx = 7; }
            else if str_eq(rel.sym, "__iat_CloseHandle") { imp_idx = 8; }
            else if str_eq(rel.sym, "__iat_GetFileSizeEx") { imp_idx = 9; }
            else if str_eq(rel.sym, "__iat_GetCommandLineA") { imp_idx = 10; }
            let iat_slot_rva = rdata_rva + iat_start + imp_idx * 8;
            let from_rva = text_rva + rel.offset + 4;
            let diff = iat_slot_rva - from_rva;
            let u_diff = diff;
            if u_diff < 0 {
                u_diff = u_diff + 65536 * 65536;
            }
            p_code[rel.offset + 0] = u_diff;
            p_code[rel.offset + 1] = u_diff / 256;
            p_code[rel.offset + 2] = u_diff / 65536;
            p_code[rel.offset + 3] = (u_diff / 65536) / 256;
        }

        rel = rel.next;
    }
    let main_offset: i64 = 0;
    let sym_cur = cg.syms_head;
    while sym_cur != nil {
        if str_eq(sym_cur.name, "main") {
            main_offset = sym_cur.offset;
        }
        sym_cur = sym_cur.next;
    }

    // DOS Header (64 bytes)
    bb_write_u8(out_buf, 77); bb_write_u8(out_buf, 90); // 'M', 'Z'
    bb_write_zeros(out_buf, 58);
    bb_write_u32(out_buf, 0x80);

    // DOS Stub (64 bytes)
    bb_write_zeros(out_buf, 64);

    // PE Signature (4 bytes)
    bb_write_u8(out_buf, 80); bb_write_u8(out_buf, 69); bb_write_u8(out_buf, 0); bb_write_u8(out_buf, 0);

    // COFF Header (20 bytes)
    bb_write_u16(out_buf, 0x8664); // AMD64
    bb_write_u16(out_buf, 2);      // 2 sections
    bb_write_u32(out_buf, 0);
    bb_write_u32(out_buf, 0);
    bb_write_u32(out_buf, 0);
    bb_write_u16(out_buf, 0xF0);
    bb_write_u16(out_buf, 0x0022);

    // Optional Header Standard Fields
    bb_write_u16(out_buf, 0x020B);              // PE32+
    bb_write_u8(out_buf, 1); bb_write_u8(out_buf, 0);
    bb_write_u32(out_buf, text_raw_size);
    bb_write_u32(out_buf, rdata_raw_size);
    bb_write_u32(out_buf, 0);
    bb_write_u32(out_buf, text_rva); // Entry point (__gat_entry trampoline)
    bb_write_u32(out_buf, text_rva);

    // Windows Specific Fields
    bb_write_u64(out_buf, 0x0000000140000000);
    bb_write_u32(out_buf, sec_align);
    bb_write_u32(out_buf, file_align);
    bb_write_u16(out_buf, 6); bb_write_u16(out_buf, 0);
    bb_write_u16(out_buf, 0); bb_write_u16(out_buf, 0);
    bb_write_u16(out_buf, 6); bb_write_u16(out_buf, 0);
    bb_write_u32(out_buf, 0);
    bb_write_u32(out_buf, image_size);
    bb_write_u32(out_buf, header_size);
    bb_write_u32(out_buf, 0);
    bb_write_u16(out_buf, 3); // Console
    bb_write_u16(out_buf, 0x8160);
    bb_write_u64(out_buf, 0x800000);
    bb_write_u64(out_buf, 0x800000);
    bb_write_u64(out_buf, 0x100000);
    bb_write_u64(out_buf, 0x1000);
    bb_write_u32(out_buf, 0);
    bb_write_u32(out_buf, 16);

    // Data Directories
    bb_write_u64(out_buf, 0); // Export
    bb_write_u32(out_buf, rdata_rva + import_dir_offset); // Import
    bb_write_u32(out_buf, 40);
    let dir_idx = 2;
    while dir_idx < 12 {
        bb_write_u64(out_buf, 0);
        dir_idx = dir_idx + 1;
    }
    bb_write_u32(out_buf, rdata_rva + iat_start); // IAT
    bb_write_u32(out_buf, (num_imports + 1) * 8);
    bb_write_u64(out_buf, 0);
    bb_write_u64(out_buf, 0);
    bb_write_u64(out_buf, 0);

    // Section Headers
    bb_write_str(out_buf, ".text"); bb_write_zeros(out_buf, 3);
    bb_write_u32(out_buf, cg.code.size);
    bb_write_u32(out_buf, text_rva);
    bb_write_u32(out_buf, text_raw_size);
    bb_write_u32(out_buf, header_size);
    bb_write_u32(out_buf, 0);
    bb_write_u32(out_buf, 0);
    bb_write_u16(out_buf, 0);
    bb_write_u16(out_buf, 0);
    bb_write_u32(out_buf, 0x60000020);

    bb_write_str(out_buf, ".rdata"); bb_write_zeros(out_buf, 2);
    bb_write_u32(out_buf, rdata.size);
    bb_write_u32(out_buf, rdata_rva);
    bb_write_u32(out_buf, rdata_raw_size);
    bb_write_u32(out_buf, header_size + text_raw_size);
    bb_write_u32(out_buf, 0);
    bb_write_u32(out_buf, 0);
    bb_write_u16(out_buf, 0);
    bb_write_u16(out_buf, 0);
    bb_write_u32(out_buf, 0xC0000040);

    while out_buf.size < header_size {
        bb_write_u8(out_buf, 0);
    }
    bb_write_bytes(out_buf, cg.code.data, cg.code.size);
    while out_buf.size < header_size + text_raw_size {
        bb_write_u8(out_buf, 0);
    }
    bb_write_bytes(out_buf, rdata.data, rdata.size);
    while out_buf.size < header_size + text_raw_size + rdata_raw_size {
        bb_write_u8(out_buf, 0);
    }

    let written = write_file(out_path, out_buf.data, out_buf.size);
    if written > 0 {
        return true;
    }
    return false;
}

// ----------------------------------------------------------------------------
// 10. Main Driver
// ----------------------------------------------------------------------------

fn main() -> i64 {
    let src_path = get_cmd_arg(1);
    if str_len(src_path) == 0 {
        print("Usage: gatc <source.gat> -o <output.exe>\n");
        return 1;
    }

    let out_path = "output.exe";
    let arg2 = get_cmd_arg(2);
    let arg3 = get_cmd_arg(3);
    if str_eq(arg2, "-o") && str_len(arg3) > 0 {
        out_path = arg3;
    }

    let src = read_file(src_path);
    if str_len(src) == 0 {
        print("[Error] Failed to read source file: ", src_path, "\n");
        return 1;
    }

    let l = lexer_new(src);
    let p = parser_new(l);
    let prog = parse_program(p);

    let tc = tc_new();
    let d = prog.child;
    while d != nil {
        tc_register_decl(tc, d);
        d = d.next;
    }

    let ir_ctx = ir_new(tc);
    ir_build_program(ir_ctx, prog);

    let cg = cg_new();
    cg_emit_runtime(cg);
    let fn_cur = ir_ctx.funcs_head;
    while fn_cur != nil {
        cg_emit_function(cg, fn_cur);
        fn_cur = fn_cur.next;
    }

    let success = pe_build_executable(ir_ctx, cg, out_path);
    if success {
        return 0;
    } else {
        print("[Error] Failed to write PE binary: ", out_path, "\n");
        return 1;
    }
}
