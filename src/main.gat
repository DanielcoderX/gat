// ============================================================================
// src/main.gat - Main Driver
// ============================================================================

// ----------------------------------------------------------------------------
// 10. Main Driver
// ----------------------------------------------------------------------------

fn main() -> i64 {
    let src_path = "";
    let out_path = "output.exe";
    let target_backend: TargetBackend = target_get_windows();
    let target_override = false;
    let is_check_only: i64 = 0;

    let arg_idx: i64 = 1;
    while arg_idx <= 8 {
        let arg = get_cmd_arg(arg_idx);
        if str_len(arg) > 0 {
            if str_eq(arg, "-o") {
                arg_idx = arg_idx + 1;
                let next_arg = get_cmd_arg(arg_idx);
                if str_len(next_arg) > 0 {
                    out_path = next_arg;
                }
            } else if str_eq(arg, "--check") || str_eq(arg, "-c") {
                is_check_only = 1;
            } else if str_eq(arg, "--target") || str_eq(arg, "-t") {
                arg_idx = arg_idx + 1;
                let next_target = get_cmd_arg(arg_idx);
                if str_len(next_target) > 0 {
                    target_backend = target_from_name(next_target);
                    target_override = true;
                }
            } else if str_starts_with_prefix(arg, "--target=") {
                let t_name = str_sub(arg, 9, str_len(arg) - 9);
                target_backend = target_from_name(t_name);
                target_override = true;
            } else if str_eq(arg, "--explain") {
                arg_idx = arg_idx + 1;
                let code_arg = get_cmd_arg(arg_idx);
                if str_len(code_arg) == 0 {
                    code_arg = "list";
                }
                print_explain(code_arg);
                return 0;
            } else if str_starts_with_prefix(arg, "--explain=") {
                let code_arg = str_sub(arg, 10, str_len(arg) - 10);
                if str_len(code_arg) == 0 {
                    code_arg = "list";
                }
                print_explain(code_arg);
                return 0;
            } else if str_len(src_path) == 0 && str_starts_with_prefix(arg, "-") == false {
                src_path = arg;
            }
        }
        arg_idx = arg_idx + 1;
    }

    if str_len(src_path) == 0 {
        print("Usage: gatc <source.gat> -o <output.exe>\n");
        print("       gatc --explain <E0001..E0010|list>\n");
        return 1;
    }

    if target_override == false {
        let tdir = get_temp_dir();
        if str_starts_with_prefix(tdir, "/") {
            target_backend = target_get_macos_arm64();
            if str_eq(out_path, "output.exe") {
                out_path = "output.o";
            }
        } else {
            target_backend = target_get_windows();
        }
    }

    print("[gatc] target: ", target_backend.name, " out: ", out_path, " override: ", target_override, "\n");

    let src = read_file(src_path);
    if str_len(src) == 0 {
        print("[Error] Failed to read source file: ", src_path, "\n");
        return 1;
    }

    let l = lexer_new(src);
    let p = parser_new(l);
    let raw_prog = parse_program(p);
    if p.had_error == 1 || raw_prog == nil {
        print("[Error] Parsing failed due to syntax errors.\n");
        return 1;
    }

    let loaded_files = new FileList {
        path: src_path,
        next: nil
    };
    let prog = resolve_imports(raw_prog, loaded_files);
    if prog == nil {
        print("[Error] Import resolution failed.\n");
        return 1;
    }

    let tc = tc_new();
    let d = prog.child;
    while d != nil {
        tc_register_decl(tc, d);
        d = d.next;
    }

    tc_check_program(tc, prog);
    if tc.had_error == 1 {
        print("[Error] Type checking failed due to semantic errors.\n");
        return 1;
    }

    if is_check_only == 1 {
        return 0;
    }

    let ir_ctx = ir_new(tc);
    ir_build_program(ir_ctx, prog);
    opt_optimize_program(ir_ctx);

    let is_aarch64 = target_is_arm64(target_backend);

    let cg: CodeGen = cg_new_target(target_backend);
    if is_aarch64 {
        cg_arm64_emit_runtime(cg);
    } else {
        cg_emit_runtime(cg);
    }

    let fn_cur = ir_ctx.funcs_head;
    while fn_cur != nil {
        if is_aarch64 {
            cg_arm64_emit_function(cg, fn_cur);
        } else {
            cg_emit_function(cg, fn_cur);
        }
        fn_cur = fn_cur.next;
    }

    let success = false;
    if target_is_macos(target_backend) {
        success = macho_build_executable(ir_ctx, cg, out_path);
    } else if target_is_linux(target_backend) {
        success = elf_build_executable(ir_ctx, cg, out_path);
    } else {
        success = pe_build_executable(ir_ctx, cg, out_path);
    }

    if success {
        return 0;
    } else {
        print("[Error] Failed to write executable binary: ", out_path, "\n");
        return 1;
    }
}

