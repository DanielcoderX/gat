// CMP Xn, Xm (SUBS XZR, Xn, Xm)
fn a64_cmp_reg(code: ByteBuffer, rn: i64, rm: i64) {
    let inst: i64 = 3942645791 + (rm * 65536) + (rn * 32);
    a64_emit(code, inst);
}

// CMP Xn, #imm12 (SUBS XZR, Xn, #imm12)
fn a64_cmp_imm(code: ByteBuffer, rn: i64, imm12: i64) {
    let imm = imm12 % 4096;
    let inst: i64 = 4043309087 + (imm * 1024) + (rn * 32);
    a64_emit(code, inst);
}

// CSET Xd, cond (CSINC Xd, XZR, XZR, invert(cond))
fn a64_cset(code: ByteBuffer, rd: i64, cond: i64) {
    let inv_cond = cond;
    if cond == A64_COND_EQ { inv_cond = A64_COND_NE; }
    else if cond == A64_COND_NE { inv_cond = A64_COND_EQ; }
    else if cond == A64_COND_GE { inv_cond = A64_COND_LT; }
    else if cond == A64_COND_LT { inv_cond = A64_COND_GE; }
    else if cond == A64_COND_GT { inv_cond = A64_COND_LE; }
    else if cond == A64_COND_LE { inv_cond = A64_COND_GT; }
    else if cond == A64_COND_CS { inv_cond = A64_COND_CC; }
    else if cond == A64_COND_CC { inv_cond = A64_COND_CS; }

    let inst: i64 = 2594113504 + (inv_cond * 4096) + rd;
    a64_emit(code, inst);
}

// B offset_words (signed 26-bit)
fn a64_b(code: ByteBuffer, offset_words: i64) {
    let off = offset_words;
    if off < 0 { off = off + 67108864; }
    off = off % 67108864;
    let inst: i64 = 335544320 + off;
    a64_emit(code, inst);
}

// BL offset_words (signed 26-bit)
fn a64_bl(code: ByteBuffer, offset_words: i64) {
    let off = offset_words;
    if off < 0 { off = off + 67108864; }
    off = off % 67108864;
    let inst: i64 = 2483027968 + off;
    a64_emit(code, inst);
}

// BLR Xn
fn a64_blr(code: ByteBuffer, rn: i64) {
    let inst: i64 = 3594452992 + (rn * 32);
    a64_emit(code, inst);
}

// B.cond offset_words (signed 19-bit)
fn a64_b_cond(code: ByteBuffer, cond: i64, offset_words: i64) {
    let off = offset_words;
    if off < 0 { off = off + 524288; }
    off = off % 524288;
    let inst: i64 = 1409286144 + (off * 32) + cond;
    a64_emit(code, inst);
}

// RET Xn (default LR / X30)
fn a64_ret(code: ByteBuffer, rn: i64) {
    let inst: i64 = 3596550144 + (rn * 32);
    a64_emit(code, inst);
}

// SVC #0
fn a64_svc(code: ByteBuffer) {
    a64_emit(code, 3556769793);
}

// SVC #0x80 (Darwin / macOS Apple Silicon)
fn a64_svc_darwin(code: ByteBuffer) {
    a64_emit(code, 3556773889);
}

// ADRP Rd, imm21
fn a64_adrp(code: ByteBuffer, rd: i64, imm21: i64) {
    let immlo = imm21 % 4;
    let immhi = (imm21 / 4) % 524288;
    let inst: i64 = 2415919104 + (immlo * 536870912) + (immhi * 32) + rd;
    a64_emit(code, inst);
}




