fn a64_sub_imm(code: ByteBuffer, rd: i64, rn: i64, imm12: i64) {
    let imm = imm12 % 4096;
    let inst: i64 = 3506438144 + (imm * 1024) + (rn * 32) + rd;
    a64_emit(code, inst);
}

