fn a64_ldrb_imm(code: ByteBuffer, rd: i64, rn: i64, offset: i64) {
    let imm = offset % 4096;
    let inst: i64 = 959447040 + (imm * 1024) + (rn * 32) + rd;
    a64_emit(code, inst);
}

