// ============================================================================
// src/arm64.gat - AArch64 (ARM64) 32-bit Machine Instruction Encoder
// ============================================================================

let A64_X0: i64 = 0;
let A64_X1: i64 = 1;
let A64_X2: i64 = 2;
let A64_X3: i64 = 3;
let A64_X4: i64 = 4;
let A64_X5: i64 = 5;
let A64_X6: i64 = 6;
let A64_X7: i64 = 7;
let A64_X8: i64 = 8;
let A64_X9: i64 = 9;
let A64_X10: i64 = 10;
let A64_X11: i64 = 11;
let A64_X12: i64 = 12;
let A64_X13: i64 = 13;
let A64_X14: i64 = 14;
let A64_X15: i64 = 15;
let A64_X16: i64 = 16;
let A64_X17: i64 = 17;
let A64_X18: i64 = 18;
let A64_X19: i64 = 19;
let A64_X20: i64 = 20;
let A64_X21: i64 = 21;
let A64_X22: i64 = 22;
let A64_X23: i64 = 23;
let A64_X24: i64 = 24;
let A64_X25: i64 = 25;
let A64_X26: i64 = 26;
let A64_X27: i64 = 27;
let A64_X28: i64 = 28;
let A64_FP: i64 = 29;
let A64_LR: i64 = 30;
let A64_SP: i64 = 31;
let A64_XZR: i64 = 31;

let A64_COND_EQ: i64 = 0;
let A64_COND_NE: i64 = 1;
let A64_COND_CS: i64 = 2;
let A64_COND_CC: i64 = 3;
let A64_COND_GE: i64 = 10;
let A64_COND_LT: i64 = 11;
let A64_COND_GT: i64 = 12;
let A64_COND_LE: i64 = 13;

fn a64_emit(code: ByteBuffer, inst: i64) {
    bb_write_u32(code, inst);
}



// MOV Xd, Xm (via ORR Xd, XZR, Xm)
fn a64_mov_reg(code: ByteBuffer, rd: i64, rm: i64) {
    if rd == rm { return; }
    let inst: i64 = 2852127712 + (rm * 65536) + rd;
    a64_emit(code, inst);
}

// MOVZ Xd, #imm16, LSL #(hw * 16)
fn a64_movz(code: ByteBuffer, rd: i64, imm16: i64, hw: i64) {
    let imm = imm16;
    if imm < 0 { imm = imm + 65536; }
    imm = imm % 65536;
    let inst: i64 = 3531603968 + (hw * 2097152) + (imm * 32) + rd;
    a64_emit(code, inst);
}

// MOVK Xd, #imm16, LSL #(hw * 16)
fn a64_movk(code: ByteBuffer, rd: i64, imm16: i64, hw: i64) {
    let imm = imm16;
    if imm < 0 { imm = imm + 65536; }
    imm = imm % 65536;
    let inst: i64 = 4068474880 + (hw * 2097152) + (imm * 32) + rd;
    a64_emit(code, inst);
}

// Materialize arbitrary 64-bit constant into Rd
fn a64_mov_imm(code: ByteBuffer, rd: i64, val: i64) {
    if val >= 0 && val <= 65535 {
        a64_movz(code, rd, val, 0);
        return;
    }
    let uval = val;
    let is_neg = false;
    if uval < 0 {
        is_neg = true;
    }

    let p0 = uval % 65536;
    if p0 < 0 { p0 = p0 + 65536; }
    let rem1 = (uval - p0) / 65536;
    let p1 = rem1 % 65536;
    if p1 < 0 { p1 = p1 + 65536; }
    let rem2 = (rem1 - p1) / 65536;
    let p2 = rem2 % 65536;
    if p2 < 0 { p2 = p2 + 65536; }
    let rem3 = (rem2 - p2) / 65536;
    let p3 = rem3 % 65536;
    if p3 < 0 { p3 = p3 + 65536; }

    a64_movz(code, rd, p0, 0);
    if p1 != 0 || is_neg { a64_movk(code, rd, p1, 1); }
    if p2 != 0 || is_neg { a64_movk(code, rd, p2, 2); }
    if p3 != 0 || is_neg { a64_movk(code, rd, p3, 3); }
}

// ADD Xd, Xn, Xm
fn a64_add_reg(code: ByteBuffer, rd: i64, rn: i64, rm: i64) {
    let inst: i64 = 2332033024 + (rm * 65536) + (rn * 32) + rd;
    a64_emit(code, inst);
}

// ADD Xd, Xn, #imm12
fn a64_add_imm(code: ByteBuffer, rd: i64, rn: i64, imm12: i64) {
    let imm = imm12 % 4096;
    let inst: i64 = 2432696320 + (imm * 1024) + (rn * 32) + rd;
    a64_emit(code, inst);
}

