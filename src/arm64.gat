// LDR Xd, [Xn, #pimm] (scaled by 8)
fn a64_ldr_imm(code: ByteBuffer, rd: i64, rn: i64, offset: i64) {
    let scale = (offset / 8) % 4096;
    let inst: i64 = 4181721088 + (scale * 1024) + (rn * 32) + rd;
    a64_emit(code, inst);
}

// STR Xd, [Xn, #pimm] (scaled by 8)
fn a64_str_imm(code: ByteBuffer, rd: i64, rn: i64, offset: i64) {
    let scale = (offset / 8) % 4096;
    let inst: i64 = 4177526784 + (scale * 1024) + (rn * 32) + rd;
    a64_emit(code, inst);
}

