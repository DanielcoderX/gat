// ============================================================================
// src/lexer.gat - Lexer Implementation
// ============================================================================

// ----------------------------------------------------------------------------
// 4. Lexer Implementation
// ----------------------------------------------------------------------------

fn lexer_new(input: string) -> Lexer {
    let l = new Lexer {
        input: input,
        len: str_len(input),
        pos: 0,
        read_pos: 0,
        ch: 0,
        line: 1,
        col: 0
    };
    lexer_read_char(l);
    return l;
}

fn lexer_read_char(l: Lexer) {
    if l.read_pos >= l.len {
        l.ch = 0;
    } else {
        l.ch = str_char(l.input, l.read_pos);
    }
    l.pos = l.read_pos;
    l.read_pos = l.read_pos + 1;
    l.col = l.col + 1;
}

fn lexer_peek_char(l: Lexer) -> i64 {
    if l.read_pos >= l.len {
        return 0;
    }
    return str_char(l.input, l.read_pos);
}

fn is_letter(ch: i64) -> bool {
    if (ch >= 65 && ch <= 90) || (ch >= 97 && ch <= 122) || ch == 95 {
        return true;
    }
    return false;
}

fn is_digit(ch: i64) -> bool {
    if ch >= 48 && ch <= 57 {
        return true;
    }
    return false;
}

fn is_hex_digit(ch: i64) -> bool {
    if is_digit(ch) || (ch >= 65 && ch <= 70) || (ch >= 97 && ch <= 102) {
        return true;
    }
    return false;
}

fn lexer_skip_whitespace(l: Lexer) {
    while l.ch == 32 || l.ch == 9 || l.ch == 10 || l.ch == 13 || l.ch == 47 {
        if l.ch == 10 {
            l.line = l.line + 1;
            l.col = 0;
            lexer_read_char(l);
        } else if l.ch == 47 {
            let next_ch = lexer_peek_char(l);
            if next_ch == 47 {
                // Line comment //
                while l.ch != 10 && l.ch != 0 {
                    lexer_read_char(l);
                }
            } else if next_ch == 42 {
                // Block comment /* ... */
                lexer_read_char(l);
                lexer_read_char(l);
                let inside = true;
                while inside && l.ch != 0 {
                    if l.ch == 10 {
                        l.line = l.line + 1;
                        l.col = 0;
                    }
                    if l.ch == 42 && lexer_peek_char(l) == 47 {
                        inside = false;
                        lexer_read_char(l);
                        lexer_read_char(l);
                    } else {
                        lexer_read_char(l);
                    }
                }
            } else {
                return;
            }
        } else {
            lexer_read_char(l);
        }
    }
}

fn lookup_keyword(ident: string) -> i64 {
    if str_eq(ident, "fn") { return TOK_FN; }
    if str_eq(ident, "let") { return TOK_LET; }
    if str_eq(ident, "struct") { return TOK_STRUCT; }
    if str_eq(ident, "class") { return TOK_CLASS; }
    if str_eq(ident, "enum") { return TOK_ENUM; }
    if str_eq(ident, "match") { return TOK_MATCH; }
    if str_eq(ident, "deinit") { return TOK_DEINIT; }
    if str_eq(ident, "return") { return TOK_RETURN; }
    if str_eq(ident, "if") { return TOK_IF; }
    if str_eq(ident, "else") { return TOK_ELSE; }
    if str_eq(ident, "while") { return TOK_WHILE; }
    if str_eq(ident, "new") { return TOK_NEW; }
    if str_eq(ident, "raw") { return TOK_RAW; }
    if str_eq(ident, "weak") { return TOK_WEAK; }
    if str_eq(ident, "print") { return TOK_PRINT; }
    if str_eq(ident, "true") { return TOK_TRUE; }
    if str_eq(ident, "false") { return TOK_FALSE; }
    if str_eq(ident, "import") { return TOK_IMPORT; }
    if str_eq(ident, "for") { return TOK_FOR; }
    if str_eq(ident, "in") { return TOK_IN; }
    if str_eq(ident, "as") { return TOK_AS; }
    return TOK_IDENT;
}

fn lexer_next_token(l: Lexer) -> Token {
    lexer_skip_whitespace(l);

    let tok = new Token {
        kind: TOK_EOF,
        lit: "",
        val_i64: 0,
        line: l.line,
        col: l.col,
        next: nil
    };

    if l.ch == 0 {
        return tok;
    }

    if l.ch == 43 { tok.kind = TOK_PLUS; tok.lit = "+"; lexer_read_char(l); return tok; }
    if l.ch == 45 {
        if lexer_peek_char(l) == 62 {
            lexer_read_char(l);
            lexer_read_char(l);
            tok.kind = TOK_ARROW;
            tok.lit = "->";
            return tok;
        }
        tok.kind = TOK_MINUS; tok.lit = "-"; lexer_read_char(l); return tok;
    }
    if l.ch == 42 { tok.kind = TOK_STAR; tok.lit = "*"; lexer_read_char(l); return tok; }
    if l.ch == 47 { tok.kind = TOK_SLASH; tok.lit = "/"; lexer_read_char(l); return tok; }
    if l.ch == 37 { tok.kind = TOK_PERCENT; tok.lit = "%"; lexer_read_char(l); return tok; }
    if l.ch == 46 {
        if lexer_peek_char(l) == 46 {
            lexer_read_char(l);
            lexer_read_char(l);
            tok.kind = TOK_DOTDOT;
            tok.lit = "..";
            return tok;
        }
        tok.kind = TOK_DOT; tok.lit = "."; lexer_read_char(l); return tok;
    }
    if l.ch == 44 { tok.kind = TOK_COMMA; tok.lit = ","; lexer_read_char(l); return tok; }
    if l.ch == 58 { tok.kind = TOK_COLON; tok.lit = ":"; lexer_read_char(l); return tok; }
    if l.ch == 59 { tok.kind = TOK_SEMICOLON; tok.lit = ";"; lexer_read_char(l); return tok; }
    if l.ch == 40 { tok.kind = TOK_LPAREN; tok.lit = "("; lexer_read_char(l); return tok; }
    if l.ch == 41 { tok.kind = TOK_RPAREN; tok.lit = ")"; lexer_read_char(l); return tok; }
    if l.ch == 123 { tok.kind = TOK_LBRACE; tok.lit = "{"; lexer_read_char(l); return tok; }
    if l.ch == 125 { tok.kind = TOK_RBRACE; tok.lit = "}"; lexer_read_char(l); return tok; }
    if l.ch == 91 { tok.kind = TOK_LBRACKET; tok.lit = "["; lexer_read_char(l); return tok; }
    if l.ch == 93 { tok.kind = TOK_RBRACKET; tok.lit = "]"; lexer_read_char(l); return tok; }

    if l.ch == 61 {
        if lexer_peek_char(l) == 61 {
            lexer_read_char(l);
            lexer_read_char(l);
            tok.kind = TOK_EQ;
            tok.lit = "==";
            return tok;
        } else if lexer_peek_char(l) == 62 {
            lexer_read_char(l);
            lexer_read_char(l);
            tok.kind = TOK_FAT_ARROW;
            tok.lit = "=>";
            return tok;
        }
        tok.kind = TOK_ASSIGN; tok.lit = "="; lexer_read_char(l); return tok;
    }
    if l.ch == 33 {
        if lexer_peek_char(l) == 61 {
            lexer_read_char(l);
            lexer_read_char(l);
            tok.kind = TOK_NOT_EQ;
            tok.lit = "!=";
            return tok;
        }
        tok.kind = TOK_BANG; tok.lit = "!"; lexer_read_char(l); return tok;
    }
    if l.ch == 60 {
        if lexer_peek_char(l) == 61 {
            lexer_read_char(l);
            lexer_read_char(l);
            tok.kind = TOK_LTE;
            tok.lit = "<=";
            return tok;
        }
        tok.kind = TOK_LT; tok.lit = "<"; lexer_read_char(l); return tok;
    }
    if l.ch == 62 {
        if lexer_peek_char(l) == 61 {
            lexer_read_char(l);
            lexer_read_char(l);
            tok.kind = TOK_GTE;
            tok.lit = ">=";
            return tok;
        }
        tok.kind = TOK_GT; tok.lit = ">"; lexer_read_char(l); return tok;
    }
    if l.ch == 38 && lexer_peek_char(l) == 38 {
        lexer_read_char(l);
        lexer_read_char(l);
        tok.kind = TOK_AND;
        tok.lit = "&&";
        return tok;
    }
    if l.ch == 124 && lexer_peek_char(l) == 124 {
        lexer_read_char(l);
        lexer_read_char(l);
        tok.kind = TOK_OR;
        tok.lit = "||";
        return tok;
    }

    // String literals "..."
    if l.ch == 34 {
        lexer_read_char(l); // skip "
        let buf = bb_new(32);
        while l.ch != 34 && l.ch != 0 {
            if l.ch == 92 {
                lexer_read_char(l);
                if l.ch == 110 { bb_write_u8(buf, 10); }
                else if l.ch == 114 { bb_write_u8(buf, 13); }
                else if l.ch == 116 { bb_write_u8(buf, 9); }
                else if l.ch == 48 { bb_write_u8(buf, 0); }
                else if l.ch == 34 { bb_write_u8(buf, 34); }
                else if l.ch == 92 { bb_write_u8(buf, 92); }
                else { bb_write_u8(buf, l.ch); }
            } else {
                if l.ch == 10 {
                    l.line = l.line + 1;
                    l.col = 0;
                }
                bb_write_u8(buf, l.ch);
            }
            lexer_read_char(l);
        }
        if l.ch == 34 {
            lexer_read_char(l);
        }
        bb_write_u8(buf, 0);
        tok.kind = TOK_STRING;
        tok.lit = str_sub(buf.data, 0, buf.size - 1);
        free_mem(buf.data);
        return tok;
    }

    // Char literals '...'
    if l.ch == 39 {
        lexer_read_char(l);
        let ch_val = 0;
        if l.ch == 92 {
            lexer_read_char(l);
            if l.ch == 110 { ch_val = 10; }
            else if l.ch == 114 { ch_val = 13; }
            else if l.ch == 116 { ch_val = 9; }
            else if l.ch == 48 { ch_val = 0; }
            else if l.ch == 39 { ch_val = 39; }
            else if l.ch == 92 { ch_val = 92; }
            else { ch_val = l.ch; }
        } else {
            ch_val = l.ch;
        }
        lexer_read_char(l);
        if l.ch == 39 {
            lexer_read_char(l);
        }
        tok.kind = TOK_INT;
        tok.val_i64 = ch_val;
        tok.lit = str_from_int(ch_val);
        return tok;
    }

    // Number literals (Decimal or Hex)
    if is_digit(l.ch) {
        let num: i64 = 0;
        if l.ch == 48 && (lexer_peek_char(l) == 120 || lexer_peek_char(l) == 88) {
            lexer_read_char(l); // '0'
            lexer_read_char(l); // 'x'
            while is_hex_digit(l.ch) {
                let digit_val: i64 = 0;
                if l.ch >= 48 && l.ch <= 57 { digit_val = l.ch - 48; }
                else if l.ch >= 97 && l.ch <= 102 { digit_val = l.ch - 97 + 10; }
                else if l.ch >= 65 && l.ch <= 70 { digit_val = l.ch - 65 + 10; }
                num = num * 16 + digit_val;
                lexer_read_char(l);
            }
        } else {
            while is_digit(l.ch) {
                num = num * 10 + (l.ch - 48);
                lexer_read_char(l);
            }
        }
        tok.kind = TOK_INT;
        tok.val_i64 = num;
        tok.lit = str_from_int(num);
        return tok;
    }

    // Identifiers & Keywords
    if is_letter(l.ch) {
        let start = l.pos;
        while is_letter(l.ch) || is_digit(l.ch) {
            lexer_read_char(l);
        }
        let len = l.pos - start;
        let ident = str_sub(l.input, start, len);
        tok.lit = ident;
        tok.kind = lookup_keyword(ident);
        if tok.kind == TOK_TRUE {
            tok.val_i64 = 1;
        } else if tok.kind == TOK_FALSE {
            tok.val_i64 = 0;
        }
        return tok;
    }

    lexer_read_char(l);
    return tok;
}
