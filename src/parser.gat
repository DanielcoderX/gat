// ============================================================================
// src/parser.gat - Parser Implementation
// ============================================================================


// ----------------------------------------------------------------------------
// 5. Parser Implementation
// ----------------------------------------------------------------------------

fn parser_new(lex: Lexer) -> Parser {
    let p = new Parser {
        lex: lex,
        cur_tok: nil,
        peek_tok: nil,
        had_error: 0,
        context: ""
    };
    parser_next_token(p);
    parser_next_token(p);
    return p;
}

fn parser_next_token(p: Parser) {
    p.cur_tok = p.peek_tok;
    p.peek_tok = lexer_next_token(p.lex);
}

fn parser_cur_is(p: Parser, kind: i64) -> bool {
    if p.cur_tok == nil { return false; }
    return p.cur_tok.kind == kind;
}

fn parser_peek_is(p: Parser, kind: i64) -> bool {
    if p.peek_tok == nil { return false; }
    return p.peek_tok.kind == kind;
}

fn parser_report_error(p: Parser, line: i64, col: i64, expected: string, got: Token) {
    p.had_error = 1;
    let got_name = token_kind_name(got.kind);
    let got_lit = got.lit;
    print("[Parser Error] line ", line, ":", col, ": expected '", expected, "', got '", got_lit, "' (", got_name, ")");
    if str_len(p.context) > 0 {
        print(" while parsing ", p.context);
    }
    print("\n");
}

fn parser_expect_peek(p: Parser, kind: i64) -> bool {
    if parser_peek_is(p, kind) {
        parser_next_token(p);
        return true;
    }
    parser_report_error(p, p.peek_tok.line, p.peek_tok.col, token_kind_name(kind), p.peek_tok);
    return false;
}

// Precedence Table
let PREC_LOWEST: i64 = 1;
let PREC_OR: i64 = 2;
let PREC_AND: i64 = 3;
let PREC_EQUALS: i64 = 4;
let PREC_LESSGREATER: i64 = 5;
let PREC_SUM: i64 = 6;
let PREC_PRODUCT: i64 = 7;
let PREC_PREFIX: i64 = 8;
let PREC_CALL: i64 = 9;
let PREC_INDEX: i64 = 10;
let PREC_MEMBER: i64 = 11;

fn get_precedence(kind: i64) -> i64 {
    if kind == TOK_OR { return PREC_OR; }
    if kind == TOK_AND { return PREC_AND; }
    if kind == TOK_EQ || kind == TOK_NOT_EQ { return PREC_EQUALS; }
    if kind == TOK_LT || kind == TOK_LTE || kind == TOK_GT || kind == TOK_GTE { return PREC_LESSGREATER; }
    if kind == TOK_PLUS || kind == TOK_MINUS { return PREC_SUM; }
    if kind == TOK_SLASH || kind == TOK_STAR || kind == TOK_PERCENT { return PREC_PRODUCT; }
    if kind == TOK_LPAREN { return PREC_CALL; }
    if kind == TOK_LBRACKET { return PREC_INDEX; }
    if kind == TOK_DOT { return PREC_MEMBER; }
    return PREC_LOWEST;
}

fn parse_type_name(p: Parser) -> string {
    let t_name = p.cur_tok.lit;
    if parser_cur_is(p, TOK_RAW) {
        parser_next_token(p);
        t_name = str_concat("raw ", p.cur_tok.lit);
    } else if parser_cur_is(p, TOK_WEAK) {
        parser_next_token(p);
        t_name = str_concat("weak ", p.cur_tok.lit);
    } else if parser_cur_is(p, TOK_FN) {
        if parser_peek_is(p, TOK_LPAREN) {
            parser_next_token(p); // cur_tok = '('
            let fn_sig = "fn(";
            if !parser_peek_is(p, TOK_RPAREN) {
                parser_next_token(p);
                let p1 = parse_type_name(p);
                fn_sig = str_concat(fn_sig, p1);
                while parser_peek_is(p, TOK_COMMA) {
                    parser_next_token(p); // cur_tok = ','
                    parser_next_token(p); // cur_tok = next type
                    let p_next = parse_type_name(p);
                    fn_sig = str_concat(fn_sig, ",");
                    fn_sig = str_concat(fn_sig, p_next);
                }
            }
            if !parser_expect_peek(p, TOK_RPAREN) { return "fn"; }
            fn_sig = str_concat(fn_sig, ")");
            if parser_peek_is(p, TOK_ARROW) {
                parser_next_token(p); // cur_tok = '->'
                parser_next_token(p); // cur_tok = ret type
                let ret_t = parse_type_name(p);
                fn_sig = str_concat(fn_sig, "->");
                fn_sig = str_concat(fn_sig, ret_t);
            } else {
                fn_sig = str_concat(fn_sig, "->void");
            }
            return fn_sig;
        }
    }
    if parser_peek_is(p, TOK_LT) {
        parser_next_token(p); // '<'
        while !parser_cur_is(p, TOK_GT) && !parser_cur_is(p, TOK_EOF) {
            parser_next_token(p);
        }
    }
    return t_name;
}

fn str_has_interpolation(raw_str: string) -> bool {
    let len = str_len(raw_str);
    let i = 0;
    while i < len {
        if str_char(raw_str, i) == 123 { // '{'
            let j = i + 1;
            let done = 0;
            while j < len && done == 0 {
                let c = str_char(raw_str, j);
                if c == 123 {
                    done = 1;
                } else if c == 125 {
                    done = 1;
                    if j > (i + 1) {
                        return true;
                    }
                }
                j = j + 1;
            }
        }
        i = i + 1;
    }
    return false;
}

fn make_str_concat(s1: ASTNode, s2: ASTNode) -> ASTNode {
    let s1_arg = new ASTNode {
        kind: s1.kind,
        str_val: s1.str_val,
        int_val: s1.int_val,
        type_name: s1.type_name,
        type_kind: s1.type_kind,
        left: s1.left,
        right: s1.right,
        child: s1.child,
        next: s2
    };
    return new ASTNode {
        kind: AST_CALL,
        str_val: "str_concat",
        type_name: "string",
        type_kind: TYPE_STRING,
        left: nil, right: nil,
        child: s1_arg,
        next: nil
    };
}

fn make_string_wrapper(expr: ASTNode) -> ASTNode {
    if expr.kind == AST_STR_LIT {
        return expr;
    }
    let arg_copy = new ASTNode {
        kind: expr.kind,
        str_val: expr.str_val,
        int_val: expr.int_val,
        type_name: expr.type_name,
        type_kind: expr.type_kind,
        left: expr.left,
        right: expr.right,
        child: expr.child,
        next: nil
    };
    return new ASTNode {
        kind: AST_CALL,
        str_val: "str_from_int",
        type_name: "string",
        type_kind: TYPE_STRING,
        left: nil, right: nil,
        child: arg_copy,
        next: nil
    };
}

fn parse_interpolated_string(p: Parser, raw_str: string) -> ASTNode {
    let len = str_len(raw_str);
    let i = 0;
    let last_pos = 0;
    let result_node: ASTNode = nil;

    while i < len {
        if str_char(raw_str, i) == 123 { // '{'
            let text_len = i - last_pos;
            if text_len > 0 {
                let text_part = str_sub(raw_str, last_pos, text_len);
                let lit_node = new ASTNode {
                    kind: AST_STR_LIT,
                    str_val: text_part,
                    type_kind: TYPE_STRING,
                    type_name: "string",
                    left: nil, right: nil, child: nil, next: nil
                };
                if result_node == nil {
                    result_node = lit_node;
                } else {
                    result_node = make_str_concat(result_node, lit_node);
                }
            }

            let expr_start = i + 1;
            i = i + 1;
            while i < len && str_char(raw_str, i) != 125 { // '}'
                i = i + 1;
            }
            let expr_len = i - expr_start;
            let expr_code = str_sub(raw_str, expr_start, expr_len);
            let sub_l = lexer_new(expr_code);
            let sub_p = parser_new(sub_l);
            let expr_ast = parse_expression(sub_p, PREC_LOWEST);
            let str_expr = new ASTNode {
                kind: AST_INTERP_EXPR,
                str_val: "",
                int_val: 0,
                type_kind: TYPE_STRING,
                type_name: "string",
                left: expr_ast,
                right: nil, child: nil, next: nil
            };

            if result_node == nil {
                result_node = str_expr;
            } else {
                result_node = make_str_concat(result_node, str_expr);
            }
            last_pos = i + 1;
        }
        i = i + 1;
    }

    let rem_len = len - last_pos;
    if rem_len > 0 {
        let rem_text = str_sub(raw_str, last_pos, rem_len);
        let lit_node = new ASTNode {
            kind: AST_STR_LIT,
            str_val: rem_text,
            type_kind: TYPE_STRING,
            type_name: "string",
            left: nil, right: nil, child: nil, next: nil
        };
        if result_node == nil {
            result_node = lit_node;
        } else {
            result_node = make_str_concat(result_node, lit_node);
        }
    }

    if result_node == nil {
        return new ASTNode {
            kind: AST_STR_LIT,
            str_val: "",
            type_kind: TYPE_STRING,
            type_name: "string",
            left: nil, right: nil, child: nil, next: nil
        };
    }
    return result_node;
}

fn parse_expression(p: Parser, prec: i64) -> ASTNode {
    let left: ASTNode = nil;

    // Prefix rules
    if parser_cur_is(p, TOK_INT) {
        left = new ASTNode {
            kind: AST_INT_LIT,
            int_val: p.cur_tok.val_i64,
            str_val: p.cur_tok.lit,
            type_kind: TYPE_INT,
            type_name: "i64",
            left: nil, right: nil, child: nil, next: nil
        };
    } else if parser_cur_is(p, TOK_STRING) {
        if str_has_interpolation(p.cur_tok.lit) {
            left = parse_interpolated_string(p, p.cur_tok.lit);
        } else {
            left = new ASTNode {
                kind: AST_STR_LIT,
                str_val: p.cur_tok.lit,
                type_kind: TYPE_STRING,
                type_name: "string",
                left: nil, right: nil, child: nil, next: nil
            };
        }
    } else if parser_cur_is(p, TOK_TRUE) || parser_cur_is(p, TOK_FALSE) {
        left = new ASTNode {
            kind: AST_BOOL_LIT,
            int_val: p.cur_tok.val_i64,
            str_val: p.cur_tok.lit,
            type_kind: TYPE_BOOL,
            type_name: "bool",
            left: nil, right: nil, child: nil, next: nil
        };
    } else if parser_cur_is(p, TOK_IDENT) {
        left = new ASTNode {
            kind: AST_IDENT,
            str_val: p.cur_tok.lit,
            left: nil, right: nil, child: nil, next: nil
        };
    } else if parser_cur_is(p, TOK_LBRACKET) {
        let head_elem: ASTNode = nil;
        let tail_elem: ASTNode = nil;
        if !parser_peek_is(p, TOK_RBRACKET) {
            parser_next_token(p);
            let e_node = parse_expression(p, PREC_LOWEST);
            head_elem = e_node;
            tail_elem = e_node;
            while parser_peek_is(p, TOK_COMMA) {
                parser_next_token(p);
                parser_next_token(p);
                let e_node2 = parse_expression(p, PREC_LOWEST);
                tail_elem.next = e_node2;
                tail_elem = e_node2;
            }
        }
        if !parser_expect_peek(p, TOK_RBRACKET) { return nil; }
        left = new ASTNode {
            kind: AST_ARRAY_LIT,
            child: head_elem,
            left: nil, right: nil, next: nil
        };
    } else if parser_cur_is(p, TOK_BANG) || parser_cur_is(p, TOK_MINUS) || parser_cur_is(p, TOK_RAW) {
        let op_str = p.cur_tok.lit;
        parser_next_token(p);
        let right_expr = parse_expression(p, PREC_PREFIX);
        left = new ASTNode {
            kind: AST_UN_OP,
            str_val: op_str,
            left: right_expr,
            right: nil, child: nil, next: nil
        };
    } else if parser_cur_is(p, TOK_LPAREN) {
        parser_next_token(p);
        left = parse_expression(p, PREC_LOWEST);
        if !parser_expect_peek(p, TOK_RPAREN) {
            return nil;
        }
    } else if parser_cur_is(p, TOK_NEW) {
        parser_next_token(p);
        let type_name = p.cur_tok.lit;
        if parser_peek_is(p, TOK_DOT) {
            parser_next_token(p);
            if parser_peek_is(p, TOK_IDENT) {
                parser_next_token(p);
                type_name = str_concat(type_name, str_concat(".", p.cur_tok.lit));
            }
        }
        if parser_peek_is(p, TOK_LT) {
            parser_next_token(p);
            while !parser_cur_is(p, TOK_GT) && !parser_cur_is(p, TOK_EOF) {
                parser_next_token(p);
            }
        }
        if !parser_expect_peek(p, TOK_LBRACE) { return nil; }
        let head_init: ASTNode = nil;
        let tail_init: ASTNode = nil;
        parser_next_token(p);
        while !parser_cur_is(p, TOK_RBRACE) && !parser_cur_is(p, TOK_EOF) {
            if parser_cur_is(p, TOK_IDENT) {
                let f_name = p.cur_tok.lit;
                if !parser_expect_peek(p, TOK_COLON) { return nil; }
                parser_next_token(p);
                let f_val = parse_expression(p, PREC_LOWEST);
                let init_node = new ASTNode {
                    kind: AST_FIELD_INIT,
                    str_val: f_name,
                    left: f_val,
                    right: nil, child: nil, next: nil
                };
                if head_init == nil {
                    head_init = init_node;
                    tail_init = init_node;
                } else {
                    tail_init.next = init_node;
                    tail_init = init_node;
                }
                if parser_peek_is(p, TOK_COMMA) {
                    parser_next_token(p);
                }
            }
            parser_next_token(p);
        }
        left = new ASTNode {
            kind: AST_NEW,
            type_name: type_name,
            child: head_init,
            left: nil, right: nil, next: nil
        };
    } else if parser_cur_is(p, TOK_PRINT) {
        if !parser_expect_peek(p, TOK_LPAREN) { return nil; }
        let head_arg: ASTNode = nil;
        let tail_arg: ASTNode = nil;
        if !parser_peek_is(p, TOK_RPAREN) {
            parser_next_token(p);
            head_arg = parse_expression(p, PREC_LOWEST);
            tail_arg = head_arg;
            while parser_peek_is(p, TOK_COMMA) {
                parser_next_token(p);
                parser_next_token(p);
                let arg_node = parse_expression(p, PREC_LOWEST);
                tail_arg.next = arg_node;
                tail_arg = arg_node;
            }
        }
        if !parser_expect_peek(p, TOK_RPAREN) { return nil; }
        left = new ASTNode {
            kind: AST_PRINT,
            child: head_arg,
            left: nil, right: nil, next: nil
        };
    }

    // Infix rules
    while !parser_peek_is(p, TOK_SEMICOLON) && prec < get_precedence(p.peek_tok.kind) {
        let peek_kind = p.peek_tok.kind;
        if peek_kind == TOK_PLUS || peek_kind == TOK_MINUS || peek_kind == TOK_STAR ||
           peek_kind == TOK_SLASH || peek_kind == TOK_PERCENT || peek_kind == TOK_EQ ||
           peek_kind == TOK_NOT_EQ || peek_kind == TOK_LT || peek_kind == TOK_LTE ||
           peek_kind == TOK_GT || peek_kind == TOK_GTE || peek_kind == TOK_AND || peek_kind == TOK_OR {
            parser_next_token(p);
            let op_str = p.cur_tok.lit;
            let op_prec = get_precedence(p.cur_tok.kind);
            parser_next_token(p);
            let right_expr = parse_expression(p, op_prec);
            let bin = new ASTNode {
                kind: AST_BIN_OP,
                str_val: op_str,
                left: left,
                right: right_expr,
                child: nil, next: nil
            };
            left = bin;
        } else if peek_kind == TOK_LPAREN {
            parser_next_token(p);
            let callee_name = left.str_val;
            if left.kind == AST_MEMBER {
                callee_name = str_concat(left.left.str_val, str_concat(".", left.str_val));
            }
            let head_arg: ASTNode = nil;
            let tail_arg: ASTNode = nil;
            if !parser_peek_is(p, TOK_RPAREN) {
                parser_next_token(p);
                head_arg = parse_expression(p, PREC_LOWEST);
                tail_arg = head_arg;
                while parser_peek_is(p, TOK_COMMA) {
                    parser_next_token(p);
                    parser_next_token(p);
                    let arg_node = parse_expression(p, PREC_LOWEST);
                    tail_arg.next = arg_node;
                    tail_arg = arg_node;
                }
            }
            if !parser_expect_peek(p, TOK_RPAREN) { return nil; }
            let call = new ASTNode {
                kind: AST_CALL,
                str_val: callee_name,
                child: head_arg,
                left: nil, right: nil, next: nil
            };
            left = call;
        } else if peek_kind == TOK_DOT {
            parser_next_token(p);
            if !parser_expect_peek(p, TOK_IDENT) { return nil; }
            let member_name = p.cur_tok.lit;
            let mem = new ASTNode {
                kind: AST_MEMBER,
                str_val: member_name,
                left: left,
                right: nil, child: nil, next: nil
            };
            left = mem;
        } else if peek_kind == TOK_LBRACKET {
            parser_next_token(p);
            parser_next_token(p);
            let idx_expr = parse_expression(p, PREC_LOWEST);
            if !parser_expect_peek(p, TOK_RBRACKET) { return nil; }
            let idx_node = new ASTNode {
                kind: AST_INDEX,
                left: left,
                right: idx_expr,
                child: nil, next: nil
            };
            left = idx_node;
        } else {
            return left;
        }
    }

    return left;
}

fn parse_block(p: Parser) -> ASTNode {
    if !parser_cur_is(p, TOK_LBRACE) {
        return nil;
    }
    let head_stmt: ASTNode = nil;
    let tail_stmt: ASTNode = nil;
    parser_next_token(p);
    while !parser_cur_is(p, TOK_RBRACE) && !parser_cur_is(p, TOK_EOF) {
        let stmt = parse_statement(p);
        if stmt != nil {
            if head_stmt == nil {
                head_stmt = stmt;
                tail_stmt = stmt;
            } else {
                tail_stmt.next = stmt;
                tail_stmt = stmt;
            }
        }
        parser_next_token(p);
    }
    return new ASTNode {
        kind: AST_BLOCK,
        child: head_stmt,
        left: nil, right: nil, next: nil
    };
}

fn parse_statement(p: Parser) -> ASTNode {
    if parser_cur_is(p, TOK_MATCH) {
        return parse_match_stmt(p);
    }
    if parser_cur_is(p, TOK_LET) {
        if !parser_expect_peek(p, TOK_IDENT) { return nil; }
        let var_name = p.cur_tok.lit;
        let type_name = "";
        if parser_peek_is(p, TOK_COLON) {
            parser_next_token(p);
            parser_next_token(p);
            type_name = parse_type_name(p);
        }
        if !parser_expect_peek(p, TOK_ASSIGN) { return nil; }
        parser_next_token(p);
        let val_expr = parse_expression(p, PREC_LOWEST);
        if parser_peek_is(p, TOK_SEMICOLON) {
            parser_next_token(p);
        }
        return new ASTNode {
            kind: AST_LET_STMT,
            str_val: var_name,
            type_name: type_name,
            left: val_expr,
            right: nil, child: nil, next: nil
        };
    }

    if parser_cur_is(p, TOK_RETURN) {
        let ret_val: ASTNode = nil;
        if !parser_peek_is(p, TOK_SEMICOLON) {
            parser_next_token(p);
            ret_val = parse_expression(p, PREC_LOWEST);
        }
        if parser_peek_is(p, TOK_SEMICOLON) {
            parser_next_token(p);
        }
        return new ASTNode {
            kind: AST_RETURN_STMT,
            left: ret_val,
            right: nil, child: nil, next: nil
        };
    }

    if parser_cur_is(p, TOK_IF) {
        parser_next_token(p);
        let cond_expr = parse_expression(p, PREC_LOWEST);
        if !parser_expect_peek(p, TOK_LBRACE) { return nil; }
        let then_block = parse_block(p);
        let else_block: ASTNode = nil;
        if parser_peek_is(p, TOK_ELSE) {
            parser_next_token(p);
            if parser_peek_is(p, TOK_IF) {
                parser_next_token(p);
                else_block = parse_statement(p);
            } else if parser_peek_is(p, TOK_LBRACE) {
                parser_next_token(p);
                else_block = parse_block(p);
            }
        }
        return new ASTNode {
            kind: AST_IF_STMT,
            left: cond_expr,
            right: then_block,
            child: else_block,
            next: nil
        };
    }

    if parser_cur_is(p, TOK_WHILE) {
        parser_next_token(p);
        let cond_expr = parse_expression(p, PREC_LOWEST);
        if !parser_expect_peek(p, TOK_LBRACE) { return nil; }
        let body_block = parse_block(p);
        return new ASTNode {
            kind: AST_WHILE_STMT,
            left: cond_expr,
            right: body_block,
            child: nil, next: nil
        };
    }

    if parser_cur_is(p, TOK_FOR) {
        return parse_for_stmt(p);
    }

    // Expression statement or Assignment
    let expr = parse_expression(p, PREC_LOWEST);
    if parser_peek_is(p, TOK_ASSIGN) {
        parser_next_token(p);
        parser_next_token(p);
        let rhs = parse_expression(p, PREC_LOWEST);
        if parser_peek_is(p, TOK_SEMICOLON) {
            parser_next_token(p);
        }
        return new ASTNode {
            kind: AST_ASSIGN_STMT,
            left: expr,
            right: rhs,
            child: nil, next: nil
        };
    }

    if parser_peek_is(p, TOK_SEMICOLON) {
        parser_next_token(p);
    }
    return new ASTNode {
        kind: AST_EXPR_STMT,
        left: expr,
        right: nil, child: nil, next: nil
    };
}

fn parse_for_stmt(p: Parser) -> ASTNode {
    if !parser_expect_peek(p, TOK_IDENT) { return nil; }
    let var_name = p.cur_tok.lit;
    if !parser_expect_peek(p, TOK_IN) { return nil; }
    parser_next_token(p);
    let start_expr = parse_expression(p, PREC_LOWEST);

    if parser_peek_is(p, TOK_DOTDOT) {
        parser_next_token(p);
        parser_next_token(p);
        let end_expr = parse_expression(p, PREC_LOWEST);
        if !parser_expect_peek(p, TOK_LBRACE) { return nil; }
        let body_block = parse_block(p);

        // 1. let var_name = start_expr;
        let init_stmt = new ASTNode {
            kind: AST_LET_STMT,
            str_val: var_name,
            type_name: "i64",
            left: start_expr,
            right: nil, child: nil, next: nil
        };

        // 2. cond: var_name < end_expr
        let cond_expr = new ASTNode {
            kind: AST_BIN_OP,
            str_val: "<",
            int_val: 0,
            left: new ASTNode {
                kind: AST_IDENT,
                str_val: var_name,
                int_val: 0,
                left: nil, right: nil, child: nil, next: nil
            },
            right: end_expr,
            child: nil, next: nil
        };

        // 3. increment: var_name = var_name + 1
        let inc_stmt = new ASTNode {
            kind: AST_ASSIGN_STMT,
            str_val: "",
            int_val: 0,
            left: new ASTNode {
                kind: AST_IDENT,
                str_val: var_name,
                int_val: 0,
                left: nil, right: nil, child: nil, next: nil
            },
            right: new ASTNode {
                kind: AST_BIN_OP,
                str_val: "+",
                int_val: 0,
                left: new ASTNode {
                    kind: AST_IDENT,
                    str_val: var_name,
                    int_val: 0,
                    left: nil, right: nil, child: nil, next: nil
                },
                right: new ASTNode {
                    kind: AST_INT_LIT,
                    str_val: "1",
                    int_val: 1,
                    left: nil, right: nil, child: nil, next: nil
                },
                child: nil, next: nil
            },
            child: nil, next: nil
        };

        // Append inc_stmt to body_block.child
        if body_block.child == nil {
            body_block.child = inc_stmt;
        } else {
            let cur = body_block.child;
            while cur.next != nil {
                cur = cur.next;
            }
            cur.next = inc_stmt;
        }

        // 4. while loop
        let while_stmt = new ASTNode {
            kind: AST_WHILE_STMT,
            str_val: "",
            int_val: 0,
            left: cond_expr,
            right: body_block,
            child: nil, next: nil
        };

        init_stmt.next = while_stmt;
        return new ASTNode {
            kind: AST_BLOCK,
            str_val: "",
            int_val: 0,
            left: nil, right: nil,
            child: init_stmt,
            next: nil
        };
    } else {
        // for item in coll
        let coll_expr = start_expr;
        if !parser_expect_peek(p, TOK_LBRACE) { return nil; }
        let body_block = parse_block(p);

        let idx_var = str_concat("__idx_", var_name);

        // 1. let __idx_var = 0;
        let init_idx = new ASTNode {
            kind: AST_LET_STMT,
            str_val: idx_var,
            type_name: "i64",
            left: new ASTNode {
                kind: AST_INT_LIT,
                str_val: "0",
                int_val: 0,
                left: nil, right: nil, child: nil, next: nil
            },
            right: nil, child: nil, next: nil
        };

        // 2. cond: __idx_var < coll.len
        let cond_expr = new ASTNode {
            kind: AST_BIN_OP,
            str_val: "<",
            int_val: 0,
            left: new ASTNode {
                kind: AST_IDENT,
                str_val: idx_var,
                int_val: 0,
                left: nil, right: nil, child: nil, next: nil
            },
            right: new ASTNode {
                kind: AST_MEMBER,
                str_val: "len",
                int_val: 0,
                left: coll_expr,
                right: nil, child: nil, next: nil
            },
            child: nil, next: nil
        };

        // 3. let item = coll[__idx_var];
        let item_bind = new ASTNode {
            kind: AST_LET_STMT,
            str_val: var_name,
            type_name: "",
            left: new ASTNode {
                kind: AST_INDEX,
                str_val: "",
                int_val: 0,
                left: coll_expr,
                right: new ASTNode {
                    kind: AST_IDENT,
                    str_val: idx_var,
                    int_val: 0,
                    left: nil, right: nil, child: nil, next: nil
                },
                child: nil, next: nil
            },
            right: nil, child: nil, next: nil
        };

        // 4. inc: __idx_var = __idx_var + 1
        let inc_stmt = new ASTNode {
            kind: AST_ASSIGN_STMT,
            str_val: "",
            int_val: 0,
            left: new ASTNode {
                kind: AST_IDENT,
                str_val: idx_var,
                int_val: 0,
                left: nil, right: nil, child: nil, next: nil
            },
            right: new ASTNode {
                kind: AST_BIN_OP,
                str_val: "+",
                int_val: 0,
                left: new ASTNode {
                    kind: AST_IDENT,
                    str_val: idx_var,
                    int_val: 0,
                    left: nil, right: nil, child: nil, next: nil
                },
                right: new ASTNode {
                    kind: AST_INT_LIT,
                    str_val: "1",
                    int_val: 1,
                    left: nil, right: nil, child: nil, next: nil
                },
                child: nil, next: nil
            },
            child: nil, next: nil
        };

        // Prepend item_bind to body_block.child
        item_bind.next = body_block.child;
        body_block.child = item_bind;

        // Append inc_stmt to end of body_block.child
        let cur = body_block.child;
        while cur.next != nil {
            cur = cur.next;
        }
        cur.next = inc_stmt;

        let while_stmt = new ASTNode {
            kind: AST_WHILE_STMT,
            str_val: "",
            int_val: 0,
            left: cond_expr,
            right: body_block,
            child: nil, next: nil
        };

        init_idx.next = while_stmt;
        return new ASTNode {
            kind: AST_BLOCK,
            str_val: "",
            int_val: 0,
            left: nil, right: nil,
            child: init_idx,
            next: nil
        };
    }
}

fn parse_match_stmt(p: Parser) -> ASTNode {
    parser_next_token(p);
    let target = parse_expression(p, PREC_LOWEST);
    if !parser_expect_peek(p, TOK_LBRACE) { return nil; }
    let head_arm: ASTNode = nil;
    let tail_arm: ASTNode = nil;
    parser_next_token(p);
    while !parser_cur_is(p, TOK_RBRACE) && !parser_cur_is(p, TOK_EOF) {
        if parser_cur_is(p, TOK_IDENT) {
            let first = p.cur_tok.lit;
            let is_wildcard: i64 = 0;
            let enum_name = "";
            let var_name = first;
            if str_eq(first, "_") {
                is_wildcard = 1;
            } else if parser_peek_is(p, TOK_DOT) {
                parser_next_token(p);
                if !parser_expect_peek(p, TOK_IDENT) { return nil; }
                enum_name = first;
                var_name = p.cur_tok.lit;
            }
            let head_bind: ASTNode = nil;
            let tail_bind: ASTNode = nil;
            if is_wildcard == 0 && parser_peek_is(p, TOK_LPAREN) {
                parser_next_token(p);
                if !parser_peek_is(p, TOK_RPAREN) {
                    parser_next_token(p);
                    let b_node = new ASTNode {
                        kind: AST_IDENT,
                        str_val: p.cur_tok.lit,
                        left: nil, right: nil, child: nil, next: nil
                    };
                    head_bind = b_node;
                    tail_bind = b_node;
                    while parser_peek_is(p, TOK_COMMA) {
                        parser_next_token(p);
                        parser_next_token(p);
                        let b_node2 = new ASTNode {
                            kind: AST_IDENT,
                            str_val: p.cur_tok.lit,
                            left: nil, right: nil, child: nil, next: nil
                        };
                        tail_bind.next = b_node2;
                        tail_bind = b_node2;
                    }
                }
                if !parser_expect_peek(p, TOK_RPAREN) { return nil; }
            }
            if !parser_expect_peek(p, TOK_FAT_ARROW) { return nil; }
            if !parser_expect_peek(p, TOK_LBRACE) { return nil; }
            let body = parse_block(p);
            let arm = new ASTNode {
                kind: AST_MATCH_ARM,
                str_val: var_name,
                type_name: enum_name,
                int_val: is_wildcard,
                left: head_bind,
                right: body,
                child: nil, next: nil
            };
            if head_arm == nil {
                head_arm = arm;
                tail_arm = arm;
            } else {
                tail_arm.next = arm;
                tail_arm = arm;
            }
            if parser_peek_is(p, TOK_COMMA) {
                parser_next_token(p);
            }
        }
        parser_next_token(p);
    }
    return new ASTNode {
        kind: AST_MATCH_STMT,
        left: target,
        child: head_arm,
        right: nil, next: nil
    };
}

fn parse_fn_decl(p: Parser) -> ASTNode {
    if !parser_expect_peek(p, TOK_IDENT) { return nil; }
    let fn_name = p.cur_tok.lit;
    if parser_peek_is(p, TOK_LT) {
        parser_next_token(p);
        while !parser_cur_is(p, TOK_GT) && !parser_cur_is(p, TOK_EOF) {
            parser_next_token(p);
        }
    }
    if !parser_expect_peek(p, TOK_LPAREN) { return nil; }

    let head_param: ASTNode = nil;
    let tail_param: ASTNode = nil;
    if !parser_peek_is(p, TOK_RPAREN) {
        parser_next_token(p);
        let p_name = p.cur_tok.lit;
        let p_type = "i64";
        if !parser_expect_peek(p, TOK_COLON) { return nil; }
        parser_next_token(p);
        p_type = parse_type_name(p);
        head_param = new ASTNode {
            kind: AST_PARAM,
            str_val: p_name,
            type_name: p_type,
            left: nil, right: nil, child: nil, next: nil
        };
        tail_param = head_param;

        while parser_peek_is(p, TOK_COMMA) {
            parser_next_token(p);
            parser_next_token(p);
            let pn = p.cur_tok.lit;
            if !parser_expect_peek(p, TOK_COLON) { return nil; }
            parser_next_token(p);
            let pt = parse_type_name(p);
            let param_node = new ASTNode {
                kind: AST_PARAM,
                str_val: pn,
                type_name: pt,
                left: nil, right: nil, child: nil, next: nil
            };
            tail_param.next = param_node;
            tail_param = param_node;
        }
    }
    if !parser_expect_peek(p, TOK_RPAREN) { return nil; }

    let ret_type = "void";
    if parser_peek_is(p, TOK_ARROW) {
        parser_next_token(p);
        parser_next_token(p);
        ret_type = parse_type_name(p);
    }

    if !parser_expect_peek(p, TOK_LBRACE) { return nil; }
    let body = parse_block(p);

    return new ASTNode {
        kind: AST_FN_DECL,
        str_val: fn_name,
        type_name: ret_type,
        left: head_param,
        right: body,
        child: nil, next: nil
    };
}

fn parse_struct_or_class(p: Parser, is_class: bool) -> ASTNode {
    if !parser_expect_peek(p, TOK_IDENT) { return nil; }
    let type_name = p.cur_tok.lit;
    if parser_peek_is(p, TOK_LT) {
        parser_next_token(p);
        while !parser_cur_is(p, TOK_GT) && !parser_cur_is(p, TOK_EOF) {
            parser_next_token(p);
        }
    }
    if !parser_expect_peek(p, TOK_LBRACE) { return nil; }

    let head_field: ASTNode = nil;
    let tail_field: ASTNode = nil;
    let deinit_block: ASTNode = nil;

    parser_next_token(p);
    while !parser_cur_is(p, TOK_RBRACE) && !parser_cur_is(p, TOK_EOF) {
        if parser_cur_is(p, TOK_DEINIT) {
            if !parser_expect_peek(p, TOK_LBRACE) { return nil; }
            deinit_block = parse_block(p);
        } else if parser_cur_is(p, TOK_IDENT) {
            let f_name = p.cur_tok.lit;
            if !parser_expect_peek(p, TOK_COLON) { return nil; }
            parser_next_token(p);
            let f_type = parse_type_name(p);
            if parser_peek_is(p, TOK_SEMICOLON) {
                parser_next_token(p);
            }
            let field_node = new ASTNode {
                kind: AST_FIELD_DECL,
                str_val: f_name,
                type_name: f_type,
                left: nil, right: nil, child: nil, next: nil
            };
            if head_field == nil {
                head_field = field_node;
                tail_field = field_node;
            } else {
                tail_field.next = field_node;
                tail_field = field_node;
            }
        }
        parser_next_token(p);
    }

    let k = AST_STRUCT_DECL;
    if is_class { k = AST_CLASS_DECL; }

    return new ASTNode {
        kind: k,
        str_val: type_name,
        left: head_field,
        right: deinit_block,
        child: nil, next: nil
    };
}

fn parse_enum_decl(p: Parser) -> ASTNode {
    if !parser_expect_peek(p, TOK_IDENT) { return nil; }
    let enum_name = p.cur_tok.lit;
    if parser_peek_is(p, TOK_LT) {
        parser_next_token(p);
        while !parser_cur_is(p, TOK_GT) && !parser_cur_is(p, TOK_EOF) {
            parser_next_token(p);
        }
    }
    if !parser_expect_peek(p, TOK_LBRACE) { return nil; }
    let head_var: ASTNode = nil;
    let tail_var: ASTNode = nil;
    let tag: i64 = 0;
    parser_next_token(p);
    while !parser_cur_is(p, TOK_RBRACE) && !parser_cur_is(p, TOK_EOF) {
        if parser_cur_is(p, TOK_IDENT) {
            let v_name = p.cur_tok.lit;
            let head_param: ASTNode = nil;
            let tail_param: ASTNode = nil;
            if parser_peek_is(p, TOK_LPAREN) {
                parser_next_token(p);
                if !parser_peek_is(p, TOK_RPAREN) {
                    parser_next_token(p);
                    let pt = parse_type_name(p);
                    let param_node = new ASTNode {
                        kind: AST_PARAM,
                        str_val: "",
                        type_name: pt,
                        left: nil, right: nil, child: nil, next: nil
                    };
                    head_param = param_node;
                    tail_param = param_node;
                    while parser_peek_is(p, TOK_COMMA) {
                        parser_next_token(p);
                        parser_next_token(p);
                        let pt2 = parse_type_name(p);
                        let param_node2 = new ASTNode {
                            kind: AST_PARAM,
                            str_val: "",
                            type_name: pt2,
                            left: nil, right: nil, child: nil, next: nil
                        };
                        tail_param.next = param_node2;
                        tail_param = param_node2;
                    }
                }
                if !parser_expect_peek(p, TOK_RPAREN) { return nil; }
            }
            let v_node = new ASTNode {
                kind: AST_ENUM_VARIANT,
                str_val: v_name,
                int_val: tag,
                left: head_param,
                right: nil, child: nil, next: nil
            };
            tag = tag + 1;
            if head_var == nil {
                head_var = v_node;
                tail_var = v_node;
            } else {
                tail_var.next = v_node;
                tail_var = v_node;
            }
            if parser_peek_is(p, TOK_COMMA) || parser_peek_is(p, TOK_SEMICOLON) {
                parser_next_token(p);
            }
        }
        parser_next_token(p);
    }
    return new ASTNode {
        kind: AST_ENUM_DECL,
        str_val: enum_name,
        child: head_var,
        left: nil, right: nil, next: nil
    };
}

fn parse_program(p: Parser) -> ASTNode {
    let head_decl: ASTNode = nil;
    let tail_decl: ASTNode = nil;

    while !parser_cur_is(p, TOK_EOF) {
        let decl: ASTNode = nil;
        if parser_cur_is(p, TOK_FN) {
            decl = parse_fn_decl(p);
        } else if parser_cur_is(p, TOK_STRUCT) {
            decl = parse_struct_or_class(p, false);
        } else if parser_cur_is(p, TOK_CLASS) {
            decl = parse_struct_or_class(p, true);
        } else if parser_cur_is(p, TOK_ENUM) {
            decl = parse_enum_decl(p);
        } else if parser_cur_is(p, TOK_IMPORT) {
            parser_next_token(p);
            let imp_path = p.cur_tok.lit;
            let alias_name = "";
            if parser_peek_is(p, TOK_AS) {
                parser_next_token(p);
                if parser_peek_is(p, TOK_IDENT) {
                    parser_next_token(p);
                    alias_name = p.cur_tok.lit;
                }
            }
            if parser_peek_is(p, TOK_SEMICOLON) {
                parser_next_token(p);
            }
            decl = new ASTNode {
                kind: AST_IMPORT_DECL,
                str_val: imp_path,
                type_name: alias_name,
                left: nil, right: nil, child: nil, next: nil
            };
        } else if parser_cur_is(p, TOK_LET) {
            decl = parse_statement(p);
        }
        if decl != nil {
            if head_decl == nil {
                head_decl = decl;
                tail_decl = decl;
            } else {
                tail_decl.next = decl;
                tail_decl = decl;
            }
        }
        parser_next_token(p);
    }

    return new ASTNode {
        kind: AST_PROGRAM,
        child: head_decl,
        left: nil, right: nil, next: nil
    };
}

class FileList {
    path: string;
    next: FileList;
}

fn file_list_has(head: FileList, path: string) -> bool {
    let cur = head;
    while cur != nil {
        if str_eq(cur.path, path) { return true; }
        cur = cur.next;
    }
    return false;
}

fn ast_prefix_internal_refs(node: ASTNode, ns: string, decl_names: FileList) {
    if node == nil { return; }

    if node.kind == AST_CALL {
        if file_list_has(decl_names, node.str_val) {
            node.str_val = str_concat(ns, str_concat(".", node.str_val));
        }
    } else if node.kind == AST_NEW {
        if file_list_has(decl_names, node.type_name) {
            node.type_name = str_concat(ns, str_concat(".", node.type_name));
        }
    }

    ast_prefix_internal_refs(node.left, ns, decl_names);
    ast_prefix_internal_refs(node.right, ns, decl_names);
    ast_prefix_internal_refs(node.child, ns, decl_names);
    ast_prefix_internal_refs(node.next, ns, decl_names);
}

fn ast_prefix_module_symbols(prog: ASTNode, ns: string) {
    if prog == nil || str_len(ns) == 0 { return; }

    let decl_names: FileList = nil;
    let d = prog.child;
    while d != nil {
        if d.kind == AST_FN_DECL || d.kind == AST_STRUCT_DECL ||
           d.kind == AST_CLASS_DECL || d.kind == AST_ENUM_DECL {
            let node = new FileList {
                path: d.str_val,
                next: decl_names
            };
            decl_names = node;
        }
        d = d.next;
    }

    d = prog.child;
    while d != nil {
        if d.kind == AST_FN_DECL || d.kind == AST_STRUCT_DECL ||
           d.kind == AST_CLASS_DECL || d.kind == AST_ENUM_DECL {
            d.str_val = str_concat(ns, str_concat(".", d.str_val));
        }
        if d.kind == AST_FN_DECL {
            ast_prefix_internal_refs(d.child, ns, decl_names);
        }
        d = d.next;
    }
}

fn resolve_imports(prog: ASTNode, loaded: FileList) -> ASTNode {
    let head_decl: ASTNode = nil;
    let tail_decl: ASTNode = nil;
    let cur = prog.child;

    while cur != nil {
        let next_cur = cur.next;
        cur.next = nil;

        if cur.kind == AST_IMPORT_DECL {
            let import_path = cur.str_val;
            let alias_name = cur.type_name;

            let actual_path = import_path;
            let imported_src = read_file(actual_path);
            if str_len(imported_src) == 0 {
                // Try .gat/deps/<pkg>/<pkg>.gat
                let dep_try1 = str_concat(".gat/deps/", str_concat(import_path, str_concat("/", str_concat(import_path, ".gat"))));
                imported_src = read_file(dep_try1);
                if str_len(imported_src) > 0 {
                    actual_path = dep_try1;
                    if str_len(alias_name) == 0 { alias_name = import_path; }
                } else {
                    // Try .gat/deps/<pkg>/lib.gat
                    let dep_try2 = str_concat(".gat/deps/", str_concat(import_path, "/lib.gat"));
                    imported_src = read_file(dep_try2);
                    if str_len(imported_src) > 0 {
                        actual_path = dep_try2;
                        if str_len(alias_name) == 0 { alias_name = import_path; }
                    } else {
                        // Try .gat/deps/<pkg>/mod.gat
                        let dep_try3 = str_concat(".gat/deps/", str_concat(import_path, "/mod.gat"));
                        imported_src = read_file(dep_try3);
                        if str_len(imported_src) > 0 {
                            actual_path = dep_try3;
                            if str_len(alias_name) == 0 { alias_name = import_path; }
                        }
                    }
                }
            }

            if !file_list_has(loaded, actual_path) {
                let node = new FileList {
                    path: actual_path,
                    next: loaded.next
                };
                loaded.next = node;

                if str_len(imported_src) > 0 {
                    let imp_l = lexer_new(imported_src);
                    let imp_p = parser_new(imp_l);
                    let imp_prog = parse_program(imp_p);
                    let resolved_imp = resolve_imports(imp_prog, loaded);

                    if str_len(alias_name) > 0 {
                        ast_prefix_module_symbols(resolved_imp, alias_name);
                    }

                    let imp_d = resolved_imp.child;
                    while imp_d != nil {
                        let next_d = imp_d.next;
                        imp_d.next = nil;
                        if head_decl == nil {
                            head_decl = imp_d;
                            tail_decl = imp_d;
                        } else {
                            tail_decl.next = imp_d;
                            tail_decl = imp_d;
                        }
                        imp_d = next_d;
                    }
                } else {
                    print("[Warning] Could not read import file: ", import_path, "\n");
                }
            }
        } else {
            if head_decl == nil {
                head_decl = cur;
                tail_decl = cur;
            } else {
                tail_decl.next = cur;
                tail_decl = cur;
            }
        }

        cur = next_cur;
    }

    prog.child = head_decl;
    return prog;
}
