{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Gat",
  "scopeName": "source.gat",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#chars" },
    { "include": "#constants" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#functions" },
    { "include": "#numbers" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.gat",
          "match": "//.*$"
        },
        {
          "name": "comment.block.gat",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.gat",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.gat",
              "match": "\\\\([nrt\\\\\"'0]|x[0-9a-fA-F]{2})"
            },
            {
              "name": "meta.interpolation.gat",
              "begin": "\\{",
              "end": "\\}",
              "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.gat" } },
              "endCaptures": { "0": { "name": "punctuation.section.interpolation.end.gat" } },
              "patterns": [
                { "include": "$self" }
              ]
            }
          ]
        }
      ]
    },
    "chars": {
      "patterns": [
        {
          "name": "string.quoted.single.gat",
          "match": "'(\\\\([nrt\\\\\"'0]|x[0-9a-fA-F]{2})|[^'\\\\])'"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.gat",
          "match": "\\b(true|false|nil)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.gat",
          "match": "\\b(if|else|while|for|in|return|match|import)\\b"
        },
        {
          "name": "storage.type.gat",
          "match": "\\b(struct|class|enum|fn|let|deinit)\\b"
        },
        {
          "name": "storage.modifier.gat",
          "match": "\\b(raw|weak|new)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.gat",
          "match": "\\b(i8|i64|bool|string|void|array)\\b"
        },
        {
          "name": "entity.name.type.gat",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "support.function.builtin.gat",
          "match": "\\b(print|alloc_mem|free_mem|read_file|write_file|str_len|str_eq|str_char|str_sub|str_concat|str_from_int|get_cmd_arg|delete_file|sleep|get_temp_dir|exec_cmd|exit_process|get_pid|file_size|thread_spawn|thread_join|mutex_new|mutex_lock|mutex_unlock|option_some|option_none|option_unwrap|option_map|result_ok|result_err|result_unwrap|result_map|weak_from|weak_upgrade|weak_is_alive)\\b"
        },
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.gat" }
          }
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.gat",
          "match": "\\b0[xX][0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.decimal.gat",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.gat",
          "match": "(->|=>)"
        },
        {
          "name": "keyword.operator.range.gat",
          "match": "\\.\\."
        },
        {
          "name": "keyword.operator.comparison.gat",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.logical.gat",
          "match": "(&&|\\|\\||!)"
        },
        {
          "name": "keyword.operator.arithmetic.gat",
          "match": "(\\+|-|\\*|/|%)"
        },
        {
          "name": "keyword.operator.assignment.gat",
          "match": "="
        }
      ]
    }
  }
}
