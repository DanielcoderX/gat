// ============================================================================
// examples/test_wasm.gat - Test WASM 1.0 Binary Output Verification
// ============================================================================

import "std/str.gat";

fn main() -> i64 {
    print("=== Gat WebAssembly (WASM 1.0) Emitter Verification ===\n");

    let wasm_file = "bin/test_out.wasm";
    let data: raw i8 = read_file(wasm_file);
    if data == nil {
        print("FAIL: Failed to open WASM binary file\n");
        return 1;
    }

    // 1. Verify Magic (\0asm -> 0x00, 0x61, 0x73, 0x6D)
    let b0 = data[0]; if b0 < 0 { b0 = b0 + 256; }
    let b1 = data[1]; if b1 < 0 { b1 = b1 + 256; }
    let b2 = data[2]; if b2 < 0 { b2 = b2 + 256; }
    let b3 = data[3]; if b3 < 0 { b3 = b3 + 256; }
    if b0 != 0 || b1 != 97 || b2 != 115 || b3 != 109 {
        print("FAIL: Invalid WASM magic header\n");
        return 1;
    }

    // 2. Verify Version 1 (0x01, 0x00, 0x00, 0x00)
    let v0 = data[4]; if v0 < 0 { v0 = v0 + 256; }
    let v1 = data[5]; if v1 < 0 { v1 = v1 + 256; }
    let v2 = data[6]; if v2 < 0 { v2 = v2 + 256; }
    let v3 = data[7]; if v3 < 0 { v3 = v3 + 256; }
    if v0 != 1 || v1 != 0 || v2 != 0 || v3 != 0 {
        print("FAIL: Invalid WASM version\n");
        return 1;
    }

    // 3. Scan for "main", "add" and "memory" in exports
    let found_main = false;
    let found_add = false;
    let found_mem = false;
    let i: i64 = 0;
    while i < 111 {
        if data[i] == 109 && data[i+1] == 97 && data[i+2] == 105 && data[i+3] == 110 { // "main"
            found_main = true;
        }
        if data[i] == 97 && data[i+1] == 100 && data[i+2] == 100 { // "add"
            found_add = true;
        }
        if data[i] == 109 && data[i+1] == 101 && data[i+2] == 109 { // "mem"
            found_mem = true;
        }
        i = i + 1;
    }

    if !found_main {
        print("FAIL: Export 'main' not found in WASM\n");
        return 1;
    }
    if !found_add {
        print("FAIL: Export 'add' not found in WASM\n");
        return 1;
    }
    if !found_mem {
        print("FAIL: Export 'memory' not found in WASM\n");
        return 1;
    }

    print("  [PASS] WASM Magic, Version 1.0 & Symbol Exports Verified!\n");
    return 0;
}
