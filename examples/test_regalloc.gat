// ============================================================================
// examples/test_regalloc.gat - Linear-Scan Register Allocator E2E Test
// ============================================================================

fn test_callee_saved_preservation(depth: i64, a: i64, b: i64, c: i64, d: i64) -> i64 {
    if depth == 0 {
        return a + b + c + d;
    }
    // Perform function calls while keeping a, b, c, d in live registers
    let res = test_callee_saved_preservation(depth - 1, a + 1, b + 2, c + 3, d + 4);
    // Verify a, b, c, d remain untouched after recursion
    return res + a + b + c + d;
}

fn test_spill_pressure(p1: i64, p2: i64, p3: i64, p4: i64, p5: i64) -> i64 {
    // 8 simultaneous live variables: forces 4 in registers, 4 spilled to stack
    let v1 = p1 * 2;
    let v2 = p2 * 3;
    let v3 = p3 * 4;
    let v4 = p4 * 5;
    let v5 = p5 * 6;
    let v6 = v1 + v2;
    let v7 = v3 + v4;
    let v8 = v5 + v6 + v7;
    return v1 + v2 + v3 + v4 + v5 + v6 + v7 + v8;
}

fn test_loop_liveness(iterations: i64) -> i64 {
    let sum1: i64 = 0;
    let sum2: i64 = 0;
    let sum3: i64 = 0;
    let i: i64 = 1;
    while i <= iterations {
        sum1 = sum1 + i;
        sum2 = sum2 + (i * 2);
        sum3 = sum3 + (i * 3);
        i = i + 1;
    }
    return sum1 + sum2 + sum3;
}

fn test_five_args(a: i64, b: i64, c: i64, d: i64, e: i64) -> i64 {
    let r1 = a + b;
    let r2 = c + d;
    return r1 + r2 + e;
}

fn main() -> i64 {
    print("=== Register Allocator Verification ===\n");

    // 1. Loop back-edge live range test
    let loop_res = test_loop_liveness(100);
    // sum1 = 5050, sum2 = 10100, sum3 = 15150 -> total = 30300
    print("Loop Liveness Result: ", loop_res, "\n");
    if loop_res != 30300 {
        print("[FAIL] Loop liveness result mismatch!\n");
        return 1;
    }

    // 2. Spill pressure test with 8 simultaneous variables
    let spill_res = test_spill_pressure(1, 2, 3, 4, 5);
    // v1=2, v2=6, v3=12, v4=20, v5=30, v6=8, v7=32, v8=70
    // total = 2+6+12+20+30+8+32+70 = 180
    print("Spill Pressure Result: ", spill_res, "\n");
    if spill_res != 180 {
        print("[FAIL] Spill pressure result mismatch!\n");
        return 1;
    }

    // 3. Callee-saved preservation across calls
    let cs_res = test_callee_saved_preservation(3, 10, 20, 30, 40);
    print("Callee-Saved Recursion Result: ", cs_res, "\n");
    if cs_res != 460 {
        print("[FAIL] Callee-saved register preservation mismatch!\n");
        return 1;
    }

    // 4. 5-argument stack displacement test
    let five_res = test_five_args(10, 20, 30, 40, 50);
    print("5-Arg Stack Result: ", five_res, "\n");
    if five_res != 150 {
        print("[FAIL] 5th argument stack displacement mismatch!\n");
        return 1;
    }

    print("[PASS] All register allocator tests passed successfully!\n");
    return 0;
}
