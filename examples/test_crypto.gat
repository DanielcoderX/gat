import "std/crypto.gat";

fn main() -> i64 {
    print("=== Gat Crypto & Hashing Test ===\n");

    // 1. Test Base64
    let plain = "Hello, Gat systems programming!";
    let encoded = base64_encode(plain);
    print("Base64 Encoded: ", encoded, "\n");

    let decoded = base64_decode(encoded);
    print("Base64 Decoded: ", decoded, "\n");
    if !str_eq(plain, decoded) {
        print("FAIL: Base64 decode mismatch\n");
        return 1;
    }

    // 2. Test SHA-256 with known NIST vectors
    // sha256("") = e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855
    let empty_hash = sha256_hex("");
    print("SHA256(\"\"): ", empty_hash, "\n");
    if !str_eq(empty_hash, "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855") {
        print("FAIL: SHA-256 empty string mismatch\n");
        return 1;
    }

    // sha256("abc") = ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad
    let abc_hash = sha256_hex("abc");
    print("SHA256(\"abc\"): ", abc_hash, "\n");
    if !str_eq(abc_hash, "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad") {
        print("FAIL: SHA-256 'abc' mismatch\n");
        return 1;
    }

    // 3. Test HMAC-SHA256
    // HMAC-SHA256(key="key", data="The quick brown fox jumps over the lazy dog")
    // Expected: f7bc83f430538424b13298e6aa6fb143ef4d59a14946175997479dbc2d1a3cd8
    let hmac_res = hmac_sha256_hex("key", "The quick brown fox jumps over the lazy dog");
    print("HMAC-SHA256: ", hmac_res, "\n");
    if !str_eq(hmac_res, "f7bc83f430538424b13298e6aa6fb143ef4d59a14946175997479dbc2d1a3cd8") {
        print("FAIL: HMAC-SHA256 mismatch\n");
        return 1;
    }

    print("All crypto and hashing tests passed successfully!\n");
    return 0;
}
