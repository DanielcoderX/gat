import "std/result.gat";

fn fs_exists(path: string) -> bool {
    let content = read_file(path);
    if str_len(content) > 0 {
        return true;
    }
    return false;
}

fn fs_read_all(path: string) -> Result<string, string> {
    if str_len(path) == 0 {
        return Result.Err("empty path");
    }
    let content = read_file(path);
    if str_len(content) == 0 {
        return Result.Err("file not found or empty");
    }
    return Result.Ok(content);
}

fn fs_write_all(path: string, content: string) -> Result<i64, string> {
    if str_len(path) == 0 {
        return Result.Err("empty path");
    }
    let len = str_len(content);
    let written = write_file(path, content, len);
    if written < 0 {
        return Result.Err("failed to write file");
    }
    return Result.Ok(written);
}

fn fs_file_size(path: string) -> i64 {
    let content = read_file(path);
    return str_len(content);
}

fn fs_delete_file(path: string) -> bool {
    let i = 0;
    while i < 50 {
        if delete_file(path) {
            return true;
        }
        sleep(20);
        i = i + 1;
    }
    return false;
}

fn fs_temp_dir() -> string {
    return get_temp_dir();
}
