// ============================================================================
// std/process.gat - Gat Standard Library: Process & System Utilities
// ============================================================================

fn proc_exec(cmd: string) -> i64 {
    return exec_cmd(cmd);
}

fn proc_exit(code: i64) {
    exit_process(code);
}

fn proc_get_pid() -> i64 {
    return get_pid();
}

fn proc_sleep(ms: i64) {
    sleep(ms);
}
