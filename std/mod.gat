// ============================================================================
// std/mod.gat - Gat Package & Module Manager Library
// ============================================================================

import "std/str.gat";
import "std/fs.gat";
import "std/process.gat";
import "std/crypto.gat";

class ModDep {
    name: string;
    source: string;
    version: string;
    checksum: string;
    next: ModDep;
}

class Manifest {
    module_name: string;
    deps_head: ModDep;
    deps_tail: ModDep;
}

fn mod_new_manifest(name: string) -> Manifest {
    return new Manifest {
        module_name: name,
        deps_head: nil,
        deps_tail: nil
    };
}

fn mod_add_dep(m: Manifest, name: string, source: string, ver: string) {
    let dep = new ModDep {
        name: name,
        source: source,
        version: ver,
        checksum: "",
        next: nil
    };
    if m.deps_head == nil {
        m.deps_head = dep;
        m.deps_tail = dep;
    } else {
        m.deps_tail.next = dep;
        m.deps_tail = dep;
    }
}

// Extract package name from repo path/URL (e.g. "github.com/foo/gat-json" -> "gat-json")
fn mod_extract_pkg_name(source: string) -> string {
    let len = str_len(source);
    let last_slash = -1;
    let i = 0;
    while i < len {
        let ch = str_char(source, i);
        if ch == 47 || ch == 92 { // '/' or '\'
            last_slash = i;
        }
        i = i + 1;
    }
    if last_slash >= 0 && last_slash + 1 < len {
        let name = str_sub(source, last_slash + 1, len - last_slash - 1);
        if str_ends_with(name, ".git") {
            name = str_sub(name, 0, str_len(name) - 4);
        }
        return name;
    }
    return source;
}

// Parse gat.mod file content
fn mod_parse_manifest(content: string) -> Manifest {
    let m = mod_new_manifest("");
    let len = str_len(content);
    let i = 0;
    let line_sb = sb_new(128);

    while i < len {
        let ch = str_char(content, i);
        if ch == 10 || ch == 13 {
            let line = str_trim(sb_to_string(line_sb));
            sb_clear(line_sb);
            if str_len(line) > 0 && !str_starts_with(line, "#") && !str_starts_with(line, "//") {
                if str_starts_with(line, "module ") {
                    m.module_name = str_trim(str_sub(line, 7, str_len(line) - 7));
                } else if str_starts_with(line, "require ") {
                    let req_body = str_trim(str_sub(line, 8, str_len(line) - 8));
                    let space_idx = str_index_of(req_body, 32);
                    if space_idx > 0 {
                        let src = str_trim(str_sub(req_body, 0, space_idx));
                        let ver = str_trim(str_sub(req_body, space_idx + 1, str_len(req_body) - space_idx - 1));
                        let pkg_name = mod_extract_pkg_name(src);
                        mod_add_dep(m, pkg_name, src, ver);
                    }
                }
            }
        } else {
            sb_append_char(line_sb, ch);
        }
        i = i + 1;
    }

    let rem = str_trim(sb_to_string(line_sb));
    if str_len(rem) > 0 {
        if str_starts_with(rem, "module ") {
            m.module_name = str_trim(str_sub(rem, 7, str_len(rem) - 7));
        } else if str_starts_with(rem, "require ") {
            let req_body = str_trim(str_sub(rem, 8, str_len(rem) - 8));
            let space_idx = str_index_of(req_body, 32);
            if space_idx > 0 {
                let src = str_trim(str_sub(req_body, 0, space_idx));
                let ver = str_trim(str_sub(req_body, space_idx + 1, str_len(req_body) - space_idx - 1));
                let pkg_name = mod_extract_pkg_name(src);
                mod_add_dep(m, pkg_name, src, ver);
            }
        }
    }

    return m;
}

// Generate default gat.mod
fn mod_init_file(mod_name: string) -> bool {
    let sb = sb_new(256);
    sb_append(sb, "module ");
    sb_append(sb, mod_name);
    sb_append(sb, "\n\n// Dependencies (e.g. require github.com/user/repo v1.0.0)\n");
    let content = sb_to_string(sb);
    let written = write_file("gat.mod", content, str_len(content));
    return written >= 0;
}

fn mod_is_local_source(src: string) -> bool {
    if str_starts_with(src, "./") || str_starts_with(src, "../") || str_starts_with(src, "examples/") {
        return true;
    }
    let test_lib = str_concat(src, "/lib.gat");
    if str_len(read_file(test_lib)) > 0 {
        return true;
    }
    return false;
}

fn mod_copy_dir(src: string, dest: string) {
    let tdir = fs_temp_dir();
    if str_starts_with(tdir, "/") {
        // Unix (macOS / Linux)
        proc_exec(str_concat("mkdir -p ", dest));
        proc_exec(str_concat("cp -r ", str_concat(src, str_concat("/* ", dest))));
    } else {
        // Windows PowerShell
        proc_exec(str_concat("powershell -Command \"New-Item -ItemType Directory -Force -Path ", dest, " | Out-Null\""));
        proc_exec(str_concat("powershell -Command \"Copy-Item -Recurse -Force -Path '", str_concat(src, str_concat("/*' -Destination '", str_concat(dest, "'\"")))));
    }
}

// Compute deterministic SHA-256 package checksum
fn mod_calc_pkg_hash(name: string, source: string, ver: string, dest_dir: string) -> string {
    let lib_file = str_concat(dest_dir, "/lib.gat");
    let content = read_file(lib_file);
    if str_len(content) == 0 {
        let manifest_file = str_concat(dest_dir, "/gat.mod");
        content = read_file(manifest_file);
    }
    if str_len(content) == 0 {
        content = str_concat(name, str_concat(":", str_concat(source, str_concat("@", ver))));
    }
    return sha256_hex(content);
}

// Fetch all dependencies declared in gat.mod
fn mod_fetch_deps(manifest_path: string) -> bool {
    let content = read_file(manifest_path);
    if str_len(content) == 0 {
        print("[Error] Could not read manifest: ", manifest_path, "\n");
        return false;
    }

    let m = mod_parse_manifest(content);
    print("[gat fetch] Resolving dependencies for module '", m.module_name, "'...\n");

    let lock_sb = sb_new(512);
    sb_append(lock_sb, "# Gat Dependency Lockfile (gat.lock v1)\n# DO NOT EDIT MANUALLY - Auto-generated by 'gat fetch'\n\n");

    let cur = m.deps_head;
    let count = 0;

    while cur != nil {
        let dest_dir = str_concat(".gat/deps/", cur.name);
        print("  -> Fetching ", cur.name, " (", cur.source, " @ ", cur.version, ")...\n");

        if mod_is_local_source(cur.source) {
            // Local path dependency
            print("     Using local dependency path: ", cur.source, "\n");
            mod_copy_dir(cur.source, dest_dir);
        } else {
            // Git remote dependency
            let lib_check = str_concat(dest_dir, "/lib.gat");
            let mod_check = str_concat(dest_dir, "/gat.mod");
            if fs_exists(lib_check) || fs_exists(mod_check) {
                print("     Already fetched in ", dest_dir, "\n");
            } else {
                let git_cmd = str_concat("git clone --depth 1 --branch ", str_concat(cur.version, str_concat(" ", str_concat(cur.source, str_concat(" ", dest_dir)))));
                let code = proc_exec(git_cmd);
                if code != 0 {
                    let git_cmd2 = str_concat("git clone --depth 1 ", str_concat(cur.source, str_concat(" ", dest_dir)));
                    code = proc_exec(git_cmd2);
                }
            }
        }

        let pkg_hash = mod_calc_pkg_hash(cur.name, cur.source, cur.version, dest_dir);

        sb_append(lock_sb, "lock ");
        sb_append(lock_sb, cur.name);
        sb_append(lock_sb, " ");
        sb_append(lock_sb, cur.source);
        sb_append(lock_sb, " ");
        sb_append(lock_sb, cur.version);
        sb_append(lock_sb, " sha256:");
        sb_append(lock_sb, pkg_hash);
        sb_append(lock_sb, "\n");

        count = count + 1;
        cur = cur.next;
    }

    let lock_content = sb_to_string(lock_sb);
    write_file("gat.lock", lock_content, str_len(lock_content));
    print("[gat fetch] Successfully fetched ", str_from_int(count), " dependencies and updated gat.lock.\n");
    return true;
}

// Verify integrity of all locked packages in gat.lock
fn mod_verify_lock(lock_path: string) -> bool {
    let content = read_file(lock_path);
    if str_len(content) == 0 {
        print("[Error] Could not read lockfile: ", lock_path, "\n");
        return false;
    }
    print("[gat fetch] Verifying dependency integrity from ", lock_path, "...\n");
    let len = str_len(content);
    let i = 0;
    let line_sb = sb_new(128);
    let verified_count = 0;

    while i < len {
        let ch = str_char(content, i);
        if ch == 10 || ch == 13 {
            let line = str_trim(sb_to_string(line_sb));
            sb_clear(line_sb);
            if str_starts_with(line, "lock ") {
                let body = str_trim(str_sub(line, 5, str_len(line) - 5));
                let sp1 = str_index_of(body, 32);
                if sp1 > 0 {
                    let pkg_name = str_sub(body, 0, sp1);
                    let rem1 = str_trim(str_sub(body, sp1 + 1, str_len(body) - sp1 - 1));
                    let sp2 = str_index_of(rem1, 32);
                    if sp2 > 0 {
                        let pkg_src = str_sub(rem1, 0, sp2);
                        let rem2 = str_trim(str_sub(rem1, sp2 + 1, str_len(rem1) - sp2 - 1));
                        let sp3 = str_index_of(rem2, 32);
                        let pkg_ver = rem2;
                        let expected_hash = "";
                        if sp3 > 0 {
                            pkg_ver = str_sub(rem2, 0, sp3);
                            let rem3 = str_trim(str_sub(rem2, sp3 + 1, str_len(rem2) - sp3 - 1));
                            if str_starts_with(rem3, "sha256:") {
                                expected_hash = str_sub(rem3, 7, str_len(rem3) - 7);
                            }
                        }

                        let dest_dir = str_concat(".gat/deps/", pkg_name);
                        let lib_file = str_concat(dest_dir, "/lib.gat");
                        let mod_file = str_concat(dest_dir, "/gat.mod");
                        if !fs_exists(lib_file) && !fs_exists(mod_file) {
                            print("[FAIL] Missing dependency files in: ", dest_dir, "\n");
                            return false;
                        }

                        if str_len(expected_hash) > 0 {
                            let actual_hash = mod_calc_pkg_hash(pkg_name, pkg_src, pkg_ver, dest_dir);
                            if !str_eq(expected_hash, actual_hash) {
                                print("[FAIL] Checksum mismatch for ", pkg_name, ": expected ", expected_hash, ", got ", actual_hash, "\n");
                                return false;
                            }
                        }
                        verified_count = verified_count + 1;
                    }
                }
            }
        } else {
            sb_append_char(line_sb, ch);
        }
        i = i + 1;
    }
    print("[gat fetch] Verified ", str_from_int(verified_count), " locked package checksums successfully.\n");
    return true;
}
