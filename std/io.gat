import "std/str.gat";
import "std/result.gat";

fn io_read_text(path: string) -> Result<string, string> {
    if str_len(path) == 0 {
        return Result.Err("empty path");
    }
    let content = read_file(path);
    if str_len(content) == 0 {
        return Result.Err("file not found or empty");
    }
    return Result.Ok(content);
}

fn io_write_text(path: string, content: string) -> Result<i64, string> {
    if str_len(path) == 0 {
        return Result.Err("empty path");
    }
    let len = str_len(content);
    let written = write_file(path, content, len);
    if written < 0 {
        return Result.Err("failed to write file");
    }
    return Result.Ok(written);
}

fn io_append_text(path: string, content: string) -> Result<i64, string> {
    let existing_res = io_read_text(path);
    let existing = "";
    match existing_res {
        Result.Ok(val) => { existing = val; },
        Result.Err(err) => { existing = ""; }
    }
    let full = str_concat(existing, content);
    return io_write_text(path, full);
}

fn io_path_combine(dir: string, file: string) -> string {
    let dlen = str_len(dir);
    if dlen == 0 { return file; }
    let last_ch = str_char(dir, dlen - 1);
    if last_ch == 47 || last_ch == 92 { // '/' or '\'
        return str_concat(dir, file);
    }
    return str_concat(dir, str_concat("/", file));
}

fn io_path_ext(path: string) -> string {
    let len = str_len(path);
    let last_dot: i64 = 0 - 1;
    let i: i64 = 0;
    while i < len {
        if str_char(path, i) == 46 { // '.'
            last_dot = i;
        }
        i = i + 1;
    }
    if last_dot < 0 { return ""; }
    return str_sub(path, last_dot, len - last_dot);
}

fn io_path_filename(path: string) -> string {
    let len = str_len(path);
    let last_sep: i64 = 0 - 1;
    let i: i64 = 0;
    while i < len {
        let ch = str_char(path, i);
        if ch == 47 || ch == 92 { // '/' or '\'
            last_sep = i;
        }
        i = i + 1;
    }
    if last_sep < 0 { return path; }
    return str_sub(path, last_sep + 1, len - last_sep - 1);
}
