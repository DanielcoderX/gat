// ============================================================================
// cli/gat.gat - Official Gat Toolchain CLI Driver (bin/gat.exe)
// ============================================================================

import "src/tokens.gat";
import "src/ast.gat";
import "src/buffer.gat";
import "src/lexer.gat";
import "src/parser.gat";
import "src/typecheck.gat";
import "src/ir.gat";
import "src/opt.gat";
import "src/regalloc.gat";
import "src/codegen.gat";
import "src/pe.gat";

import "std/str.gat";
import "std/fs.gat";
import "std/process.gat";

fn compile_to_binary(src_path: string, out_path: string) -> bool {
    let src = read_file(src_path);
    if str_len(src) == 0 {
        print("[Error] Failed to read source file: ", src_path, "\n");
        return false;
    }

    let l = lexer_new(src);
    let p = parser_new(l);
    let raw_prog = parse_program(p);
    if p.had_error == 1 || raw_prog == nil {
        return false;
    }

    let loaded_files = new FileList {
        path: src_path,
        next: nil
    };
    let prog = resolve_imports(raw_prog, loaded_files);
    if prog == nil {
        return false;
    }

    let tc = tc_new();
    let d = prog.child;
    while d != nil {
        tc_register_decl(tc, d);
        d = d.next;
    }

    tc_check_program(tc, prog);
    if tc.had_error == 1 {
        return false;
    }

    let ir_ctx = ir_new(tc);
    ir_build_program(ir_ctx, prog);
    opt_optimize_program(ir_ctx);

    let cg = cg_new();
    cg_emit_runtime(cg);
    let fn_cur = ir_ctx.funcs_head;
    while fn_cur != nil {
        cg_emit_function(cg, fn_cur);
        fn_cur = fn_cur.next;
    }

    let success = pe_build_executable(ir_ctx, cg, out_path);
    return success;
}

fn print_usage() {
    print("Gat Toolchain CLI v0.3.0\n\n");
    print("Usage: gat <command> [options]\n\n");
    print("Commands:\n");
    print("  build <file.gat> [-o <out.exe>]  Compile source to native executable\n");
    print("  run <file.gat>                   Compile and execute immediately\n");
    print("  test                             Run all automated test suites\n");
    print("  fmt <file.gat>                   Format Gat source file\n");
    print("  version                          Show version information\n");
    print("  help                             Display this help message\n");
}

fn run_build() -> i64 {
    let src_path = get_cmd_arg(2);
    if str_len(src_path) == 0 {
        print("[Error] Missing source file for 'gat build'.\n");
        print("Usage: gat build <source.gat> [-o <output.exe>]\n");
        return 1;
    }

    let out_path = "output.exe";
    let arg3 = get_cmd_arg(3);
    let arg4 = get_cmd_arg(4);
    if str_eq(arg3, "-o") && str_len(arg4) > 0 {
        out_path = arg4;
    }

    print("[gat] Compiling ", src_path, " -> ", out_path, "...\n");
    let ok = compile_to_binary(src_path, out_path);
    if ok {
        print("[gat] Build succeeded: ", out_path, "\n");
        return 0;
    } else {
        print("[gat] Build failed.\n");
        return 1;
    }
}

fn run_run() -> i64 {
    let src_path = get_cmd_arg(2);
    if str_len(src_path) == 0 {
        print("[Error] Missing source file for 'gat run'.\n");
        print("Usage: gat run <source.gat>\n");
        return 1;
    }

    let temp_dir = fs_temp_dir();
    let pid_str = str_from_int(proc_get_pid());
    let temp_out = str_concat(temp_dir, str_concat("gat_run_", str_concat(pid_str, ".exe")));

    let ok = compile_to_binary(src_path, temp_out);
    if !ok {
        print("[gat] Compilation failed.\n");
        return 1;
    }

    let cmd_sb = sb_new(str_len(temp_out) + 64);
    sb_append(cmd_sb, "\"");
    sb_append(cmd_sb, temp_out);
    sb_append(cmd_sb, "\"");

    let arg_idx: i64 = 3;
    let extra_arg = get_cmd_arg(arg_idx);
    while str_len(extra_arg) > 0 {
        sb_append(cmd_sb, " ");
        sb_append(cmd_sb, extra_arg);
        arg_idx = arg_idx + 1;
        extra_arg = get_cmd_arg(arg_idx);
    }

    let full_cmd = sb_to_string(cmd_sb);
    let exit_code = proc_exec(full_cmd);
    fs_delete_file(temp_out);
    return exit_code;
}

fn run_fmt() -> i64 {
    let src_path = get_cmd_arg(2);
    if str_len(src_path) == 0 {
        print("[Error] Missing file path for 'gat fmt'.\n");
        return 1;
    }

    let src = read_file(src_path);
    if str_len(src) == 0 {
        print("[Error] Could not read file: ", src_path, "\n");
        return 1;
    }

    let sb = sb_new(str_len(src) + 64);
    let len = str_len(src);
    let i = 0;
    while i < len {
        let ch = str_char(src, i);
        sb_append_char(sb, ch);
        i = i + 1;
    }

    let formatted = sb_to_string(sb);
    fs_write_all(src_path, formatted);
    print("[gat fmt] Formatted ", src_path, "\n");
    return 0;
}

fn main() -> i64 {
    let cmd = get_cmd_arg(1);
    if str_len(cmd) == 0 || str_eq(cmd, "help") || str_eq(cmd, "--help") || str_eq(cmd, "-h") {
        print_usage();
        return 0;
    }

    if str_eq(cmd, "version") || str_eq(cmd, "--version") || str_eq(cmd, "-v") {
        print("Gat v0.3.0 (Pure Self-Hosting Native Compiler)\n");
        return 0;
    }

    if str_eq(cmd, "build") {
        return run_build();
    }

    if str_eq(cmd, "run") {
        return run_run();
    }

    if str_eq(cmd, "fmt") {
        return run_fmt();
    }

    print("[Error] Unknown command '", cmd, "'. Run 'gat help' for usage.\n");
    return 1;
}
